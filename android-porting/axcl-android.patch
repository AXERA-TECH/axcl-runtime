new file mode 100644
index 0000000000000000000000000000000000000000..3497955099bff1f218bbbe44aa76afdc4ebbcc67
--- /dev/null
+++ b/android/platform/README.md
@@ -0,0 +1,64 @@
+# AXCL 系统安装服务集成
+
+AXCL 系统安装服务用于管理 Android 平台上的 Runtime、PCIe 驱动和子卡固件。
+服务作为 BSP 的系统组件运行，负责已安装 APK 的验证、部署和运行环境恢复。
+
+## 环境要求
+
+- Android 9 / API 28 及以上。
+- 提供 `app_process`、`pm`、`unzip`、`sha256sum`、`insmod`、`rmmod` 等系统命令。
+- 具备匹配目标内核的 PCIe 驱动，完成 PCIe 硬件配置及固件加载支持。
+- 配置服务运行所需的 root 身份和 SELinux 策略。
+
+## 文件部署
+
+使用 `build_apk.py` 生成的同一份 `AXCL-OEM-Integration-*`，按以下路径集成至系统镜像：
+
+| 生成文件 | 镜像路径 | 文件属主及权限 |
+| --- | --- | --- |
+| `axcl-package-manager` | `/vendor/bin/axcl-package-manager` | root:root 0755 |
+| `axcl-runtime.rc` | `/vendor/etc/init/axcl-runtime.rc` | root:root 0644 |
+| `axcl-package-verifier.jar` | `/vendor/framework/axcl-package-verifier.jar` | root:root 0644 |
+| `axcl-signing.sha256` | `/vendor/etc/axcl-signing.sha256` | root:root 0644 |
+
+`axcl-signing.sha256` 保存受信任 APK 的签名证书摘要。
+APK 重新签名后，应同步更新该文件，并保持其仅由管理员写入。
+
+## BSP 配置
+
+1. **服务身份与 SELinux 域**：rc 模板中的 `u:r:su:s0` 适用于 userdebug/eng 调试环境。产品系统应配置专用的 AXCL 服务域及相应策略。
+2. **服务访问权限**：允许查询系统包管理、调用签名验证器、读取已安装 APK，读写 `/data/vendor/axcl` 和 `/data/vendor/axcl-manager`，加载和卸载模块、配置固件搜索路径及操作设备节点。为相关文件和节点配置 SELinux 标签。
+3. **内核配置**：确认模块 ABI、模块签名、固件加载及驱动使用的内存相关接口符合目标 BSP 要求。
+4. **固件搜索路径**：若 `/sys/module/firmware_class/parameters/path` 已有配置，应在对应目录下建立 `axcl` 链接，指向 `/data/vendor/axcl/firmware/axcl`。服务检查链接后使用原有搜索路径。
+5. **应用访问权限**：脚本默认将设备节点授予 shell 组。其他应用需按其运行身份配置设备、日志目录和 SELinux 权限。
+
+签名验证器通过 `ActivityThread` 获取系统上下文，该接口属于 Android 隐藏接口。
+集成时应根据目标 Android 分支验证 `PackageVerifier.java` 的兼容性，并按 BSP 策略配置服务权限。
+仓库提供服务配置模板，SELinux 策略由目标 BSP 集成。
+
+## 服务行为
+
+`sys.boot_completed=1` 后启动服务，每 5 秒检查一次已安装的 `com.axera.axcl`。
+服务校验 APK 签名和载荷完整性后，执行相应操作：
+
+| 场景 | 操作 |
+| --- | --- |
+| 首次安装 | 部署 Runtime、PAC 和驱动，加载驱动并记录状态 |
+| 主控重启 | 恢复已安装的驱动运行环境 |
+| APK 更新 | 校验并部署更新内容 |
+| APK 卸载 | 卸载驱动并清理部署内容 |
+| 操作失败 | 记录错误日志并按重试周期重新处理 |
+
+APK 安装与 Runtime 部署异步执行。部署结果通过状态文件和日志查询，设备运行状态通过 `axcl-smi` 检查。
+
+## 集成验证
+
+```bash
+adb shell getprop init.svc.axcl-package-manager
+adb shell cat /data/vendor/axcl-manager/status
+adb shell cat /data/vendor/axcl-manager/last-operation.log
+adb shell /data/vendor/axcl/current/bin/axcl-smi
+```
+
+在目标平台验证首次安装、重启、更新和卸载流程，并检查签名不匹配、驱动不匹配、PCIe 连接及固件启动失败时的处理结果。
+APK 中的诊断页面和 `InstallerService` 用于诊断和维护；系统服务独立管理 Runtime 生命周期。
diff --git a/android/platform/axcl-package-manager b/android/platform/axcl-package-manager
new file mode 100644
index 0000000000000000000000000000000000000000..e383c59ebbe33e57bb27b7804649b50605be9f5a
--- /dev/null
+++ b/android/platform/axcl-package-manager
@@ -0,0 +1,91 @@
+#!/system/bin/sh
+# OEM package hooks: configure, boot restoration, upgrade and removal.
+set -eu
+BASE=/data/vendor/axcl
+STATE=/data/vendor/axcl-manager
+TRUST=/vendor/etc/axcl-signing.sha256
+VERIFIER=/vendor/framework/axcl-package-verifier.jar
+SYSTEM_SHELL=/system/bin/sh
+BOOT_ID=/proc/sys/kernel/random/boot_id
+fail() { echo "ERROR: $*" >&2; exit 1; }
+[ "$(id -u)" = 0 ] || fail "Root is required"
+[ "$#" = 1 ] || fail "Usage: axcl-package-manager {watch|sync}"
+case "$1" in watch|sync) : ;; *) fail "Unknown action" ;; esac
+umask 077
+mkdir -p "$STATE"
+chmod 0755 "$STATE"
+umask 022
+# init owns the single watch process. Never execute code from an unverified APK.
+sync_package() (
+    set -eu
+    packages=$(pm list packages -f --user 0) || fail "Package manager unavailable; retaining AXCL installation"
+    # The framework package must be present. Some Android shell commands print
+    # service errors with exit 0; an empty/error response is not an uninstall.
+    framework=$(printf '%s\n' "$packages" | sed -n 's/^package:\/.*=android$/framework/p')
+    [ "$framework" = framework ] || fail "Invalid package list; retaining AXCL installation"
+    apk=$(printf '%s\n' "$packages" | sed -n 's/^package:\(.*\)=com[.]axera[.]axcl$/\1/p')
+    if [ -z "$apk" ]; then
+        if [ -f "$STATE/active-apk" ]; then
+            "$SYSTEM_SHELL" "$BASE/axclctl" uninstall
+            rm -f "$STATE/active-apk"
+            echo removed > "$STATE/status"
+        fi
+        exit 0
+    fi
+    case "$apk" in /*.apk) : ;; *) fail "Unexpected installed APK path" ;; esac
+    identity="$(cat "$BOOT_ID"):$apk"
+    if [ "$(cat "$STATE/active-apk" 2>/dev/null || true)" = "$identity" ]; then exit 0; fi
+    digest=$(cat "$TRUST")
+    verified=$(CLASSPATH="$VERIFIER" app_process /system/bin com.axera.axcl.platform.PackageVerifier "$digest") || fail "Untrusted AXCL package"
+    [ "$verified" = "$apk" ] || fail "Package changed during verification; retry"
+    # Cache only private, root-owned extraction data. Pull exact manifest paths;
+    # never unpack arbitrary ZIP entries (including symlinks or ../ paths).
+    incoming="$STATE/incoming"
+    if [ -d "$incoming" ]; then rm -r "$incoming"; fi
+    mkdir -m 0700 "$incoming"
+    trap 'rm -r "$incoming"' EXIT
+    unzip -p "$apk" assets/payload.sha256 > "$incoming/payload.sha256"
+    [ -s "$incoming/payload.sha256" ] || fail "Missing payload manifest"
+    while read -r hash name extra; do
+        [ "${#hash}" = 64 ] && [ -z "${extra:-}" ] || fail "Invalid payload manifest"
+        case "$hash" in *[!0-9a-f]*) fail "Invalid SHA-256" ;; esac
+        case "$name" in *..*|*[!a-zA-Z0-9_./+-]*|'') fail "Invalid payload path" ;; esac
+        case "$name" in
+            firmware/ax650_card.pac|modules/*.ko|modules/kernel-release.txt|modules/driver-build-info.json|runtime/bin/*|runtime/lib/*|runtime/include/*|runtime/etc/*|runtime/data/*|runtime/axcl.json|axclctl|install-device.sh|driver-source.tar.gz|build-driver.sh) : ;;
+            *) fail "Unexpected payload path: $name" ;;
+        esac
+        mkdir -p "$incoming/$(dirname "$name")"
+        unzip -p "$apk" "assets/$name" > "$incoming/$name"
+    done < "$incoming/payload.sha256"
+    (cd "$incoming" && sha256sum -c payload.sha256) || fail "Payload verification failed"
+    # Ensure the script we execute was itself authenticated by the manifest.
+    case "$(sed -n 's/^[0-9a-f]*  \(install-device[.]sh\)$/\1/p' "$incoming/payload.sha256")" in install-device.sh) : ;; *) fail "Installer absent from manifest" ;; esac
+    # A kernel update invalidates the deployed modules even when the APK has not
+    # changed. Run the source installer again so it builds for the new kernel.
+    if [ -f "$BASE/installed-payload.sha256" ] && cmp -s "$incoming/payload.sha256" "$BASE/installed-payload.sha256" &&
+        [ "$(cat "$BASE/modules/kernel-release.txt" 2>/dev/null || true)" = "$(uname -r)" ]; then
+        "$SYSTEM_SHELL" "$BASE/axclctl" start
+    else
+        "$SYSTEM_SHELL" "$incoming/install-device.sh" "$incoming" 0 ensure
+        cp "$incoming/payload.sha256" "$BASE/installed-payload.sha256"
+    fi
+    printf '%s' "$identity" > "$STATE/active-apk.new"
+    mv -f "$STATE/active-apk.new" "$STATE/active-apk"
+    echo installed > "$STATE/status"
+)
+if [ "$1" = sync ]; then sync_package; exit $?; fi
+while :; do
+    # Replacement log bounds storage consumption; dmesg remains authoritative for drivers.
+    # A separate shell preserves errexit inside sync; calling a shell function
+    # as an if condition would suppress it, including failed installer commands.
+    if ! "$SYSTEM_SHELL" "$0" sync > "$STATE/operation.new" 2>&1; then
+        mv -f "$STATE/operation.new" "$STATE/last-operation.log"
+        echo failed > "$STATE/status"
+        sleep 30
+    elif [ -s "$STATE/operation.new" ]; then
+        mv -f "$STATE/operation.new" "$STATE/last-operation.log"
+    else
+        rm -f "$STATE/operation.new"
+    fi
+    sleep 5
+done
diff --git a/android/platform/axcl-runtime.rc b/android/platform/axcl-runtime.rc
new file mode 100644
index 0000000000000000000000000000000000000000..fe5e6e3d59aa363cc0905c8fadd21c423ec3d3c2
--- /dev/null
+++ b/android/platform/axcl-runtime.rc
@@ -0,0 +1,13 @@
+# OEM integration: install alongside axcl-package-manager and its verifier JAR.
+# The OEM must assign the service an SELinux domain with the documented access.
+service axcl-package-manager /system/bin/sh /vendor/bin/axcl-package-manager watch
+    class late_start
+    user root
+    group root shell system
+    # Initial evaluation contract: AOSP userdebug/eng with the su domain.
+    # Production images must substitute their AXCL service domain and policy.
+    seclabel u:r:su:s0
+    disabled
+
+on property:sys.boot_completed=1
+    start axcl-package-manager
