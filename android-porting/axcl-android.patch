new file mode 100644
index 0000000000000000000000000000000000000000..63d9120195b4b0f8ba077a23ea5cce0ae0cc9676
--- /dev/null
+++ b/android/app/src/com/axera/axcl/StatusProvider.java
@@ -0,0 +1,61 @@
+package com.axera.axcl;
+
+import android.content.ContentProvider;
+import android.content.ContentValues;
+import android.database.Cursor;
+import android.database.MatrixCursor;
+import android.net.Uri;
+import android.os.ParcelFileDescriptor;
+import java.io.FileNotFoundException;
+import java.io.FileOutputStream;
+import java.nio.charset.StandardCharsets;
+import org.json.JSONObject;
+
+public final class StatusProvider extends ContentProvider {
+    @Override public boolean onCreate() { return true; }
+
+    private void check(Uri uri) {
+        if (!"/status".equals(uri.getPath())) throw new IllegalArgumentException("Unknown status URI");
+    }
+
+    @Override public Cursor query(Uri uri, String[] projection, String selection,
+                                  String[] arguments, String order) {
+        check(uri);
+        String[] columns = projection == null ? new String[] {
+            "request_id", "state", "success", "stage", "operation", "device_index", "updated_ms", "report"
+        } : projection;
+        JSONObject status = InstallStatus.read(getContext());
+        MatrixCursor cursor = new MatrixCursor(columns);
+        Object[] row = new Object[columns.length];
+        for (int index = 0; index < columns.length; index++) {
+            if (!status.has(columns[index])) throw new IllegalArgumentException("Unknown status column");
+            row[index] = status.opt(columns[index]);
+        }
+        cursor.addRow(row);
+        return cursor;
+    }
+
+    @Override public ParcelFileDescriptor openFile(Uri uri, String mode) throws FileNotFoundException {
+        check(uri);
+        if (!"r".equals(mode)) throw new FileNotFoundException("Read-only status");
+        try {
+            final byte[] bytes = (InstallStatus.read(getContext()).toString(2) + "\n").getBytes(StandardCharsets.UTF_8);
+            ParcelFileDescriptor[] pipe = ParcelFileDescriptor.createPipe();
+            new Thread(() -> {
+                try (FileOutputStream output = new ParcelFileDescriptor.AutoCloseOutputStream(pipe[1])) {
+                    output.write(bytes);
+                } catch (java.io.IOException ignored) {
+                    // The command-line reader may close its pipe before consuming the report.
+                }
+            }, "axcl-status").start();
+            return pipe[0];
+        } catch (Exception error) {
+            throw new FileNotFoundException(error.toString());
+        }
+    }
+
+    @Override public String getType(Uri uri) { check(uri); return "application/json"; }
+    @Override public Uri insert(Uri uri, ContentValues values) { throw new UnsupportedOperationException("Read-only status"); }
+    @Override public int delete(Uri uri, String selection, String[] arguments) { throw new UnsupportedOperationException("Read-only status"); }
+    @Override public int update(Uri uri, ContentValues values, String selection, String[] arguments) { throw new UnsupportedOperationException("Read-only status"); }
+}
diff --git a/android/build_apk.py b/android/build_apk.py
new file mode 100644
index 0000000000000000000000000000000000000000..97edaa05f22ccf7166247697c0026ec216b3b0a8
--- /dev/null
+++ b/android/build_apk.py
@@ -0,0 +1,267 @@
+#!/usr/bin/env python3
+"""Build and sign the AXCL Android installer with its AX650 card PAC."""
+
+import argparse
+import hashlib
+import json
+import os
+from pathlib import Path
+import shutil
+import struct
+import subprocess
+import tempfile
+import zipfile
+
+from build_native import ROOT, AXCL, run, validate_libraries
+from pack_driver import pack_driver
+from prebuilt import MODULES, validate_modules
+
+VERSION = "1.6.3"
+
+
+def sha256(path):
+    digest = hashlib.sha256()
+    with path.open("rb") as stream:
+        for block in iter(lambda: stream.read(1024 * 1024), b""):
+            digest.update(block)
+    return digest.hexdigest()
+
+
+def prepare_payload(pac, modules, assets, sdk_version, runtime=None):
+    """Validate SDK PAC headers and require every firmware byte in the signed APK."""
+    with pac.open("rb") as stream:
+        header = stream.read(128)
+        if len(header) != 128:
+            raise ValueError("Truncated PAC header")
+        magic, version, size, product, firmware_version, offset, count, _, _, _ = struct.unpack("<IIQ32s32sIIII32s", header)
+        product = product.split(b"\0", 1)[0].decode("ascii")
+        firmware_version = firmware_version.split(b"\0", 1)[0].decode("ascii")
+        if magic != 0x5C6D8E9F or version != 1 or size != pac.stat().st_size or product != "AX650_card":
+            raise ValueError("Expected a complete AX650_card PAC v1")
+        expected_sdk_version = sdk_version.removeprefix("SDK_VERSION=")
+        if firmware_version != expected_sdk_version and not firmware_version.startswith(expected_sdk_version + "_"):
+            raise ValueError(f"PAC/runtime SDK version mismatch: {firmware_version} / {expected_sdk_version}")
+        if offset < 128 or not 0 < count <= 1024 or offset + count * 464 > size:
+            raise ValueError("Invalid PAC file table")
+        stream.seek(offset)
+        for _ in range(count):
+            entry = stream.read(464)
+            start, length = struct.unpack_from("<QQ", entry, 320)
+            if length and (start < offset + count * 464 or start + length > size):
+                raise ValueError("PAC image extends outside the package")
+    files = {"firmware/ax650_card.pac": pac}
+    kernel_release = None
+    driver_info = None
+    if modules is not None:
+        driver_info = validate_modules(modules)
+        files.update({f"modules/{name}.ko": modules / f"{name}.ko" for name in MODULES})
+        files["modules/kernel-release.txt"] = modules / "kernel-release.txt"
+        kernel_release = driver_info["kernel_release"]
+        provenance = modules / "driver-build-info.json"
+        if provenance.is_file():
+            details = json.loads(provenance.read_text())
+            if details.get("sdk_version") != sdk_version.removeprefix("SDK_VERSION="):
+                raise ValueError("Precompiled driver/runtime SDK version mismatch")
+            if details.get("kernel_release") != kernel_release:
+                raise ValueError("Precompiled driver build metadata kernel mismatch")
+            driver_info["build"] = details
+            files["modules/driver-build-info.json"] = provenance
+    else:
+        source_archive = assets / "driver-source.tar.gz"
+        pack_driver(source_archive, sdk_version)
+        files["driver-source.tar.gz"] = source_archive
+        files["build-driver.sh"] = ROOT / "scripts/build-driver.sh"
+    runtime = runtime or AXCL / "out/axcl_android_arm64"
+    if not (runtime / "bin/axcl-smi").is_file() or not (runtime / "lib/libaxcl_rt.so").is_file():
+        raise ValueError("Missing standalone runtime build; omit --skip-native")
+    files.update({"runtime/" + str(p.relative_to(runtime)): p for p in sorted(runtime.rglob("*")) if p.is_file()})
+    files["axclctl"] = ROOT / "scripts/axclctl"
+    files["install-device.sh"] = ROOT / "scripts/install-device.sh"
+    hashes = {}
+    for name, source in files.items():
+        if not source.is_file():
+            raise ValueError(f"Missing payload file: {source}")
+        destination = assets / name
+        destination.parent.mkdir(parents=True, exist_ok=True)
+        if source.resolve() != destination.resolve():
+            shutil.copy2(source, destination)
+        hashes[name] = sha256(destination)
+    (assets / "payload.sha256").write_text("".join(f"{value}  {name}\n" for name, value in hashes.items()))
+    return {"source": pac.name, "product": product, "version": firmware_version,
+            "bytes": size, "sha256": hashes["firmware/ax650_card.pac"],
+            "modules": "embedded" if modules else "compile APK driver source on Android host",
+            "driver_mode": "prebuilt" if modules else "on-device-build", "driver_info": driver_info,
+            "kernel_release": kernel_release, "payload_sha256": hashes}
+
+
+def main():
+    parser = argparse.ArgumentParser(description=__doc__)
+    parser.add_argument("--sdk", type=Path,
+                        default=Path(os.environ.get("ANDROID_HOME", os.environ.get("ANDROID_SDK_ROOT", Path.home() / "Android/Sdk"))))
+    parser.add_argument("--ndk", type=Path,
+                        default=Path(os.environ["ANDROID_NDK_HOME"]) if os.environ.get("ANDROID_NDK_HOME") else None)
+    parser.add_argument("--skip-native", action="store_true", help="Reuse the last successful AXCL native build")
+    parser.add_argument("--pac", type=Path, required=True,
+                        help="AX650_card PAC from the same SDK (required; embedded in APK)")
+    mode = parser.add_mutually_exclusive_group(required=True)
+    mode.add_argument("--modules-dir", type=Path, help="Use precompiled board-specific .ko files instead of on-device compilation")
+    mode.add_argument("--on-device-build", action="store_true", help="Compile APK driver source on the Android host after installation")
+    parser.add_argument("--output-dir", type=Path, default=ROOT / "dist", help="Destination for APK and installation bundle")
+    args = parser.parse_args()
+    modules = args.modules_dir.resolve() if args.modules_dir else None
+    if modules is not None:
+        try:
+            validate_modules(modules)
+        except (ValueError, OSError) as error:
+            parser.error(str(error))
+    sdk = args.sdk.resolve()
+    tools = sdk / "build-tools/35.0.0"
+    platform = sdk / "platforms/android-35/android.jar"
+    if args.ndk is None:
+        parser.error("Set ANDROID_NDK_HOME or pass --ndk")
+    ndk = args.ndk.resolve()
+    toolchain = ndk / "toolchains/llvm/prebuilt/linux-x86_64"
+    java_home = Path(os.environ["JAVA_HOME"]) if os.environ.get("JAVA_HOME") else None
+    java = {}
+    for name in ["java", "javac", "keytool"]:
+        candidate = java_home / "bin" / name if java_home else shutil.which(name)
+        if not candidate or not Path(candidate).is_file():
+            parser.error(f"Missing {name}; set JAVA_HOME to a JDK 17 installation.")
+        java[name] = str(candidate)
+    env = os.environ.copy()
+    if java_home:
+        env["PATH"] = str(java_home / "bin") + os.pathsep + env.get("PATH", "")
+    for path in [tools / name for name in ["aapt2", "d8", "zipalign", "apksigner"]] + [platform]:
+        if not path.is_file():
+            parser.error(f"Missing SDK tool: {path}; install platforms;android-35 and build-tools;35.0.0.")
+    if not args.skip_native:
+        command = ["python3", ROOT / "build_native.py", "--ndk", ndk]
+        if args.ndk:
+            command += ["--ndk", ndk]
+        run(command)
+    libs = ROOT / ".build/native-libs"
+    if not (ROOT / ".build/native-build.json").is_file():
+        parser.error("No successful native build; omit --skip-native.")
+    validate_libraries(libs, toolchain)
+    build = Path(tempfile.mkdtemp(prefix="apk-", dir=ROOT / ".build"))
+    for directory in ["classes", "java", "dex", "assets"]:
+        (build / directory).mkdir()
+    manifest = json.loads((ROOT / ".build/native-build.json").read_text())
+    runtime = AXCL / "out/axcl_android_arm64"
+    expected = manifest.get("runtime", {})
+    actual = {str(p.relative_to(runtime)): sha256(p) for p in runtime.rglob("*") if p.is_file()}
+    if not expected or actual != expected:
+        parser.error("Standalone runtime differs from the last successful build; omit --skip-native")
+    validate_libraries(runtime / "lib", toolchain, sorted((runtime / "bin").iterdir()))
+    manifest.pop("stage", None)
+    manifest["app_version"] = VERSION
+    manifest["firmware"] = prepare_payload(args.pac.resolve(), modules,
+                                          build / "assets", manifest["sdk_version"])
+    (build / "assets/build-info.json").write_text(json.dumps(manifest, indent=2) + "\n")
+    run([toolchain / "bin/aarch64-linux-android24-clang++", "-std=c++17", "-O2", "-fPIC", "-shared",
+         "-Wall", "-Wextra", "-Werror", "-Wno-extern-c-compat", "-Wl,--no-undefined", "-Wl,-z,max-page-size=16384",
+         "-Wl,-soname,libaxcl_jni.so", "-I" + str(AXCL / "include/external"),
+         "-I" + str(AXCL / "include/internal"),
+         ROOT / "native/axcl_jni.cpp", "-L" + str(libs), "-laxcl_rt", "-llog",
+         "-o", libs / "libaxcl_jni.so"])
+    run([toolchain / "bin/llvm-strip", "--strip-unneeded", libs / "libaxcl_jni.so"])
+    validate_libraries(libs, toolchain)
+    resources = build / "resources.zip"
+    run([tools / "aapt2", "compile", "--dir", ROOT / "app/res", "-o", resources])
+    unsigned = build / "unsigned.apk"
+    run([tools / "aapt2", "link", "-I", platform, "--manifest", ROOT / "app/AndroidManifest.xml",
+         "--java", build / "java", "-A", build / "assets", "-o", unsigned, resources])
+    sources = sorted((ROOT / "app/src").rglob("*.java")) + sorted((build / "java").rglob("*.java"))
+    run([java["javac"], "-encoding", "UTF-8", "-source", "8", "-target", "8",
+         "-bootclasspath", str(platform) + os.pathsep + str(tools / "core-lambda-stubs.jar"),
+         "-d", build / "classes", *sources])
+    jar = build / "classes.jar"
+    with zipfile.ZipFile(jar, "w", zipfile.ZIP_DEFLATED) as archive:
+        for source in sorted((build / "classes").rglob("*.class")):
+            archive.write(source, source.relative_to(build / "classes"))
+    run([tools / "d8", "--release", "--min-api", "24", "--lib", platform,
+         "--output", build / "dex", jar], env=env)
+    with zipfile.ZipFile(unsigned, "a", zipfile.ZIP_DEFLATED) as archive:
+        for source in sorted((build / "dex").glob("*.dex")):
+            archive.write(source, source.name)
+        for source in sorted(libs.glob("*.so")):
+            archive.write(source, f"lib/arm64-v8a/{source.name}")
+    aligned = build / "aligned.apk"
+    run([tools / "zipalign", "-P", "16", "-f", "4", unsigned, aligned])
+    # Evaluation key stays in the ignored build directory and is never distributed.
+    keystore = ROOT / ".build/evaluation.keystore"
+    if not keystore.exists():
+        run([java["keytool"], "-genkeypair", "-keystore", keystore, "-storepass", "android",
+             "-keypass", "android", "-alias", "androiddebugkey", "-keyalg", "RSA", "-keysize", "2048",
+             "-validity", "10000", "-dname", "CN=AXCL Evaluation,O=Axera,C=CN", "-noprompt"])
+        keystore.chmod(0o600)
+    dist = args.output_dir.resolve()
+    dist.mkdir(parents=True, exist_ok=True)
+    flavor = "prebuilt" if modules is not None else "on-device-build"
+    if modules is not None and manifest["firmware"]["driver_info"].get("build", {}).get("kernel_android_enabled") is False:
+        flavor = "prebuilt-linux-reference"
+    apk = dist / f"AXCL-Runtime-{VERSION}-{flavor}-arm64-v8a.apk"
+    run([tools / "apksigner", "sign", "--ks", keystore, "--ks-key-alias", "androiddebugkey",
+         "--ks-pass", "pass:android", "--key-pass", "pass:android", "--out", apk, aligned], env=env)
+    run([tools / "apksigner", "verify", "--verbose", apk], env=env)
+    run([tools / "zipalign", "-c", "-P", "16", "4", apk])
+    # The OEM verifier is installed outside the customer APK. It authenticates
+    # the package signer before the privileged hook extracts or executes assets.
+    platform_classes = build / "platform-classes"
+    platform_dex = build / "platform-dex"
+    platform_classes.mkdir()
+    platform_dex.mkdir()
+    run([java["javac"], "-encoding", "UTF-8", "-source", "8", "-target", "8", "-bootclasspath", platform,
+         "-d", platform_classes, ROOT / "platform/PackageVerifier.java"])
+    verifier_classes = build / "verifier-classes.jar"
+    with zipfile.ZipFile(verifier_classes, "w", zipfile.ZIP_DEFLATED) as archive:
+        for source in platform_classes.rglob("*.class"):
+            archive.write(source, source.relative_to(platform_classes))
+    run([tools / "d8", "--release", "--min-api", "28", "--lib", platform,
+         "--output", platform_dex, verifier_classes], env=env)
+    platform_bundle = dist / f"AXCL-OEM-Integration-{VERSION}-{flavor}"
+    platform_bundle.mkdir(exist_ok=True)
+    with zipfile.ZipFile(platform_bundle / "axcl-package-verifier.jar", "w", zipfile.ZIP_DEFLATED) as archive:
+        archive.write(platform_dex / "classes.dex", "classes.dex")
+    details = subprocess.check_output([tools / "apksigner", "verify", "--print-certs", apk], env=env, text=True)
+    cert = next(line.split(": ", 1)[1] for line in details.splitlines() if line.startswith("Signer #1 certificate SHA-256 digest:"))
+    (platform_bundle / "axcl-signing.sha256").write_text(cert + "\n")
+    for name in ["axcl-package-manager", "axcl-runtime.rc"]:
+        shutil.copy2(ROOT / "platform" / name, platform_bundle / name)
+    shutil.copy2(ROOT / "platform/README.md", platform_bundle / "README.md")
+    with zipfile.ZipFile(apk) as archive:
+        bad = archive.testzip()
+        if bad:
+            raise RuntimeError(f"Corrupt APK entry: {bad}")
+        if "classes.dex" not in archive.namelist():
+            raise RuntimeError("APK has no classes.dex")
+        with archive.open("assets/firmware/ax650_card.pac") as stream:
+            digest = hashlib.sha256()
+            for block in iter(lambda: stream.read(1024 * 1024), b""):
+                digest.update(block)
+        if digest.hexdigest() != manifest["firmware"]["sha256"]:
+            raise RuntimeError("APK PAC differs from the validated SDK firmware")
+    manifest["apk"] = apk.name
+    manifest["apk_sha256"] = hashlib.sha256(apk.read_bytes()).hexdigest()
+    manifest["libraries"] = {lib.name: hashlib.sha256(lib.read_bytes()).hexdigest() for lib in libs.glob("*.so")}
+    manifest["validation"] = {"elf": "AArch64, API 24 symbol closure, no GLIBC, 16 KB aligned",
+                              "signature": "apksigner verify passed (evaluation key)",
+                              "hardware_test": "AXCL driver loading, PAC startup and DMA hardware validation not run"}
+    (dist / "build-info.json").write_text(json.dumps(manifest, indent=2) + "\n")
+    documents = [ROOT / "README.md", ROOT / "scripts/prepare-device.sh", ROOT / "scripts/install-device.sh",
+                 ROOT / "scripts/axclctl", ROOT / "scripts/axcl-device.sh", ROOT / "scripts/install-android.sh"]
+    if modules is None:
+        documents += [ROOT / "scripts/build-driver.sh", ROOT / "scripts/build.conf.example"]
+    for source in documents:
+        shutil.copy2(source, dist / source.name)
+    archive = dist / f"AXCL-Android-{VERSION}-{flavor}-arm64-v8a.zip"
+    with zipfile.ZipFile(archive, "w", zipfile.ZIP_DEFLATED) as package:
+        for source in [apk, dist / "build-info.json", *(dist / source.name for source in documents)]:
+            package.write(source, source.name)
+        for source in sorted(platform_bundle.iterdir()):
+            package.write(source, "oem-integration/" + source.name)
+    print(f"\nAPK: {apk}\nInstallation bundle: {archive}\nSHA-256: {manifest['apk_sha256']}")
+
+
+if __name__ == "__main__":
+    main()
