+            directory = Path(temporary)
+            sources = []
+            for name, content in STUBS.items():
+                path = directory / name
+                path.parent.mkdir(parents=True, exist_ok=True)
+                path.write_text(content)
+                sources.append(path)
+            classes = directory / "classes"
+            classes.mkdir()
+            app = ROOT / "app/src/com/axera/axcl"
+            subprocess.run([java_home / "bin/javac", "-encoding", "UTF-8", "-d", classes,
+                            *sources, app / "InstallerService.java"], check=True)
+            for scenario in ["ensure", "restart", "check", "device", "duplicate", "invalid",
+                             "install-failure", "native-failure", "load-failure"]:
+                with self.subTest(scenario=scenario):
+                    subprocess.run([java_home / "bin/java", "-Dtest.root=" + str(directory),
+                                    "-cp", classes, "com.axera.axcl.ServiceTest", scenario], check=True, timeout=10)
+
+
