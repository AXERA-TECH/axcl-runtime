+    static void require(boolean condition, String message) { if (!condition) throw new AssertionError(message); }
+    static Intent task(String action, String id) {
+        return new Intent("task").putExtra("operation", action).putExtra("request_id", id).putExtra("device_index", 3);
+    }
+    static void finish() throws Exception {
+        long deadline = System.nanoTime() + TimeUnit.SECONDS.toNanos(5);
+        while (InstallerService.isRunning() && System.nanoTime() < deadline) {
+            Runnable callback = Handler.posted.poll(100, TimeUnit.MILLISECONDS);
+            if (callback != null) callback.run();
+        }
+        require(!InstallerService.isRunning(), "task did not finish");
+    }
+    static void run(String scenario) throws Exception {
+        Context context = new Context();
+        InstallerService service = new InstallerService();
+        service.onCreate();
+        String operation = "ensure";
+        if (scenario.equals("invalid")) operation = "bad";
+        if (scenario.equals("check") || scenario.equals("native-failure") || scenario.equals("load-failure")) operation = "memory";
+        if (scenario.equals("device")) operation = "device";
+        if (scenario.equals("restart")) operation = "restart";
+        DeviceInstaller.fail = scenario.equals("install-failure");
+        NativeRuntime.fail = scenario.equals("native-failure");
+        NativeRuntime.loadFailure = scenario.equals("load-failure");
+        if (scenario.equals("duplicate")) DeviceInstaller.gate = new CountDownLatch(1);
+        service.onStartCommand(task(operation, "first"), 0, 1);
+        if (InstallerService.isRunning()) require(service.foreground, "work must have foreground lifetime");
+        if (scenario.equals("invalid")) {
+            require(DeviceInstaller.calls == 0 && !InstallerService.isRunning() && service.stopped, "invalid request executed");
+            return;
+        }
+        if (scenario.equals("duplicate")) {
+            service.onStartCommand(task("restart", "second"), 0, 2);
+            require(InstallStatus.last.getString("request_id").equals("first"), "duplicate replaced active request");
+            DeviceInstaller.gate.countDown();
+        }
+        finish();
+        require(service.stopped && !service.foreground, "service must stop after completion");
+        require(PowerManager.last == null || !PowerManager.last.held, "wake lock leaked");
+        if (scenario.equals("install-failure")) {
+            require(NativeRuntime.calls == 0 && !InstallStatus.last.getBoolean("success"), "failed prerequisite must not verify/pass");
+            return;
+        }
+        if (scenario.equals("native-failure") || scenario.equals("load-failure")) {
+            require(!InstallStatus.last.getBoolean("success"), "deployment success must not override verification failure");
+            require(InstallStatus.last.getString("stage").equals(scenario.equals("load-failure") ? "load" : "memory"), "wrong failure stage");
+            return;
+        }
+        require(InstallStatus.last.getBoolean("success"), "task should pass");
+        boolean install = operation.equals("ensure") || operation.equals("restart");
+        require(NativeRuntime.calls == (install ? 0 : 1), "installation must not execute diagnostic/business code");
+        if (!install) {
+            require(NativeRuntime.index == 3, "wrong diagnostic device");
+            require(NativeRuntime.memory != scenario.equals("device"), "wrong memory mode");
+        }
+        require(DeviceInstaller.calls == (install ? 1 : 0), "unexpected deployment count");
+        require(!Context.preferences.enabled, "APK must not own boot restoration");
+        require(DeviceInstaller.restarted == scenario.equals("restart"), "wrong restart mode");
+        if (install) require(InstallStatus.last.getString("stage").equals("installed"), "missing installed status");
+    }
+    public static void main(String[] args) {
+        try { run(args[0]); System.exit(0); }
+        catch (Throwable error) { error.printStackTrace(); System.exit(1); }
+    }
+}
