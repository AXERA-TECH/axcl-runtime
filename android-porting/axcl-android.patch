+#!/usr/bin/env python3
+"""Exercise real service/boot dispatch with small JVM Android boundary doubles.
+
+This does not emulate Android permission, foreground-service or broadcast policy.
+"""
+import os
+from pathlib import Path
+import subprocess
+import tempfile
+import unittest
+
+ROOT = Path(__file__).resolve().parents[1]
+STUBS = {
+    "android/content/Context.java": r"""
+package android.content;
+import java.io.File;
+public class Context {
+    public static final int MODE_PRIVATE = 0;
+    public static final String NOTIFICATION_SERVICE = "notification", POWER_SERVICE = "power";
+    public static SharedPreferences preferences = new SharedPreferences();
+    public static Intent started;
+    public static boolean rejectStart;
+    public Object getSystemService(String name) {
+        return name.equals(POWER_SERVICE) ? new android.os.PowerManager() : new android.app.NotificationManager();
+    }
+    public SharedPreferences getSharedPreferences(String name, int mode) { return preferences; }
+    public Context getApplicationContext() { return this; }
+    public File getFilesDir() { return new File(System.getProperty("test.root")); }
+    public void startForegroundService(Intent intent) {
+        if (rejectStart) throw new IllegalStateException("start denied");
+        started = intent;
+    }
+    public void startService(Intent intent) { startForegroundService(intent); }
+}
+""",
+    "android/content/SharedPreferences.java": r"""
+package android.content;
+public class SharedPreferences {
+    public boolean enabled, commit = true;
+    public boolean getBoolean(String key, boolean fallback) { return enabled; }
+    public Editor edit() { return new Editor(); }
+    public class Editor {
+        boolean value;
+        public Editor putBoolean(String key, boolean value) { this.value = value; return this; }
+        public boolean commit() { if (commit) enabled = value; return commit; }
+    }
+}
+""",
+    "android/content/Intent.java": r"""
+package android.content;
+import java.util.HashMap;
+public class Intent {
+    public static final String ACTION_BOOT_COMPLETED = "boot", ACTION_MY_PACKAGE_REPLACED = "replaced";
+    private final HashMap<String, Object> values = new HashMap<>();
+    private String action;
+    public Intent(String action) { this.action = action; }
+    public Intent(Context context, Class<?> type) {}
+    public String getAction() { return action; }
+    public Intent putExtra(String key, String value) { values.put(key, value); return this; }
+    public Intent putExtra(String key, int value) { values.put(key, value); return this; }
+    public String getStringExtra(String key) { return (String) values.get(key); }
+    public int getIntExtra(String key, int fallback) { return (int) values.getOrDefault(key, fallback); }
+}
+""",
+    "android/content/BroadcastReceiver.java": "package android.content; public abstract class BroadcastReceiver { public abstract void onReceive(Context context, Intent intent); }",
+    "android/content/pm/ServiceInfo.java": "package android.content.pm; public class ServiceInfo { public static final int FOREGROUND_SERVICE_TYPE_SPECIAL_USE = 1; }",
+    "android/app/Service.java": r"""
+package android.app;
+import android.content.*;
+import android.os.IBinder;
+public class Service extends Context {
+    public static final int START_NOT_STICKY = 2;
+    public boolean foreground, stopped;
+    public void onCreate() {}
+    public int onStartCommand(Intent intent, int flags, int id) { return 0; }
+    public IBinder onBind(Intent intent) { return null; }
+    public void startForeground(int id, Notification notification) { foreground = true; }
+    public void startForeground(int id, Notification notification, int type) { foreground = true; }
+    public void stopForeground(boolean remove) { foreground = false; }
+    public boolean stopSelfResult(int id) { stopped = true; return true; }
+    public void stopSelf() { stopped = true; }
+}
+""",
+    "android/app/Notification.java": r"""
+package android.app;
+import android.content.Context;
+public class Notification {
+    public static class Builder {
+        public Builder(Context context) {}
+        public Builder(Context context, String channel) {}
+        public Builder setSmallIcon(int icon) { return this; }
+        public Builder setContentTitle(String value) { return this; }
+        public Builder setContentText(String value) { return this; }
+        public Builder setOngoing(boolean value) { return this; }
+        public Notification build() { return new Notification(); }
+    }
