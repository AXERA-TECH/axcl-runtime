--- /dev/null
+++ b/android/scripts/prepare-device.sh
@@ -0,0 +1,38 @@
+#!/system/bin/sh
+# Read-only Android host check. Deployment is performed by the system package hook.
+set -eu
+[ "$#" -le 1 ] && [ "${1:-check}" = check ] || { echo "Usage: $0 check" >&2; exit 1; }
+echo "Kernel: $(uname -r) / $(uname -m)"
+echo "Android API: $(getprop ro.build.version.sdk)"
+echo "App ABIs: $(getprop ro.product.cpu.abilist)"
+echo "Shell identity: $(id)"
+if command -v getenforce >/dev/null 2>&1; then echo "SELinux: $(getenforce)"; fi
+if [ -r /sys/module/firmware_class/parameters/path ]; then
+    echo "firmware_class.path: $(cat /sys/module/firmware_class/parameters/path)"
+fi
+bad=0
+case ",$(getprop ro.product.cpu.abilist)," in
+    *,arm64-v8a,*) : ;; *) echo "FAIL: arm64-v8a applications are required"; bad=1 ;;
+esac
+api=$(getprop ro.build.version.sdk)
+case "$api" in
+    ''|*[!0-9]*) echo "FAIL: cannot read API"; bad=1 ;;
+    *) if [ "$api" -lt 24 ]; then echo "FAIL: API 24 or later required"; bad=1; fi ;;
+esac
+for module in ax_pcie_host_dev ax_pcie_msg ax_pcie_mmb axcl_host ax_pcie_p2p_rc; do
+    if [ -d "/sys/module/$module" ]; then echo "LOADED: $module";
+    else echo "NOT LOADED: $module (check axcl-package-manager status/log)"; fi
+done
+for node in /dev/axcl_host /dev/msg_userdev /dev/ax_mmb_dev; do
+    if [ -c "$node" ]; then ls -lZ "$node";
+    else echo "NOT READY: $node (check axcl-package-manager status/log)"; fi
+done
+echo "PCIe devices:"
+for device in /sys/bus/pci/devices/*; do
+    [ -d "$device" ] || continue
+    if [ -r "$device/vendor" ] && [ -r "$device/device" ]; then
+        echo "  ${device##*/}: $(cat "$device/vendor") $(cat "$device/device")"
+    fi
+done
+echo "Check the system installation log, then run axcl-smi for card health. APK diagnostics require separate application permissions."
+exit "$bad"
