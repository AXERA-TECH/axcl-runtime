new file mode 100644
index 0000000000000000000000000000000000000000..fd259e6835e2560f27cd269ab9c7ace18cb2f3f5
--- /dev/null
+++ b/android/build_modules.py
@@ -0,0 +1,85 @@
+#!/usr/bin/env python3
+"""Precompile the five AXCL modules on a build machine using a prepared host kernel SDK."""
+import argparse
+import hashlib
+import json
+import os
+from pathlib import Path
+import shutil
+import subprocess
+import tarfile
+import tempfile
+
+from pack_driver import OBJECTS, pack_driver
+from prebuilt import validate_modules
+
+SDK_VERSION = (Path(__file__).resolve().parent.parent / "build/version.mak").read_text().strip().split("=", 1)[1].strip()
+
+
+def build_modules(kernel, output, sdk_version=SDK_VERSION, jobs=2, make="make"):
+    kernel, output = Path(kernel).resolve(), Path(output).resolve()
+    sdk_version = sdk_version.removeprefix("SDK_VERSION=")
+    if output.exists():
+        raise ValueError(f"Output already exists; choose a new directory: {output}")
+    for name in ["Makefile", ".config", "include/config/auto.conf", "include/generated/autoconf.h"]:
+        if not (kernel / name).is_file():
+            raise ValueError(f"Missing prepared kernel build file: {kernel / name}")
+    config = (kernel / ".config").read_text()
+    if "CONFIG_ARM64=y" not in config.splitlines() or "CONFIG_MODULES=y" not in config.splitlines():
+        raise ValueError("Kernel must have CONFIG_ARM64=y and CONFIG_MODULES=y")
+    if "CONFIG_MODVERSIONS=y" in config.splitlines() and not (kernel / "Module.symvers").is_file():
+        raise ValueError("CONFIG_MODVERSIONS=y requires the target kernel Module.symvers")
+    command = [make, "-s", "-C", str(kernel), "ARCH=arm64"]
+    command += [name + "=" + os.environ[name] for name in [
+        "LLVM", "LLVM_IAS", "CROSS_COMPILE", "CROSS_COMPILE_COMPAT", "CC", "HOSTCC", "LD", "HOSTLD",
+        "AR", "NM", "STRIP", "OBJCOPY", "OBJDUMP", "READELF"
+    ] if name in os.environ]
+    release = subprocess.check_output([*command, "kernelrelease"], text=True).strip()
+    output.parent.mkdir(parents=True, exist_ok=True)
+    with tempfile.TemporaryDirectory(prefix="axcl-prebuilt-", dir=output.parent) as temporary:
+        stage = Path(temporary)
+        archive = stage / "driver-source.tar.gz"
+        source_hash = pack_driver(archive, sdk_version)
+        source = stage / "source"
+        source.mkdir()
+        with tarfile.open(archive) as package:
+            # pack_driver generated this archive locally; it contains no external links.
+            package.extractall(source)
+        subprocess.run([*command, f"M={source}", f"-j{jobs}", "modules"], check=True)
+        modules = stage / "modules"
+        modules.mkdir()
+        for directory, (name, _) in OBJECTS.items():
+            shutil.copy2(source / directory / (name + ".ko"), modules / (name + ".ko"))
+        (modules / "kernel-release.txt").write_text(release + "\n")
+        info = validate_modules(modules)
+        info.update({"sdk_version": sdk_version, "source_archive_sha256": source_hash,
+                     "kernel_android_enabled": "CONFIG_ANDROID=y" in config.splitlines(),
+                     "kernel_config_sha256": hashlib.sha256((kernel / ".config").read_bytes()).hexdigest(),
+                     "module_symvers_sha256": hashlib.sha256((kernel / "Module.symvers").read_bytes()).hexdigest()
+                     if (kernel / "Module.symvers").is_file() else None,
+                     "hardware_test": "Not run; validate on the intended Android host"})
+        (modules / "driver-build-info.json").write_text(json.dumps(info, indent=2) + "\n")
+        modules.rename(output)
+    return info
+
+
+def main():
+    parser = argparse.ArgumentParser(description=__doc__)
+    parser.add_argument("--kernel-build", required=True, type=Path)
+    parser.add_argument("--output", required=True, type=Path)
+    parser.add_argument("--sdk-version", default=SDK_VERSION)
+    parser.add_argument("--jobs", type=int, default=2)
+    parser.add_argument("--make", default=os.environ.get("MAKE", "make"))
+    args = parser.parse_args()
+    if not 1 <= args.jobs <= 64:
+        parser.error("--jobs must be 1..64")
+    info = build_modules(args.kernel_build, args.output, args.sdk_version, args.jobs, args.make)
+    print(json.dumps(info, indent=2))
+    print(f"Precompiled modules: {args.output}")
+    print("Use the target kernel's required signing process before APK packaging when signatures are enforced.")
+    if not info["kernel_android_enabled"]:
+        print("REFERENCE: this kernel has CONFIG_ANDROID disabled; these modules do not establish Android host compatibility.")
+
+
+if __name__ == "__main__":
+    main()
