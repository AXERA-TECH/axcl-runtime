+#!/usr/bin/env python3
+"""Run the actual headless shell entry points with mocked Android/ADB commands."""
+import json
+import os
+from pathlib import Path
+import shutil
+import subprocess
+import tempfile
+import unittest
+import xml.etree.ElementTree as ET
+
+ROOT = Path(__file__).resolve().parents[1]
+
+
+class HeadlessTest(unittest.TestCase):
+    def setUp(self):
+        self.temporary = tempfile.TemporaryDirectory(prefix="axcl-headless-")
+        self.addCleanup(self.temporary.cleanup)
+        self.root = Path(self.temporary.name)
+        self.bin = self.root / "bin"
+        self.bin.mkdir()
+        self.env = dict(os.environ, PATH=str(self.bin) + os.pathsep + os.environ["PATH"],
+                        TEST_ROOT=str(self.root))
+        self.mock("am", '''
+if sys.argv[1] == "get-current-user":
+    print("10")
+else:
+    (root / "am.json").write_text(json.dumps(sys.argv[1:]))
+    if os.environ.get("START_ERROR"):
+        print("Error: permission denied")
+    else:
+        (root / "request").write_text(sys.argv[sys.argv.index("request_id") + 1])
+        (root / "operation").write_text(sys.argv[sys.argv.index("operation") + 1])
+        print("Starting service")
+''')
+        self.mock("getprop", 'print(os.environ.get("API", "35"))')
+        self.mock("sleep", 'pass')
+        self.mock("content", '''
+if os.environ.get("QUERY_ERROR"):
+    print("Error while accessing provider: java.lang.SecurityException")
+    sys.exit(0)
+if sys.argv[1] == "read":
+    print('{"report":"native memory verification result"}')
+    sys.exit(0)
+count_file = root / "queries"
+count = int(count_file.read_text()) if count_file.exists() else 0
+count_file.write_text(str(count + 1))
+path = root / "request"
+request = path.read_text() if path.exists() else "last-request"
+mode = os.environ.get("RESULT", "passed")
+if mode == "busy":
+    request, state = "another-request", "running"
+elif mode == "stale":
+    request, state = "last-request", "passed"
+elif mode == "delayed" and count == 0:
+    request, state = "last-request", "passed"
+elif mode == "delayed" and count == 1:
+    state = "running"
+else:
+    state = "passed" if mode == "delayed" else mode
+success = "true" if state == "passed" and not os.environ.get("BAD_SUCCESS") else "false"
+operation_file = root / "operation"
+operation = operation_file.read_text() if operation_file.exists() else "memory"
+stage = "memory" if operation == "memory" or os.environ.get("BAD_STAGE") else "installed"
+print(f"Row: 0 request_id={request}, state={state}, success={success}, stage={stage}")
+''')
+        self.mock("adb", '''
+with (root / "adb.jsonl").open("a") as stream:
+    stream.write(json.dumps(sys.argv[1:]) + "\\n")
+if sys.argv[1] == os.environ.get("ADB_FAIL"):
+    sys.exit(1)
+if sys.argv[1] == "shell":
+    sys.exit(int(os.environ.get("REMOTE_EXIT", "0")))
+''')
+
+    def mock(self, name, body):
+        path = self.bin / name
+        path.write_text("#!/usr/bin/env python3\nimport json, os, sys\nfrom pathlib import Path\n"
+                        'root = Path(os.environ["TEST_ROOT"])\n' + body)
+        path.chmod(0o755)
+
+    def run_device(self, action="ensure", **options):
+        return subprocess.run(["sh", ROOT / "scripts/axcl-device.sh", action],
+                              env=dict(self.env, **options), text=True, capture_output=True, timeout=15)
+
+    def test_pass_requires_matching_request_and_verification(self):
+        result = self.run_device(RESULT="delayed")
+        self.assertEqual(result.returncode, 0, result.stderr)
+        self.assertIn("AXCL PASS", result.stdout)
+        self.assertEqual((self.root / "queries").read_text(), "3")
+        args = json.loads((self.root / "am.json").read_text())
+        self.assertEqual(args[0], "start-foreground-service")
+        self.assertEqual(args[args.index("--user") + 1], "10")
+        self.assertNotIn("MainActivity", " ".join(args))
+
+    def test_failure_and_interruption_propagate(self):
+        for state in ["failed", "interrupted"]:
+            with self.subTest(state=state):
+                result = self.run_device(RESULT=state)
+                self.assertEqual(result.returncode, 1)
+                self.assertIn("AXCL FAIL", result.stderr)
+
+    def test_busy_is_not_pass(self):
+        self.assertEqual(self.run_device(RESULT="busy").returncode, 3)
+
+    def test_stale_success_is_not_pass(self):
+        result = self.run_device(RESULT="stale")
+        self.assertEqual(result.returncode, 1)
+        self.assertIn("did not publish this request", result.stderr)
+
+    def test_timeout_does_not_claim_cancellation(self):
+        result = self.run_device(RESULT="running", AXCL_WAIT_SECONDS="1")
+        self.assertEqual(result.returncode, 124)
+        self.assertIn("may still be running", result.stderr)
+
+    def test_inconsistent_success_is_rejected(self):
+        self.assertEqual(self.run_device(BAD_SUCCESS="1").returncode, 1)
+
+    def test_wrong_verification_stage_is_rejected(self):
+        self.assertEqual(self.run_device(BAD_STAGE="1").returncode, 1)
+
+    def test_android_command_errors_with_zero_exit_are_rejected(self):
+        for option in ["START_ERROR", "QUERY_ERROR"]:
