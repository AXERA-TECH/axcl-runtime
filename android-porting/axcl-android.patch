+#!/usr/bin/env python3
+"""Exercise the real port-create function after a failed firmware boot."""
+from pathlib import Path
+import subprocess
+import tempfile
+import unittest
+
+SOURCE = Path(__file__).resolve().parents[2] / "drv/pcie/driver/axcl_host/axcl_pcie_host.c"
+
+
+class DriverPortTest(unittest.TestCase):
+    def test_port_create_requires_initialized_notification_channel(self):
+        source = SOURCE.read_text()
+        start = source.index("static int axcl_pcie_port_create(")
+        stop = source.index("static int axcl_pcie_port_manage(", start)
+        function = source[start:stop]
+        harness = r'''
+#include <assert.h>
+#include <errno.h>
+#include <stdlib.h>
+#include <string.h>
+#define AXERA_MAX_MAP_DEV 128
+#define MAX_MSG_PORTS 16
+#define AXCL_NOTIFY_PORT 11
+#define AXCL_BASE_PORT 12
+#define AXCL_MAX_PORT 4
+#define AXCL_RECV_TIMEOUT 50000
+#define AXCL_PORT_CREATE_FAIL 5
+#define GFP_KERNEL 0
+#define AXCL_INFO 1
+#define AXCL_ERR 2
+static void axcl_trace(int level, const char *format, ...) { (void)level; (void)format; }
+struct list_head { int unused; };
+#define INIT_LIST_HEAD(p) ((void)(p))
+#define list_add_tail(p, h) ((void)(p), (void)(h))
+struct ax_transfer_handle { int unused; };
+struct process_info_t { struct list_head dev_list; };
+struct axcl_device_info { unsigned int cmd, device, pid, port_num, ports[4]; };
+struct device_handle_t {
+    struct list_head head, usr_port_list;
+    unsigned int cmd, device, port_num, ports[4];
+};
+struct msg_handle { unsigned long pci_handle; };
+static struct msg_handle *port_handle[AXERA_MAX_MAP_DEV][MAX_MSG_PORTS];
+static int port_info[AXERA_MAX_MAP_DEV][MAX_MSG_PORTS];
+static struct device_handle_t existing;
+static struct device_handle_t *allocated;
+static int lookups, allocations, sends, existing_enabled;
+static struct device_handle_t *find_dev_handle(struct process_info_t *p, unsigned int t) {
+    (void)p; (void)t; lookups++; return existing_enabled ? &existing : NULL;
+}
+static void *kmalloc(size_t size, int flags) {
+    (void)flags; allocations++; allocated = malloc(size); return allocated;
+}
+#define kfree free
+static int axcl_pcie_msg_send(struct ax_transfer_handle *h, void *data, size_t size) {
+    (void)h; (void)data; (void)size; sends++; return 0;
+}
+static int axcl_pcie_recv_timeout(struct msg_handle *h, void *data, size_t size, int timeout) {
+    (void)h; (void)size; (void)timeout; memset(data, 0, sizeof(struct axcl_device_info)); return 0;
+}
+''' + function + r'''
+int main(void) {
+    struct process_info_t process = {0};
+    struct axcl_device_info info = {.device = 65, .pid = 123};
+    struct msg_handle notify = {0};
+    existing.cmd = 3;
+    existing.port_num = 1;
+    existing.ports[0] = 12;
+    /* Firmware failure skips notification channel creation. No port or process
+       state may be touched, even if a previous device handle exists. */
+    assert(axcl_pcie_port_create(&process, &info) == -ENODEV);
+    assert(lookups == 0 && allocations == 0 && sends == 0);
+    assert(port_info[65][12] == 0);
+    info.device = AXERA_MAX_MAP_DEV;
+    assert(axcl_pcie_port_create(&process, &info) == -ENODEV);
+    assert(lookups == 0);
+    info.device = 65;
+    port_handle[65][AXCL_NOTIFY_PORT] = &notify;
+    existing_enabled = 1;
+    assert(axcl_pcie_port_create(&process, &info) == 0);
+    assert(lookups == 1 && info.cmd == 3 && info.port_num == 1 && info.ports[0] == 12);
+    assert(allocations == 0 && sends == 0);
+    return 0;
+}
+'''
+        with tempfile.TemporaryDirectory(prefix="axcl-driver-port-") as tmp:
+            path = Path(tmp) / "test.c"
+            path.write_text(harness)
+            executable = Path(tmp) / "test"
+            subprocess.run(["cc", "-std=gnu99", "-Wall", "-Wextra", "-Werror", "-Wno-sign-compare",
+                            "-fsanitize=address,undefined", str(path), "-o", str(executable)], check=True)
+            result = subprocess.run([str(executable)], text=True, capture_output=True)
+            self.assertEqual(result.returncode, 0, result.stdout + result.stderr)
+
+
+if __name__ == "__main__":
+    unittest.main(verbosity=2)
