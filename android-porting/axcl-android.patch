diff --git a/android/app/src/com/axera/axcl/DeviceInstaller.java b/android/app/src/com/axera/axcl/DeviceInstaller.java
new file mode 100644
index 0000000000000000000000000000000000000000..c3bd0d3ac1d02eabd36dab76e0fb5248a55ca0da
--- /dev/null
+++ b/android/app/src/com/axera/axcl/DeviceInstaller.java
@@ -0,0 +1,119 @@
+package com.axera.axcl;
+
+import android.content.Context;
+import java.io.File;
+import java.io.FileInputStream;
+import java.io.FileOutputStream;
+import java.io.InputStream;
+import java.io.InputStreamReader;
+import java.nio.charset.StandardCharsets;
+import java.security.MessageDigest;
+import java.util.concurrent.CountDownLatch;
+import java.util.concurrent.TimeUnit;
+import java.util.concurrent.atomic.AtomicInteger;
+
+final class DeviceInstaller {
+    static final class Result {
+        final boolean success;
+        final String report;
+        Result(boolean success, String report) { this.success = success; this.report = report; }
+    }
+
+    private static String sha256(InputStream stream) throws Exception {
+        try (InputStream input = stream) {
+            MessageDigest digest = MessageDigest.getInstance("SHA-256");
+            byte[] buffer = new byte[131072];
+            int count;
+            while ((count = input.read(buffer)) != -1) digest.update(buffer, 0, count);
+            StringBuilder value = new StringBuilder();
+            for (byte part : digest.digest()) value.append(String.format(java.util.Locale.ROOT, "%02x", part & 255));
+            return value.toString();
+        }
+    }
+
+    private static void extract(Context context, String asset, File target) throws Exception {
+        File directory = target.getParentFile();
+        if (!directory.isDirectory() && !directory.mkdirs()) throw new IllegalStateException("Cannot create " + directory);
+        File temporary = new File(directory, target.getName() + ".tmp");
+        try (InputStream input = context.getAssets().open(asset);
+             FileOutputStream output = new FileOutputStream(temporary)) {
+            byte[] buffer = new byte[131072];
+            int count;
+            while ((count = input.read(buffer)) != -1) output.write(buffer, 0, count);
+            output.getFD().sync();
+        }
+        if (!temporary.renameTo(target)) throw new IllegalStateException("Cannot install " + target);
+    }
+
+    private static String quote(String value) { return "'" + value.replace("'", "'\\''") + "'"; }
+
+    static Result install(Context context, boolean restart) throws Exception {
+        String identity = sha256(context.getAssets().open("payload.sha256"));
+        File payload = new File(context.getCacheDir(), "payload-" + identity);
+        if (!payload.isDirectory() && !payload.mkdirs()) throw new IllegalStateException("Cannot create payload directory");
+        extract(context, "payload.sha256", new File(payload, "payload.sha256"));
+        try (java.io.BufferedReader reader = new java.io.BufferedReader(new InputStreamReader(
+                context.getAssets().open("payload.sha256"), StandardCharsets.UTF_8))) {
+            String line;
+            while ((line = reader.readLine()) != null) {
+                if (!line.matches("[0-9a-f]{64}  (firmware/ax650_card[.]pac|modules/[a-zA-Z0-9_.-]+|runtime/((bin|lib|include|etc|data)/[a-zA-Z0-9_./-]+|axcl[.]json)|axclctl|install-device[.]sh|driver-source[.]tar[.]gz|build-driver[.]sh)") || line.contains("..")) {
+                    throw new IllegalStateException("Invalid payload manifest entry");
+                }
+                String hash = line.substring(0, 64);
+                String name = line.substring(66);
+                File target = new File(payload, name);
+                if (!target.isFile() || !sha256(new FileInputStream(target)).equals(hash)) {
+                    extract(context, name, target);
+                    if (!sha256(new FileInputStream(target)).equals(hash)) throw new IllegalStateException("SHA-256 mismatch: " + name);
+                }
+            }
+        }
+        File script = new File(payload, "install-device.sh");
+        extract(context, "install-device.sh", script);
+        String command = "exec /system/bin/sh " + quote(script.getAbsolutePath()) + " "
+            + quote(payload.getAbsolutePath()) + " " + android.os.Process.myUid() + (restart ? " restart" : " ensure");
+        final Process process;
+        try {
+            process = new ProcessBuilder("su", "-c", command).redirectErrorStream(true).start();
+        } catch (java.io.IOException error) {
+            return new Result(false, "无法启动 su。请提前为本应用配置可免交互执行 su -c 的 root 环境。\n" + error);
+        }
+        StringBuilder log = new StringBuilder();
+        Thread reader = new Thread(() -> {
+            try (InputStreamReader output = new InputStreamReader(process.getInputStream(), StandardCharsets.UTF_8)) {
+                char[] buffer = new char[4096];
+                int count;
+                while ((count = output.read(buffer)) != -1) {
+                    synchronized (log) {
+                        log.append(buffer, 0, count);
+                        if (log.length() > 262144) log.delete(0, log.length() - 262144);
+                    }
+                }
+            } catch (java.io.IOException error) {
+                synchronized (log) { log.append("\nLog reader: ").append(error); }
+            }
+        }, "axcl-install-log");
+        reader.setDaemon(true);
+        reader.start();
+        // Process.waitFor(timeout) and destroyForcibly require API 26; support API 24.
+        CountDownLatch exited = new CountDownLatch(1);
+        AtomicInteger exitCode = new AtomicInteger(-1);
+        Thread waiter = new Thread(() -> {
+            try { exitCode.set(process.waitFor()); }
+            catch (InterruptedException error) { Thread.currentThread().interrupt(); }
+            finally { exited.countDown(); }
+        }, "axcl-install-wait");
+        waiter.setDaemon(true);
+        waiter.start();
+        if (!exited.await(30, TimeUnit.MINUTES)) {
+            process.destroy();
+            return new Result(false, "安装超时。请检查 root 授权和内核日志；确认旧安装进程已退出后再重试。");
+        }
+        reader.join(5000);
+        synchronized (log) {
+            return new Result(exitCode.get() == 0, "Root installer exit: " + exitCode.get() + "\n" + log);
+        }
+    }
+
+    private DeviceInstaller() {}
+}
