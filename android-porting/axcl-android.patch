+        self.assertEqual(args[args.index("operation") + 1], "memory")
+
+    def test_api24_service_start(self):
+        self.assertEqual(self.run_device(API="24").returncode, 0)
+        self.assertEqual(json.loads((self.root / "am.json").read_text())[0], "startservice")
+
+    def test_queries_do_not_start_installation(self):
+        for action in ["status", "report"]:
+            self.assertEqual(self.run_device(action).returncode, 0)
+        self.assertFalse((self.root / "am.json").exists())
+
+    def test_invalid_arguments_do_not_start_installation(self):
+        for options in [{"AXCL_ANDROID_USER": "bad"}, {"AXCL_WAIT_SECONDS": "0"},
+                        {"AXCL_WAIT_SECONDS": "7201"}, {"AXCL_WAIT_SECONDS": "x"}]:
+            self.assertNotEqual(self.run_device(**options).returncode, 0)
+        self.assertNotEqual(self.run_device("invalid").returncode, 0)
+        self.assertFalse((self.root / "am.json").exists())
+
+    def run_host(self, **options):
+        apk = self.root / "example package.apk"
+        apk.touch()
+        return subprocess.run(["sh", ROOT / "scripts/install-android.sh", apk],
+                              env=dict(self.env, **options), text=True, capture_output=True)
+
+    def test_host_only_installs_apk_without_starting_application(self):
+        self.assertEqual(self.run_host().returncode, 0)
+        calls = [json.loads(line) for line in (self.root / "adb.jsonl").read_text().splitlines()]
+        self.assertEqual([call[0] for call in calls], ["install"])
+        self.assertEqual(calls[0][2], str(self.root / "example package.apk"))
+
+    def test_host_stops_when_apk_installation_fails(self):
