@@ -0,0 +1,190 @@
+#!/usr/bin/env python3
+"""Validate precompiled-module packaging and the build-machine Kbuild entry point."""
+import hashlib
+import json
+from pathlib import Path
+import struct
+import subprocess
+import sys
+import tempfile
+import unittest
+
+ROOT = Path(__file__).resolve().parents[1]
+sys.path.insert(0, str(ROOT))
+from build_apk import prepare_payload
+from build_modules import build_modules
+from prebuilt import MODULES, validate_modules
+
+
+def module_fixture(name, release="5.15.0-fixture", flags="SMP mod_unload aarch64"):
+    """A section-table fixture for the ELF validator, not a loadable driver."""
+    names = b"\0.shstrtab\0.modinfo\0"
+    info = f"name={name}\0vermagic={release} {flags}\0".encode()
+    header = bytearray(64)
+    header[:6] = b"\x7fELF\x02\x01"
+    struct.pack_into("<HH", header, 16, 1, 183)
+    table = 64 + len(names) + len(info)
+    struct.pack_into("<Q", header, 40, table)
+    struct.pack_into("<HHH", header, 58, 64, 3, 1)
+    sections = bytes(64)
+    sections += struct.pack("<IIQQQQIIQQ", 1, 3, 0, 0, 64, len(names), 0, 0, 1, 0)
+    sections += struct.pack("<IIQQQQIIQQ", 11, 1, 0, 0, 64 + len(names), len(info), 0, 0, 1, 0)
+    return bytes(header) + names + info + sections
+
+
+class PrebuiltTest(unittest.TestCase):
+    def setUp(self):
+        self.temporary = tempfile.TemporaryDirectory(prefix="axcl-prebuilt-test-")
+        self.addCleanup(self.temporary.cleanup)
+        self.root = Path(self.temporary.name)
+        self.runtime = self.root / "runtime"
+        for name in ["lib", "bin", "include"]:
+            (self.runtime / name).mkdir(parents=True)
+        (self.runtime / "bin/axcl-smi").write_text("fixture binary")
+        (self.runtime / "lib/libaxcl_rt.so").write_text("fixture library")
+        self.modules = self.root / "modules"
+        self.modules.mkdir()
+        (self.modules / "kernel-release.txt").write_text("5.15.0-fixture\n")
+        for name in MODULES:
+            (self.modules / (name + ".ko")).write_bytes(module_fixture(name))
+
+    def prepare(self):
+        assets = self.root / "assets"
+        assets.mkdir(exist_ok=True)
+        pac = self.root / "fixture.pac"
+        pac.write_bytes(struct.pack("<IIQ32s32sIIII32s", 0x5C6D8E9F, 1, 592,
+                                   b"AX650_card", b"V3.16.0", 128, 1, 0, 0, b"") + bytes(464))
+        return prepare_payload(pac, self.modules, assets, "SDK_VERSION=V3.16.0", self.runtime), assets
+
+    def test_prebuilt_payload_contains_all_five_drivers_and_no_compiler_payload(self):
+        info, assets = self.prepare()
+        self.assertEqual(info["driver_mode"], "prebuilt")
+        self.assertEqual(info["kernel_release"], "5.15.0-fixture")
+        self.assertFalse((assets / "driver-source.tar.gz").exists())
+        self.assertFalse((assets / "build-driver.sh").exists())
+        for name, digest in info["payload_sha256"].items():
+            self.assertEqual(hashlib.sha256((assets / name).read_bytes()).hexdigest(), digest)
+        self.assertEqual(len(list((assets / "modules").glob("*.ko"))), 5)
+
+    def test_missing_driver_does_not_fall_back_to_source(self):
+        (self.modules / "ax_pcie_p2p_rc.ko").unlink()
+        with self.assertRaisesRegex(ValueError, "Missing precompiled driver"):
+            self.prepare()
+        self.assertFalse((self.root / "assets/driver-source.tar.gz").exists())
+
+    def test_on_device_variant_keeps_source_and_builder_instead_of_prebuilt_modules(self):
+        self.prepare()
+        assets = self.root / "on-device-assets"
+        assets.mkdir()
+        info = prepare_payload(self.root / "fixture.pac", None, assets, "SDK_VERSION=V3.16.0", self.runtime)
+        self.assertEqual(info["driver_mode"], "on-device-build")
+        self.assertTrue((assets / "driver-source.tar.gz").is_file())
+        self.assertTrue((assets / "build-driver.sh").is_file())
+        self.assertFalse((assets / "modules").exists())
+
+    def test_missing_kernel_release_is_rejected(self):
+        (self.modules / "kernel-release.txt").unlink()
+        with self.assertRaisesRegex(ValueError, "kernel-release.txt"):
+            validate_modules(self.modules)
+
+    def test_wrong_architecture_or_non_module_rejected(self):
+        path = self.modules / "axcl_host.ko"
+        for offset, value in [(18, 62), (16, 3)]:
+            data = bytearray(module_fixture("axcl_host"))
+            struct.pack_into("<H", data, offset, value)
+            path.write_bytes(data)
+            with self.assertRaisesRegex(ValueError, "AArch64"):
+                validate_modules(self.modules)
+
+    def test_module_name_and_release_must_match(self):
+        path = self.modules / "axcl_host.ko"
+        for data, message in [(module_fixture("other"), "name mismatch"),
+                              (module_fixture("axcl_host", "6.1.0-other"), "vermagic")]:
+            path.write_bytes(data)
+            with self.assertRaisesRegex(ValueError, message):
+                validate_modules(self.modules)
+
+    def test_mixed_vermagic_flags_rejected(self):
+        (self.modules / "axcl_host.ko").write_bytes(module_fixture("axcl_host", flags="mod_unload aarch64"))
+        with self.assertRaisesRegex(ValueError, "identical vermagic"):
+            validate_modules(self.modules)
+
+    def test_truncated_or_malformed_module_is_rejected(self):
+        path = self.modules / "axcl_host.ko"
+        for data in [b"not ELF", module_fixture("axcl_host")[:-4]]:
+            path.write_bytes(data)
+            with self.assertRaises(ValueError):
+                validate_modules(self.modules)
+
+    def test_appended_module_signature_is_preserved(self):
+        path = self.modules / "axcl_host.ko"
+        data = path.read_bytes() + b"signature-fixture~Module signature appended~\n"
+        path.write_bytes(data)
+        info = validate_modules(self.modules)
+        self.assertEqual(info["modules"]["axcl_host"]["sha256"], hashlib.sha256(data).hexdigest())
+
+    def test_provenance_sdk_mismatch_rejected(self):
+        (self.modules / "driver-build-info.json").write_text(json.dumps({"sdk_version": "V0.0.0"}))
+        with self.assertRaisesRegex(ValueError, "SDK version mismatch"):
+            self.prepare()
+
+    def test_build_cli_fails_before_toolchain_setup_when_drivers_are_missing(self):
+        result = subprocess.run([sys.executable, ROOT / "build_apk.py", "--modules-dir", self.root / "missing",
+                                 "--pac", self.root / "fixture.pac"],
+                                text=True, capture_output=True)
+        self.assertNotEqual(result.returncode, 0)
+        self.assertIn("Missing precompiled", result.stderr)
+        self.assertNotIn("Missing SDK tool", result.stderr)
+
+    def test_build_requires_explicit_pac_and_driver_mode(self):
+        for arguments, expected in [([], "--pac"), (["--pac", "fixture.pac"], "--modules-dir")]:
+            result = subprocess.run([sys.executable, ROOT / "build_apk.py", *arguments],
+                                    text=True, capture_output=True)
+            self.assertNotEqual(result.returncode, 0)
+            self.assertIn(expected, result.stderr)
+
+    def test_source_and_precompiled_modes_are_mutually_exclusive(self):
+        result = subprocess.run([sys.executable, ROOT / "build_apk.py", "--on-device-build",
+                                 "--modules-dir", self.modules], text=True, capture_output=True)
+        self.assertNotEqual(result.returncode, 0)
+        self.assertIn("not allowed with argument", result.stderr)
+
+
+class BuildMachineTest(unittest.TestCase):
+    def test_precompile_uses_prepared_kernel_and_publishes_validated_modules(self):
+        with tempfile.TemporaryDirectory(prefix="axcl-precompile-") as temporary:
+            root = Path(temporary)
+            kernel = root / "kernel"
+            (kernel / "include/config").mkdir(parents=True)
+            (kernel / "include/generated").mkdir()
+            for name in ["Makefile", ".config", "include/config/auto.conf", "include/generated/autoconf.h"]:
+                (kernel / name).write_text("CONFIG_ARM64=y\nCONFIG_MODULES=y\nCONFIG_ANDROID=y\n")
+            make = root / "make"
+            make.write_text("#!/usr/bin/env python3\nimport sys\nfrom pathlib import Path\n"
+                            + f"sys.path.insert(0, {str(Path(__file__).parent)!r})\n"
+                            + "from test_prebuilt import module_fixture\n"
+                            + "from pack_driver import OBJECTS\n"
+                            + "if 'kernelrelease' in sys.argv:\n    print('5.15.0-fixture')\nelse:\n"
+                            + "    source = Path(next(arg[2:] for arg in sys.argv if arg.startswith('M=')))\n"
+                            + "    for directory, (name, _) in OBJECTS.items():\n"
+                            + "        (source / directory / (name + '.ko')).write_bytes(module_fixture(name))\n")
+            make.chmod(0o755)
+            output = root / "output"
+            info = build_modules(kernel, output, make=str(make))
+            self.assertEqual(info["kernel_release"], "5.15.0-fixture")
+            self.assertTrue(info["kernel_android_enabled"])
+            self.assertEqual(len(list(output.glob("*.ko"))), 5)
+            self.assertTrue((output / "driver-build-info.json").is_file())
+            with self.assertRaisesRegex(ValueError, "already exists"):
+                build_modules(kernel, output, make=str(make))
+
+    def test_unprepared_kernel_is_rejected_without_output(self):
+        with tempfile.TemporaryDirectory() as temporary:
+            root = Path(temporary)
+            with self.assertRaisesRegex(ValueError, "prepared kernel"):
+                build_modules(root / "missing", root / "output")
+            self.assertFalse((root / "output").exists())
+
+
+if __name__ == "__main__":
+    unittest.main(verbosity=2)
