new file mode 100644
index 0000000000000000000000000000000000000000..710166436dc25685ce0528e5410d64305b241d19
--- /dev/null
+++ b/android/prebuilt.py
@@ -0,0 +1,65 @@
+"""Validate board-specific kernel modules before embedding them in an APK."""
+import hashlib
+from pathlib import Path
+import re
+import struct
+
+MODULES = ("ax_pcie_host_dev", "ax_pcie_msg", "ax_pcie_mmb", "axcl_host", "ax_pcie_p2p_rc")
+
+
+def module_info(path):
+    data = Path(path).read_bytes()
+    if len(data) < 64 or data[:6] != b"\x7fELF\x02\x01" or struct.unpack_from("<HH", data, 16) != (1, 183):
+        raise ValueError(f"Expected an uncompressed AArch64 ELF relocatable module: {path}")
+    offset = struct.unpack_from("<Q", data, 40)[0]
+    size, count, strings = struct.unpack_from("<HHH", data, 58)
+    if size != 64 or not 0 < count <= 4096 or strings >= count or offset < 64 or offset + size * count > len(data):
+        raise ValueError(f"Invalid ELF section table: {path}")
+    sections = [struct.unpack_from("<IIQQQQIIQQ", data, offset + size * index) for index in range(count)]
+
+    def contents(section):
+        start, length = section[4:6]
+        if start + length > len(data):
+            raise ValueError(f"Truncated ELF section: {path}")
+        return data[start:start + length]
+
+    names = contents(sections[strings])
+    for section in sections:
+        name = section[0]
+        if name >= len(names):
+            raise ValueError(f"Invalid ELF section name: {path}")
+        if names[name:].split(b"\0", 1)[0] == b".modinfo":
+            fields = {}
+            for item in contents(section).split(b"\0"):
+                if b"=" in item:
+                    key, value = item.split(b"=", 1)
+                    fields[key.decode("ascii")] = value.decode("utf-8").strip()
+            return fields, hashlib.sha256(data).hexdigest()
+    raise ValueError(f"Module has no .modinfo section: {path}")
+
+
+def validate_modules(directory):
+    directory = Path(directory)
+    release_file = directory / "kernel-release.txt"
+    if not release_file.is_file():
+        raise ValueError(f"Missing precompiled driver kernel-release.txt in {directory}; supply --modules-dir or explicitly use --on-device-build")
+    release = release_file.read_text().strip()
+    if not re.fullmatch(r"[A-Za-z0-9_.+-]+", release):
+        raise ValueError("kernel-release.txt must contain one kernel release")
+    modules = {}
+    vermagic = None
+    for name in MODULES:
+        path = directory / (name + ".ko")
+        if not path.is_file():
+            raise ValueError(f"Missing precompiled driver: {path}")
+        fields, digest = module_info(path)
+        if fields.get("name") != name:
+            raise ValueError(f"Module name mismatch: {path}: {fields.get('name')}")
+        value = fields.get("vermagic", "")
+        if not value or value.split()[0] != release:
+            raise ValueError(f"Module vermagic does not match kernel-release.txt: {path}: {value}")
+        if vermagic is not None and vermagic != value:
+            raise ValueError(f"The five modules must have identical vermagic: {path}")
+        vermagic = value
+        modules[name] = {"sha256": digest, "vermagic": value}
+    return {"kernel_release": release, "architecture": "aarch64", "modules": modules}
