+
+
+    def test_host_default_selects_the_apk_bundled_with_its_script(self):
+        bundle = self.root / "bundle"
+        bundle.mkdir()
+        script = bundle / "install-android.sh"
+        shutil.copy2(ROOT / "scripts/install-android.sh", script)
+        shutil.copy2(ROOT / "scripts/axcl-device.sh", bundle / "axcl-device.sh")
+        apk = bundle / "AXCL-Runtime-1.5.0-prebuilt-arm64-v8a.apk"
+        apk.touch()
+        result = subprocess.run(["sh", script], env=self.env, text=True, capture_output=True)
+        self.assertEqual(result.returncode, 0, result.stderr)
+        calls = [json.loads(line) for line in (self.root / "adb.jsonl").read_text().splitlines()]
+        self.assertEqual(calls[0][2], str(apk))
+        (self.root / "adb.jsonl").unlink()
+        (bundle / "AXCL-Runtime-1.5.0-on-device-build-arm64-v8a.apk").touch()
+        result = subprocess.run(["sh", script], env=self.env, text=True, capture_output=True)
+        self.assertNotEqual(result.returncode, 0)
+        self.assertFalse((self.root / "adb.jsonl").exists())
+
+    def test_manifest_limits_external_entry_points(self):
+        manifest = ET.parse(ROOT / "app/AndroidManifest.xml").getroot()
+        android = "{http://schemas.android.com/apk/res/android}"
+        service = manifest.find("application/service")
+        provider = manifest.find("application/provider")
+        for component in [service, provider]:
+            self.assertEqual(component.get(android + "permission"), "android.permission.DUMP")
+        self.assertEqual(service.get(android + "foregroundServiceType"), "specialUse")
