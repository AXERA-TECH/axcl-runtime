+#!/usr/bin/env python3
+"""Exercise the root package hooks and independent runtime using Android doubles."""
+import os
+from pathlib import Path
+import shutil
+import subprocess
+import unittest
+import zipfile
+
+from test_installer import InstallerTest, ROOT, MODULES
+from test_driver_build import BuilderTest
+
+
+class PlatformTest(unittest.TestCase):
+    command = InstallerTest.command
+    hashes = InstallerTest.hashes
+    events = InstallerTest.events
+    def setUp(self):
+        InstallerTest.setUp(self)
+        self.state = self.root / "manager-state"
+        controller = (ROOT / "scripts/axclctl").read_text()
+        for before, after in [("BASE=/data/vendor/axcl", f"BASE={self.base}"),
+                              ("SYS_MODULE=/sys/module", f"SYS_MODULE={self.sys}"),
+                              ("DEV=/dev", f"DEV={self.dev}"),
+                              ("FIRMWARE_PATH=/sys/module/firmware_class/parameters/path", f"FIRMWARE_PATH={self.parameter}")]:
+            controller = controller.replace(before, after)
+        (self.payload / "axclctl").write_text(controller)
+        (self.payload / "install-device.sh").write_text(self.script.read_text())
+        self.hashes()
+        self.apk = self.root / "installed.apk"
+        self.pack()
+        trust = self.root / "signing.sha256"
+        trust.write_text("a" * 64)
+        manager = (ROOT / "platform/axcl-package-manager").read_text()
+        for before, after in [("BASE=/data/vendor/axcl", f"BASE={self.base}"),
+                              ("STATE=/data/vendor/axcl-manager", f"STATE={self.state}"),
+                              ("TRUST=/vendor/etc/axcl-signing.sha256", f"TRUST={trust}"),
+                              ("SYSTEM_SHELL=/system/bin/sh", "SYSTEM_SHELL=/bin/sh")]:
+            manager = manager.replace(before, after)
+        self.manager = self.root / "manager.sh"
+        self.manager.write_text(manager)
+        self.command("pm", '''
+[ "${PM_UNAVAILABLE:-0}" = 0 ] || exit 1
+if [ "${PM_ZERO_ERROR:-0}" = 1 ]; then echo "Error: package service unavailable"; exit 0; fi
+echo "package:/system/framework/framework-res.apk=android"
+if [ "${REMOVED:-0}" = 0 ]; then echo "package:$TEST_ROOT/${INSTALLED_APK:-installed.apk}=com.axera.axcl"; fi
+''')
+        self.command("app_process", '''
+echo verify >> "$TEST_ROOT/verifier-events"
+[ "${UNTRUSTED:-0}" = 0 ] || exit 1
+echo "$TEST_ROOT/${INSTALLED_APK:-installed.apk}"
+''')
+        # Deliberately no am, app service or su command: lifecycle has no APK dependency.
+
+    def pack(self):
+        with zipfile.ZipFile(self.apk, "w") as archive:
+            for path in self.payload.rglob("*"):
+                if path.is_file():
+                    archive.write(path, "assets/" + str(path.relative_to(self.payload)))
+
+    def sync(self, **options):
+        return subprocess.run(["sh", self.manager, "sync"], text=True, capture_output=True,
+                              env=dict(os.environ, PATH=str(self.bin) + os.pathsep + os.environ["PATH"],
+                                       TEST_ROOT=str(self.root), **options), timeout=15)
+
+    def ctl(self, action, **options):
+        return subprocess.run(["sh", self.base / "axclctl", action], text=True, capture_output=True,
+                              env=dict(os.environ, PATH=str(self.bin) + os.pathsep + os.environ["PATH"],
+                                       TEST_ROOT=str(self.root), **options), timeout=15)
+
+    def source_build_options(self):
+        # Keep the real package hook, extraction, installer and source builder;
+        # replace only Android/kernel commands and compiler output.
+        builder = BuilderTest()
+        builder.setUp()
+        self.addCleanup(builder.doCleanups)
+        for name in ["driver-source.tar.gz", "build-driver.sh"]:
+            shutil.copyfile(builder.payload / name, self.payload / name)
+        shutil.rmtree(self.base / "modules")
+        self.command("uname", 'case "$1" in -m) echo aarch64 ;; *) echo "$SDK_RELEASE" ;; esac')
+        self.hashes()
+        self.pack()
+        return dict({name: builder.env[name] for name in
+                     ["KERNEL_BUILD", "MAKE", "CC", "HOSTCC", "CONFIG_SHELL"]},
+                    SDK_RELEASE=self.kernel, LLVM="1", LLVM_IAS="1")
+
+    def test_source_apk_compiles_and_deploys_without_application_or_su(self):
+        options = self.source_build_options()
+        result = self.sync(**options)
+        self.assertEqual(result.returncode, 0, result.stdout + result.stderr)
+        self.assertIn("BUILD OK", result.stdout)
+        self.assertEqual(len(list((self.base / "modules").glob("*.ko"))), 5)
+        self.assertEqual(self.events(), ["load:" + m for m in MODULES])
+        self.assertEqual((self.state / "status").read_text().strip(), "installed")
+        self.assertTrue((self.base / "current/bin/axcl-smi").is_file())
+
+    def test_source_compile_failure_preserves_running_environment_and_retries(self):
+        options = self.source_build_options()
+        self.assertEqual(self.sync(**options).returncode, 0)
+        old_pac = (self.base / "firmware/axcl/ax650_card.pac").read_bytes()
+        old_active = (self.state / "active-apk").read_text()
+        # A changed compiler configuration invalidates the driver's build cache.
+        options["LLVM_IAS"] = "0"
+        (self.root / "events").unlink()
+        self.pac.write_bytes(b"new firmware")
+        self.hashes()
+        self.apk = self.root / "installed-update.apk"
+        self.pack()
+        result = self.sync(INSTALLED_APK=self.apk.name, FAIL_MAKE="1", **options)
+        self.assertNotEqual(result.returncode, 0)
+        self.assertIn("Kbuild modules failed", result.stdout + result.stderr)
+        self.assertFalse(self.events())
+        self.assertEqual((self.base / "firmware/axcl/ax650_card.pac").read_bytes(), old_pac)
+        self.assertEqual((self.state / "active-apk").read_text(), old_active)
+        self.assertEqual(self.sync(INSTALLED_APK=self.apk.name, **options).returncode, 0)
+
+    def test_new_kernel_recompiles_source_from_unchanged_apk(self):
+        options = self.source_build_options()
+        self.assertEqual(self.sync(**options).returncode, 0)
+        self.assertEqual(self.ctl("stop").returncode, 0)
+        (self.state / "active-apk").write_text("previous-boot")
+        (self.root / "events").unlink()
+        options["SDK_RELEASE"] = "5.15.0-updated-host"
+        result = self.sync(**options)
+        self.assertEqual(result.returncode, 0, result.stdout + result.stderr)
+        self.assertEqual((self.base / "modules/kernel-release.txt").read_text().strip(), options["SDK_RELEASE"])
+        self.assertEqual(len((self.root / "make-calls").read_text().splitlines()), 2)
+        self.assertEqual(self.events(), ["load:" + m for m in MODULES])
+
+    def test_system_first_install_deploys_without_application_or_su(self):
+        result = self.sync()
+        self.assertEqual(result.returncode, 0, result.stdout + result.stderr)
+        self.assertTrue((self.base / "current/bin/axcl-smi").is_file())
+        self.assertTrue((self.base / "current/lib/libaxcl_rt.so").is_file())
+        self.assertTrue((self.base / "current/include").is_dir())
+        self.assertEqual(self.events(), ["load:" + m for m in MODULES])
+        self.assertFalse((self.state / "incoming").exists())
+        self.assertEqual(self.ctl("status").returncode, 0)
+
+    def test_cpp_shared_library_payload_is_accepted(self):
+        library = self.payload / "runtime/lib/libc++_shared.so"
+        library.write_bytes(b"Android C++ runtime")
+        self.hashes()
+        self.pack()
+        result = self.sync()
+        self.assertEqual(result.returncode, 0, result.stdout + result.stderr)
+        self.assertEqual((self.base / "current/lib/libc++_shared.so").read_bytes(), library.read_bytes())
+
+    def test_oem_firmware_link_preserves_vendor_path_through_install_boot_and_uninstall(self):
+        vendor = self.root / "vendor-firmware"
+        vendor.mkdir()
+        (vendor / "wifi.bin").write_bytes(b"existing vendor firmware")
+        (self.base / "firmware/axcl").mkdir(parents=True)
+        (vendor / "axcl").symlink_to(self.base / "firmware/axcl", target_is_directory=True)
+        self.parameter.write_text(str(vendor))
+        result = self.sync()
+        self.assertEqual(result.returncode, 0, result.stdout + result.stderr)
+        self.assertEqual(self.parameter.read_text(), str(vendor))
+        self.assertEqual((vendor / "axcl/ax650_card.pac").read_bytes(), self.pac.read_bytes())
+        self.assertEqual(self.ctl("stop").returncode, 0)
+        self.assertEqual(self.ctl("start").returncode, 0)
+        self.assertEqual(self.parameter.read_text(), str(vendor))
+        self.assertEqual(self.sync(REMOVED="1").returncode, 0)
+        self.assertEqual(self.parameter.read_text(), str(vendor))
+        self.assertEqual((vendor / "wifi.bin").read_bytes(), b"existing vendor firmware")
+
+    def test_oem_firmware_link_to_another_directory_is_rejected(self):
+        vendor = self.root / "vendor-firmware"
+        vendor.mkdir()
+        other = self.root / "other-firmware"
+        other.mkdir()
+        (vendor / "axcl").symlink_to(other, target_is_directory=True)
+        self.parameter.write_text(str(vendor))
+        self.assertNotEqual(self.sync().returncode, 0)
+        self.assertEqual(self.parameter.read_text(), str(vendor))
+        self.assertFalse(self.events())
+
+    def test_reboot_loads_installed_runtime_without_apk_process(self):
+        self.assertEqual(self.sync().returncode, 0)
+        self.assertEqual(self.ctl("stop").returncode, 0)
+        (self.root / "events").unlink()
+        self.assertEqual(self.ctl("start").returncode, 0)
+        self.assertEqual(self.events(), ["load:" + m for m in MODULES])
+
+    def test_package_service_boot_recovers_existing_installation(self):
+        self.assertEqual(self.sync().returncode, 0)
+        self.assertEqual(self.ctl("stop").returncode, 0)
+        (self.state / "active-apk").write_text("previous-boot")
+        (self.root / "events").unlink()
+        result = self.sync()
+        self.assertEqual(result.returncode, 0, result.stderr)
+        self.assertEqual(self.events(), ["load:" + m for m in MODULES])
+
+    def test_package_removal_unloads_and_removes_runtime(self):
+        self.assertEqual(self.sync().returncode, 0)
+        (self.root / "events").unlink()
+        result = self.sync(REMOVED="1")
+        self.assertEqual(result.returncode, 0, result.stderr)
+        self.assertEqual(self.events(), ["unload:" + m for m in reversed(MODULES)])
+        for name in ["current", "releases", "modules", "firmware", "installed-payload.sha256"]:
+            self.assertFalse((self.base / name).exists())
+        self.assertFalse((self.state / "active-apk").exists())
+
+    def test_apk_update_redeploys_pac_without_running_diagnostics(self):
+        self.assertEqual(self.sync().returncode, 0)
+        (self.root / "events").unlink()
+        self.pac.write_bytes(b"updated firmware")
+        self.hashes()
+        self.apk = self.root / "installed-update.apk"
+        self.pack()
+        result = self.sync(INSTALLED_APK=self.apk.name)
+        self.assertEqual(result.returncode, 0, result.stdout + result.stderr)
+        self.assertEqual(self.events(), ["unload:ax_pcie_p2p_rc", "unload:axcl_host", "load:axcl_host", "load:ax_pcie_p2p_rc"])
+        self.assertEqual((self.base / "firmware/axcl/ax650_card.pac").read_bytes(), self.pac.read_bytes())
+
+    def test_busy_removal_retains_runtime_and_retries(self):
+        self.assertEqual(self.sync().returncode, 0)
+        result = self.sync(REMOVED="1", BUSY_MODULE="axcl_host")
+        self.assertNotEqual(result.returncode, 0)
+        self.assertTrue((self.base / "current/lib/libaxcl_rt.so").exists())
+        self.assertTrue((self.state / "active-apk").exists())
+        self.assertEqual(self.sync(REMOVED="1").returncode, 0)
+
+    def test_framework_failure_must_not_be_treated_as_uninstall(self):
+        self.assertEqual(self.sync().returncode, 0)
+        (self.root / "events").unlink()
+        self.assertNotEqual(self.sync(PM_UNAVAILABLE="1").returncode, 0)
+        self.assertFalse(self.events())
+        self.assertTrue((self.base / "current").exists())
+        self.assertNotEqual(self.sync(PM_ZERO_ERROR="1").returncode, 0)
+        self.assertFalse(self.events())
+
+    def test_untrusted_package_never_executes_privileged_payload(self):
+        result = self.sync(UNTRUSTED="1")
+        self.assertNotEqual(result.returncode, 0)
+        self.assertFalse(self.events())
+        self.assertFalse((self.base / "current").exists())
+
+    def test_corrupt_runtime_never_loads_drivers(self):
+        (self.payload / "runtime/lib/libaxcl_rt.so").write_text("tampered")
+        self.pack()
+        self.assertNotEqual(self.sync().returncode, 0)
+        self.assertFalse(self.events())
+
+    def test_new_kernel_blocks_boot_loading(self):
+        self.assertEqual(self.sync().returncode, 0)
+        self.assertEqual(self.ctl("stop").returncode, 0)
+        (self.base / "modules/kernel-release.txt").write_text("different-kernel")
+        (self.root / "events").unlink()
+        self.assertNotEqual(self.ctl("start").returncode, 0)
+        self.assertFalse(self.events())
+
+    def test_watch_propagates_failed_installer_without_recording_success(self):
+        self.command("sleep", "exit 99")
+        result = subprocess.run(["sh", self.manager, "watch"], text=True, capture_output=True,
+            env=dict(os.environ, PATH=str(self.bin) + os.pathsep + os.environ["PATH"],
+                     TEST_ROOT=str(self.root), FAIL_MODULE="axcl_host"), timeout=15)
+        self.assertEqual(result.returncode, 99)
+        self.assertEqual((self.state / "status").read_text().strip(), "failed")
+        self.assertFalse((self.state / "active-apk").exists())
+
+
+if __name__ == "__main__":
+    # Avoid collecting the imported base class a second time.
+    unittest.main(defaultTest="PlatformTest", verbosity=2)
