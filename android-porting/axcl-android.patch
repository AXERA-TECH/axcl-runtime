@@ -0,0 +1,64 @@
+package com.axera.axcl;
+
+import android.content.Context;
+import android.util.AtomicFile;
+import java.io.File;
+import java.io.FileOutputStream;
+import java.nio.charset.StandardCharsets;
+import org.json.JSONObject;
+
+final class InstallStatus {
+    private static AtomicFile file(Context context) {
+        return new AtomicFile(new File(context.getFilesDir(), "install-status.json"));
+    }
+
+    static synchronized JSONObject read(Context context) {
+        JSONObject result;
+        try {
+            AtomicFile file = file(context);
+            if (!file.getBaseFile().exists()) {
+                return create("", "", "idle", false, "none", "尚未执行安装。", 0);
+            }
+            result = new JSONObject(new String(file.readFully(), StandardCharsets.UTF_8));
+            if ("running".equals(result.optString("state")) && !InstallerService.isRunning()) {
+                result.put("state", "interrupted");
+                result.put("success", false);
+                result.put("stage", "interrupted");
+                result.put("report", "上一次任务进程已结束，未确认成功。请检查驱动构建日志和安装锁，再重新执行 ensure。");
+            }
+            return result;
+        } catch (Exception error) {
+            return create("", "", "failed", false, "status", error.toString(), 0);
+        }
+    }
+
+    static JSONObject create(String request, String operation, String state, boolean success,
+                             String stage, String report, int deviceIndex) {
+        JSONObject result = new JSONObject();
+        try {
+            result.put("request_id", request);
+            result.put("operation", operation);
+            result.put("state", state);
+            result.put("success", success);
+            result.put("stage", stage);
+            result.put("report", report);
+            result.put("device_index", deviceIndex);
+            result.put("updated_ms", System.currentTimeMillis());
+        } catch (org.json.JSONException error) {
+            throw new IllegalStateException(error);
+        }
+        return result;
+    }
+
+    static synchronized void write(Context context, JSONObject result) throws Exception {
+        AtomicFile file = file(context);
+        FileOutputStream stream = file.startWrite();
+        try {
+            stream.write((result.toString(2) + "\n").getBytes(StandardCharsets.UTF_8));
+            file.finishWrite(stream);
+        } catch (Exception error) {
+            file.failWrite(stream);
+            throw error;
+        }
+    }
+}
diff --git a/android/app/src/com/axera/axcl/InstallerService.java b/android/app/src/com/axera/axcl/InstallerService.java
new file mode 100644
index 0000000000000000000000000000000000000000..f5919f25587455d93be92b87521f31cdf630d2d6
--- /dev/null
+++ b/android/app/src/com/axera/axcl/InstallerService.java
@@ -0,0 +1,136 @@
+package com.axera.axcl;
+
+import android.app.Notification;
+import android.app.NotificationChannel;
+import android.app.NotificationManager;
+import android.app.Service;
+import android.content.Context;
+import android.content.Intent;
+import android.content.pm.ServiceInfo;
+import android.os.Build;
+import android.os.Handler;
+import android.os.IBinder;
+import android.os.Looper;
+import android.os.PowerManager;
+import android.util.Log;
+import java.io.File;
+import java.util.concurrent.ExecutorService;
+import java.util.concurrent.Executors;
+import org.json.JSONObject;
+
+public final class InstallerService extends Service {
+    private static final String CHANNEL = "axcl-install";
+    private static final ExecutorService worker = Executors.newSingleThreadExecutor();
+    private static volatile boolean running;
+    private final Handler main = new Handler(Looper.getMainLooper());
+    private PowerManager.WakeLock wakeLock;
+
+    static boolean isRunning() { return running; }
+
+    static void start(Context context, String operation, int index, String request) {
+        Intent intent = new Intent(context, InstallerService.class);
+        intent.putExtra("operation", operation);
+        intent.putExtra("device_index", index);
+        intent.putExtra("request_id", request);
+        if (Build.VERSION.SDK_INT >= 26) context.startForegroundService(intent);
+        else context.startService(intent);
+    }
+
+    private void promoteForeground() {
+        NotificationManager manager = (NotificationManager) getSystemService(NOTIFICATION_SERVICE);
+        if (Build.VERSION.SDK_INT >= 26) {
+            manager.createNotificationChannel(new NotificationChannel(CHANNEL, "AXCL 驱动安装", NotificationManager.IMPORTANCE_LOW));
+        }
+        Notification.Builder builder = Build.VERSION.SDK_INT >= 26
+            ? new Notification.Builder(this, CHANNEL) : new Notification.Builder(this);
+        Notification notification = builder.setSmallIcon(R.drawable.ic_launcher)
+            .setContentTitle("AXCL 正在安装或检查子卡")
+            .setContentText("自动执行，无需操作；结果可通过命令行或应用查看。")
+            .setOngoing(true).build();
+        if (Build.VERSION.SDK_INT >= 34) startForeground(1, notification, ServiceInfo.FOREGROUND_SERVICE_TYPE_SPECIAL_USE);
+        else startForeground(1, notification);
+    }
+
+    @Override public int onStartCommand(Intent intent, int flags, int startId) {
+        promoteForeground();
+        if (running) {
+            Log.i("AXCL", "Installation already running; request ignored");
+            return START_NOT_STICKY;
+        }
+        String operation = intent == null ? "ensure" : intent.getStringExtra("operation");
+        if (operation == null) operation = "ensure";
+        String request = intent == null ? null : intent.getStringExtra("request_id");
+        if (request == null) request = "service-" + System.currentTimeMillis();
+        int index = intent == null ? 0 : intent.getIntExtra("device_index", 0);
+        final String action = operation;
+        final String identity = request;
+        if (!identity.matches("[a-zA-Z0-9_.-]{1,128}") || index < 0 ||
+            !(action.equals("ensure") || action.equals("restart") || action.equals("environment") ||
+              action.equals("device") || action.equals("memory"))) {
+            Log.e("AXCL", "Invalid operation, request_id or device_index");
+            stopForeground(true);
+            stopSelfResult(startId);
+            return START_NOT_STICKY;
+        }
+        running = true;
+        try {
+            InstallStatus.write(this, InstallStatus.create(identity, action, "running", false,
+                action.equals("ensure") || action.equals("restart") ? "install" : "check", "任务正在执行。", index));
+            PowerManager power = (PowerManager) getSystemService(POWER_SERVICE);
+            wakeLock = power.newWakeLock(PowerManager.PARTIAL_WAKE_LOCK, "AXCL:install");
+            wakeLock.acquire(35 * 60 * 1000L);
+        } catch (Exception error) {
+            complete(identity, action, index, false, "status", error.toString());
+            return START_NOT_STICKY;
+        }
+        worker.execute(() -> {
+            boolean success = false;
+            String stage = "exception";
+            String report;
+            try {
+                if (action.equals("ensure") || action.equals("restart")) {
+                    stage = "install";
+                    DeviceInstaller.Result deployment = DeviceInstaller.install(getApplicationContext(), action.equals("restart"));
+                    success = deployment.success;
+                    stage = success ? "installed" : "install";
+                    report = deployment.report;
+                } else {
+                    File logs = new File(getFilesDir(), "logs");
+                    if (!logs.isDirectory() && !logs.mkdirs()) throw new IllegalStateException("Cannot create native log directory");
+                    stage = "load";
+                    String value = action.equals("environment") ? NativeRuntime.nativeCheck()
+                        : NativeRuntime.nativeRun(new File(logs, "axcl.log").getAbsolutePath(), index, action.equals("memory"));
+                    JSONObject result = new JSONObject(value);
+                    stage = result.getString("stage");
+                    report = result.getString("report");
+                    success = result.getBoolean("success");
+                }
+            } catch (Exception | LinkageError error) {
+                report = error.toString();
+            }
+            final boolean passed = success;
+            final String completedStage = stage;
+            final String completedReport = report;
+            main.post(() -> complete(identity, action, index, passed, completedStage, completedReport));
+        });
+        return START_NOT_STICKY;
+    }
+
+    private void complete(String request, String operation, int index,
+                          boolean success, String stage, String report) {
+        try {
+            InstallStatus.write(this, InstallStatus.create(request, operation, success ? "passed" : "failed",
+                success, stage, report, index));
+        } catch (Exception error) {
+            Log.e("AXCL", "Cannot save installation result", error);
+        }
+        Log.i("AXCL", "request_id=" + request + " success=" + success + " stage=" + stage);
+        running = false;
+        if (wakeLock != null && wakeLock.isHeld()) wakeLock.release();
+        // A duplicate start increments the latest startId, even when its request was ignored.
+        stopForeground(true);
+        stopSelf();
+    }
+
+    @Override public IBinder onBind(Intent intent) { return null; }
+}
