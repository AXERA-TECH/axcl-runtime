+#!/usr/bin/env python3
+"""Test the actual Android driver builder without touching a host kernel or modules."""
+import hashlib
+import json
+import os
+from pathlib import Path
+import shutil
+import subprocess
+import sys
+import tarfile
+import tempfile
+import unittest
+
+ROOT = Path(__file__).resolve().parents[1]
+sys.path.insert(0, str(ROOT))
+from pack_driver import OBJECTS, pack_driver
+
+
+class SourcePackageTest(unittest.TestCase):
+    def test_archive_is_reproducible_and_dereferences_driver_links(self):
+        with tempfile.TemporaryDirectory() as directory:
+            path = Path(directory)
+            first = path / "first.tar.gz"
+            second = path / "second.tar.gz"
+            self.assertEqual(pack_driver(first, "SDK_VERSION=V3.16.0"), pack_driver(second, "SDK_VERSION=V3.16.0"))
+            with tarfile.open(first) as archive:
+                self.assertTrue(all(not member.issym() and not member.islnk() for member in archive))
+                self.assertTrue(all(not member.name.startswith("/") and ".." not in Path(member.name).parts for member in archive))
+                info = json.load(archive.extractfile("source-info.json"))
+                for name, digest in info["files"].items():
+                    self.assertEqual(hashlib.sha256(archive.extractfile(name).read()).hexdigest(), digest)
+                self.assertIn("mmb/ax_mmb_cache.S", archive.getnames())
+                self.assertIn("ax_pcie_mmb-$(CONFIG_ARM64)", archive.extractfile("mmb/Kbuild").read().decode())
+
+
+class BuilderTest(unittest.TestCase):
+    def setUp(self):
+        self.temporary = tempfile.TemporaryDirectory(prefix="axcl-builder-test-")
+        self.addCleanup(self.temporary.cleanup)
+        self.root = Path(self.temporary.name)
+        self.base = self.root / "base"
+        self.payload = self.root / "payload"
+        self.kernel = self.root / "kernel"
+        self.bin = self.root / "bin"
+        for path in [self.base, self.payload, self.kernel / "include/config", self.kernel / "include/generated", self.bin]:
+            path.mkdir(parents=True)
+        self.config("CONFIG_MODULES=y\n")
+        (self.kernel / "Makefile").write_text("# mocked prepared kernel\n")
+        shutil.copyfile(ROOT / "scripts/build-driver.sh", self.payload / "build-driver.sh")
+        pack_driver(self.payload / "driver-source.tar.gz", "V3.16.0")
+        self.command("id", '#!/bin/sh\necho 0\n')
+        self.command("uname", '#!/bin/sh\ncase "$1" in -m) echo aarch64 ;; *) echo 5.15.0-axcl-test ;; esac\n')
+        self.command("clang", '''#!/usr/bin/python3
+import os,sys
+from pathlib import Path
+if '--version' in sys.argv:
+    print('test clang, Android hosted fixture')
+    sys.exit(0)
+target=Path(sys.argv[sys.argv.index('-o')+1])
+target.write_text('#!/bin/sh\\nexit '+os.environ.get('HOST_PROGRAM_EXIT','0')+'\\n')
+target.chmod(0o755)
+''')
+        self.command("make", '''#!/usr/bin/python3
+import json,os,sys
+from pathlib import Path
+if '--version' in sys.argv:
+    print('GNU Make fixture')
+elif 'kernelrelease' in sys.argv:
+    print(os.environ.get('SDK_RELEASE','5.15.0-axcl-test'))
+else:
+    with open(os.environ['TEST_ROOT']+'/make-calls','a') as output:
+        output.write(json.dumps(sys.argv[1:])+'\\n')
+    if os.environ.get('FAIL_MAKE')=='1': sys.exit(2)
+    source=Path(next(a[2:] for a in sys.argv if a.startswith('M=')))
+    assert (source/'Kbuild').is_file()
+    for directory,module in [('host_dev','ax_pcie_host_dev'),('msg','ax_pcie_msg'),('mmb','ax_pcie_mmb'),('axcl_host','axcl_host'),('p2p_rc','ax_pcie_p2p_rc')]:
+        if module==os.environ.get('MISSING_MODULE'): continue
+        elf=bytearray(64)
+        elf[:6]=b'\\x7fELF\\x02\\x01'
+        elf[16:20]=b'\\x01\\x00\\xb7\\x00' if os.environ.get('BAD_ELF')!='1' else b'\\x01\\x00\\x3e\\x00'
+        (source/directory/(module+'.ko')).write_bytes(elf)
+''')
+        self.env = os.environ.copy()
+        for name in ["LLVM", "LLVM_IAS", "CROSS_COMPILE", "CROSS_COMPILE_COMPAT", "LD", "HOSTLD", "AR", "NM", "STRIP", "OBJCOPY", "OBJDUMP", "READELF"]:
+            self.env.pop(name, None)
+        self.env.update(PATH=str(self.bin)+os.pathsep+os.environ["PATH"], TEST_ROOT=str(self.root),
+                        KERNEL_BUILD=str(self.kernel), MAKE=str(self.bin / "make"),
+                        CC=str(self.bin / "clang"), HOSTCC=str(self.bin / "clang"), CONFIG_SHELL="/bin/sh")
+
+    def config(self, value):
+        value += "CONFIG_ARM64=y\n"
+        for name in [".config", "include/config/auto.conf", "include/generated/autoconf.h"]:
+            (self.kernel / name).write_text(value)
+
+    def command(self, name, content):
+        path = self.bin / name
+        path.write_text(content)
+        path.chmod(0o755)
+
+    def build(self, **values):
+        return subprocess.run(["sh", self.payload / "build-driver.sh", self.payload, self.base],
+                              env=dict(self.env, **values), text=True, stdout=subprocess.PIPE, stderr=subprocess.STDOUT)
+
+    def calls(self):
+        path = self.root / "make-calls"
+        return path.read_text().splitlines() if path.exists() else []
+
+    def test_success_builds_five_modules_with_kbuild_and_validates_cached_files(self):
+        result = self.build(LLVM="1", LLVM_IAS="1")
+        self.assertEqual(result.returncode, 0, result.stdout)
+        modules = Path((self.base / "build/modules-path").read_text())
+        self.assertEqual(len(list(modules.glob("*.ko"))), 5)
+        args = json.loads(self.calls()[0])
+        self.assertIn("ARCH=arm64", args)
+        self.assertIn("LLVM=1", args)
+        self.assertIn("LLVM_IAS=1", args)
+        result = self.build(LLVM="1", LLVM_IAS="1")
+        self.assertEqual(result.returncode, 0, result.stdout)
+        self.assertIn("CACHE:", result.stdout)
+        self.assertEqual(len(self.calls()), 1)
+
+    def test_corrupt_cache_is_rebuilt(self):
+        self.assertEqual(self.build().returncode, 0)
+        modules = Path((self.base / "build/modules-path").read_text())
+        (modules / "axcl_host.ko").write_bytes(b"corrupt")
+        result = self.build()
+        self.assertEqual(result.returncode, 0, result.stdout)
+        self.assertEqual(len(self.calls()), 2)
+
+    def test_changed_kernel_config_rebuilds(self):
+        self.assertEqual(self.build().returncode, 0)
+        self.config("CONFIG_MODULES=y\nCONFIG_SMP=y\n")
+        self.assertEqual(self.build().returncode, 0)
+        self.assertEqual(len(self.calls()), 2)
+
+    def test_missing_kernel_build_tree(self):
+        result = self.build(KERNEL_BUILD=str(self.root / "missing"))
+        self.assertNotEqual(result.returncode, 0)
+        self.assertIn("Missing prepared kernel build tree", result.stdout)
+
+    def test_unprepared_kernel_tree(self):
+        (self.kernel / "include/generated/autoconf.h").unlink()
+        result = self.build()
+        self.assertNotEqual(result.returncode, 0)
+        self.assertIn("Unprepared kernel tree", result.stdout)
+
+    def test_module_versions_need_matching_symbol_table(self):
+        self.config("CONFIG_MODULES=y\nCONFIG_MODVERSIONS=y\n")
+        result = self.build()
+        self.assertNotEqual(result.returncode, 0)
+        self.assertIn("Module.symvers", result.stdout)
+        (self.kernel / "Module.symvers").write_text("fixture symbols\n")
+        self.assertEqual(self.build().returncode, 0)
+
+    def test_disabled_modules_cannot_be_enabled_by_installer(self):
+        self.config("# CONFIG_MODULES is not set\n")
+        result = self.build()
+        self.assertNotEqual(result.returncode, 0)
+        self.assertIn("cannot enable", result.stdout)
+
+    def test_forced_signature_reports_oem_requirement(self):
+        self.config("CONFIG_MODULES=y\nCONFIG_MODULE_SIG_FORCE=y\n")
+        result = self.build()
+        self.assertNotEqual(result.returncode, 0)
+        self.assertIn("OEM signature", result.stdout)
+        self.assertFalse(self.calls())
+
+    def test_kernel_release_mismatch(self):
+        result = self.build(SDK_RELEASE="5.15.0-other-vendor")
+        self.assertNotEqual(result.returncode, 0)
+        self.assertIn("Kernel mismatch", result.stdout)
+
+    def test_compiler_cannot_execute(self):
+        result = self.build(CC=str(self.root / "missing-compiler"))
+        self.assertNotEqual(result.returncode, 0)
+        self.assertIn("cannot execute here", result.stdout)
+
+    def test_host_compiler_produces_unrunnable_program(self):
+        result = self.build(HOST_PROGRAM_EXIT="126")
+        self.assertNotEqual(result.returncode, 0)
+        self.assertIn("HOSTCC output cannot run", result.stdout)
+        self.assertFalse(self.calls())
+
+    def test_kernel_host_tool_with_missing_runtime_is_reported(self):
+        helper = self.kernel / "scripts/basic/fixdep"
+        helper.parent.mkdir(parents=True)
+        helper.write_text("#!/bin/sh\nexit 127\n")
+        helper.chmod(0o755)
+        result = self.build()
+        self.assertNotEqual(result.returncode, 0)
+        self.assertIn("Kernel host tool scripts/basic/fixdep cannot execute", result.stdout)
+        self.assertFalse(self.calls())
+
+    def test_failed_kbuild_does_not_publish_modules(self):
+        result = self.build(FAIL_MAKE="1")
+        self.assertNotEqual(result.returncode, 0)
+        self.assertIn("Kbuild modules failed", result.stdout)
+        self.assertFalse((self.base / "build/modules-path").exists())
+
+    def test_wrong_module_architecture_rejected(self):
+        result = self.build(BAD_ELF="1")
+        self.assertNotEqual(result.returncode, 0)
+        self.assertIn("not an AArch64", result.stdout)
+
+    def test_missing_module_is_not_published(self):
+        result = self.build(MISSING_MODULE="ax_pcie_p2p_rc")
+        self.assertNotEqual(result.returncode, 0)
+        self.assertIn("did not produce ax_pcie_p2p_rc", result.stdout)
+
+
+if __name__ == "__main__":
+    unittest.main(verbosity=2)
