new file mode 100644
index 0000000000000000000000000000000000000000..b8f5b25b7f46a838489c5f5adc52c5b5e5884317
--- /dev/null
+++ b/android/pack_driver.py
@@ -0,0 +1,67 @@
+#!/usr/bin/env python3
+"""Bundle current PCIe driver sources with an Android external-module Kbuild adapter."""
+import gzip
+import hashlib
+import json
+from pathlib import Path
+import re
+import shutil
+import tarfile
+import tempfile
+
+ROOT = Path(__file__).resolve().parent
+DRIVER = ROOT.parent / "drv/pcie/driver"
+OBJECTS = {
+    "host_dev": ("ax_pcie_host_dev", "ax_pcie_dev_host.o ax_pcie_opt.o ax_pcie_proc.o ax_pcie_msg_transfer.o version.o"),
+    "msg": ("ax_pcie_msg", "ax_pcie_msg_usrdev.o version.o"),
+    "mmb": ("ax_pcie_mmb", "ax_mmb.o version.o"),
+    "axcl_host": ("axcl_host", "axcl_pcie_host.o version.o"),
+    "p2p_rc": ("ax_pcie_p2p_rc", "ax_pcie_p2p.o version.o"),
+}
+
+
+def pack_driver(destination, sdk_version):
+    version = sdk_version.removeprefix("SDK_VERSION=")
+    if not re.fullmatch(r"[A-Za-z0-9_.-]+", version):
+        raise ValueError("Invalid driver SDK version")
+    with tempfile.TemporaryDirectory(prefix="driver-src-", dir=destination.parent) as temporary:
+        stage = Path(temporary)
+        originals = {}
+        for directory in ["include", *OBJECTS]:
+            for source in sorted((DRIVER / directory).rglob("*")):
+                if not source.is_file() or (source.suffix not in (".c", ".h", ".S") and source.name != "Makefile"):
+                    continue
+                name = source.relative_to(DRIVER)
+                target = stage / name
+                target.parent.mkdir(parents=True, exist_ok=True)
+                # Bundle real source bytes, including when the checkout uses symlinks.
+                shutil.copyfile(source, target)
+                originals[str(name)] = hashlib.sha256(target.read_bytes()).hexdigest()
+        top = "# Android adapter: build all modules together so modpost resolves shared symbols.\n"
+        top += "obj-m += " + " ".join(name + "/" for name in OBJECTS) + "\n"
+        top += 'subdir-ccflags-y += -DIS_THIRD_PARTY_PLATFORM -DAXCL_BUILD_VERSION=\\"' + version + '\\"'
+        top += ' -DCOMPILER_USERNAME=\\"android\\" -Wno-error=date-time -Wno-date-time\n'
+        (stage / "Kbuild").write_text(top)
+        for directory, (module, objects) in OBJECTS.items():
+            text = f"obj-m += {module}.o\n{module}-y := {objects}\n"
+            text += f'ccflags-y += -DAXCL_MODULE_NAME=\\"{module}\\"\n'
+            if directory == "host_dev":
+                text += "ccflags-y += -DAXCL_HOST\n"
+            if directory == "mmb":
+                text += "ax_pcie_mmb-$(CONFIG_ARM64) += ax_mmb_cache.o\n"
+            (stage / directory / "Kbuild").write_text(text)
+        (stage / "source-info.json").write_text(json.dumps({"sdk_version": version, "files": originals}, sort_keys=True, indent=2) + "\n")
+        # Stable bytes avoid rebuilding drivers when an APK changes only its UI.
+        with destination.open("wb") as output, gzip.GzipFile(filename="", fileobj=output, mode="wb", mtime=0) as compressed:
+            with tarfile.open(fileobj=compressed, mode="w", format=tarfile.USTAR_FORMAT) as archive:
+                for source in sorted(stage.rglob("*")):
+                    entry = archive.gettarinfo(str(source), arcname=str(source.relative_to(stage)))
+                    entry.uid = entry.gid = entry.mtime = 0
+                    entry.uname = entry.gname = ""
+                    entry.mode = 0o755 if source.is_dir() else 0o644
+                    if source.is_file():
+                        with source.open("rb") as stream:
+                            archive.addfile(entry, stream)
+                    else:
+                        archive.addfile(entry)
+    return hashlib.sha256(destination.read_bytes()).hexdigest()
