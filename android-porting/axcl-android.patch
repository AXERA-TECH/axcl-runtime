+include $(AXCL_BUILD_PATH)/projects/axcl_linux_arm64_rules.mak
+
+CPP         := $(ANDROID_TOOLCHAIN)/bin/aarch64-linux-android$(ANDROID_API)-clang++
+LINK        = $(CPP)
+CFLAGS      += -DANDROID
+CFLAGS      += -Wno-unused-command-line-argument
+CFLAGS      += -Wno-unused-but-set-variable
+CFLAGS      += -Wno-extern-c-compat
+CFLAGS      += -Wno-delete-non-abstract-non-virtual-dtor
+CFLAGS      += -Wno-unused-private-field
+CFLAGS      += -Wno-implicit-const-int-float-conversion
+CFLAGS      += -Wno-overloaded-virtual
+CFLAGS      += -Wno-deprecated-declarations
+CFLAGS      += -Wno-unused-const-variable
+CFLAGS      += -Wno-unused-lambda-capture
+CFLAGS      += -Wno-deprecated-non-prototype
+CFLAGS      += -Wno-missing-braces
+CFLAGS      += -Wno-enum-conversion
+CFLAGS      += -Wno-tautological-constant-out-of-range-compare
+CFLAGS      += -Wno-constant-conversion
+CFLAGS      += -Wno-main
+CLIB        := $(filter-out -lstdc++ -lpthread -lrt,$(CLIB)) -lc++_shared
+
+
+# Match the protobuf-lite Release build and reject incomplete links.
+CFLAGS += -DNDEBUG
+LDFLAGS += -Wl,--no-undefined -Wl,-z,max-page-size=16384
+CLIB += -L$(AXCL_LIB_PATH) -lspdlog -llog
+
+ifneq ($(SONAME),)
+LDFLAGS += -Wl,-rpath,'$$ORIGIN'
+else ifneq ($(TARGET),)
+LDFLAGS += -Wl,-rpath,'$$ORIGIN/../lib'
+endif
+
+# DMA calls the message transport; record that dependency for Android's linker.
+ifeq ($(MOD_NAME),axcl_pcie_dma)
+CLIB += -L$(AXCL_LIB_PATH) -laxcl_pcie_msg
+endif
