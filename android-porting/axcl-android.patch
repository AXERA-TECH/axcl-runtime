index 0000000000000000000000000000000000000000..478101ebde67a06e403831a724287068c5f22516
--- /dev/null
+++ b/android/build_native.py
@@ -0,0 +1,204 @@
+#!/usr/bin/env python3
+"""Build the standalone AXCL sources for Android arm64 in an isolated tree."""
+
+import argparse
+import hashlib
+import json
+import os
+from pathlib import Path
+import re
+import shutil
+import subprocess
+import tempfile
+
+
+ROOT = Path(__file__).resolve().parent
+AXCL = ROOT.parent
+SYSTEM_LIBS = {"libc.so", "libm.so", "libdl.so", "liblog.so", "libz.so", "libandroid.so"}
+
+
+def run(args, **kwargs):
+    print("+", " ".join(map(str, args)), flush=True)
+    subprocess.run(list(map(str, args)), check=True, **kwargs)
+
+
+def copy_tree(src, dst):
+    shutil.copytree(src, dst, dirs_exist_ok=True,
+                    ignore=shutil.ignore_patterns(".git", ".build", "out", "*.o", "*.d", "*.debug"))
+
+
+def validate_libraries(libdir, toolchain, executables=()):
+    """Check architecture, GLIBC leakage, dependency closure and 16 KB alignment."""
+    readelf = toolchain / "bin/llvm-readelf"
+    libraries = sorted(libdir.glob("*.so*"))
+    exports = set()
+    undefined = {}
+    for lib in libraries + list(executables):
+        header = subprocess.check_output([readelf, "-h", lib], text=True)
+        if "AArch64" not in header:
+            raise RuntimeError(f"Not an AArch64 library: {lib}")
+        symbols = subprocess.check_output([readelf, "--dyn-syms", "--wide", lib], text=True)
+        if re.search(r"\bGLIBC_\d", symbols):
+            raise RuntimeError(f"GLIBC dependency: {lib}")
+        undefined[lib.name] = set()
+        for line in symbols.splitlines():
+            columns = line.split()
+            if len(columns) < 8 or not columns[0].endswith(":"):
+                continue
+            name = columns[7].split("@")[0]
+            if columns[6] == "UND":
+                if columns[4] != "WEAK":
+                    undefined[lib.name].add(name)
+            elif columns[4] in ("GLOBAL", "WEAK") and columns[5] in ("DEFAULT", "PROTECTED"):
+                exports.add(name)
+        dynamic = subprocess.check_output([readelf, "-d", lib], text=True)
+        if executables and lib.parent == libdir and lib.name.startswith("libaxcl_") and "$ORIGIN" not in dynamic:
+            raise RuntimeError(f"Missing transitive runtime library search path: {lib}")
+        for dependency in re.findall(r"\(NEEDED\).*?\[(.*?)\]", dynamic):
+            if dependency not in SYSTEM_LIBS and not (libdir / dependency).is_file():
+                raise RuntimeError(f"Missing dependency: {lib.name} -> {dependency}")
+        segments = subprocess.check_output([readelf, "-lW", lib], text=True)
+        for line in segments.splitlines():
+            if line.strip().startswith("LOAD") and int(line.split()[-1], 16) < 16384:
+                raise RuntimeError(f"Library is not 16 KB aligned: {lib}")
+
+    # Resolve against the minimum-API NDK stubs, not the build machine's libc.
+    stubs = toolchain / "sysroot/usr/lib/aarch64-linux-android/24"
+    for name in SYSTEM_LIBS:
+        stub = stubs / name
+        if not stub.is_file():
+            continue
+        symbols = subprocess.check_output([readelf, "--dyn-syms", "--wide", stub], text=True)
+        for line in symbols.splitlines():
+            columns = line.split()
+            if len(columns) >= 8 and columns[0].endswith(":") and columns[6] != "UND":
+                exports.add(columns[7].split("@")[0])
+    for name, symbols in undefined.items():
+        missing = sorted(symbols - exports)
+        if missing:
+            raise RuntimeError(f"Unresolved symbols in {name}: {missing[:12]}")
+    return libraries
+
+
+def main():
+    parser = argparse.ArgumentParser(description=__doc__)
+    parser.add_argument("--ndk", type=Path,
+                        default=Path(os.environ["ANDROID_NDK_HOME"]) if os.environ.get("ANDROID_NDK_HOME") else None)
+    parser.add_argument("--jobs", type=int, default=int(os.environ.get("JOBS", min(os.cpu_count() or 1, 16))))
+    args = parser.parse_args()
+    if args.jobs < 1:
+        parser.error("--jobs must be positive")
+    if args.ndk is None:
+        parser.error("Set ANDROID_NDK_HOME or pass --ndk")
+    ndk = args.ndk.resolve()
+    toolchain = ndk / "toolchains/llvm/prebuilt/linux-x86_64"
+    for required in [toolchain / "bin/aarch64-linux-android24-clang++",
+                     AXCL / "build/projects/axcl_android_arm64_rules.mak",
+                     AXCL / "3rdparty/protobuf/android_arm64/lib/libprotobuf-lite.a",
+                     AXCL / "3rdparty/spdlog/android_arm64/lib/libspdlog.so",
+                     AXCL / "3rdparty/zmq/android_arm64/libzmq.a"]:
+        if not required.is_file():
+            parser.error(f"Missing prerequisite: {required}. See README.md.")
+    build = ROOT / ".build"
+    build.mkdir(exist_ok=True)
+    stage = Path(tempfile.mkdtemp(prefix="sdk-", dir=build))
+    dest = stage / "axcl"
+    print(f"Isolated source tree: {stage}", flush=True)
+    for name in ["logger", "drv", "comm", "protocol", "host", "include", "toolkit", "sample"]:
+        copy_tree(AXCL / name, dest / name)
+    (dest / "build/projects").mkdir(parents=True)
+    for src in (AXCL / "build").iterdir():
+        if src.is_file():
+            shutil.copy2(src, dest / "build" / src.name)
+    for src in (AXCL / "build/projects").glob("*.mak"):
+        shutil.copy2(src, dest / "build/projects" / src.name)
+    for name in ["cJSON", "argsxx", "cmdline", "md5"]:
+        copy_tree(AXCL / f"3rdparty/{name}", dest / f"3rdparty/{name}")
+    for name in ["spdlog", "protobuf", "zmq"]:
+        copy_tree(AXCL / f"3rdparty/{name}/android_arm64",
+                  dest / f"3rdparty/{name}/android_arm64")
+    (dest / "3rdparty/protobuf/x64/bin").mkdir(parents=True)
+    shutil.copy2(AXCL / "3rdparty/protobuf/x64/bin/protoc",
+                 dest / "3rdparty/protobuf/x64/bin/protoc")
+    copy_tree(AXCL / "3rdparty/zmq/include", dest / "3rdparty/zmq/include")
+    shutil.copy2(AXCL / "3rdparty/spdlog/Makefile", dest / "3rdparty/spdlog/Makefile")
+    env = os.environ.copy()
+    env.update(ANDROID_NDK_HOME=str(ndk), ANDROID_NDK_ROOT=str(ndk), ANDROID_API="24",
+               ANDROID_HOST_TAG="linux-x86_64", AXCL_HOME_PATH=str(dest))
+    # Isolate generated protobuf headers and intermediate objects from the checkout.
+    env.pop("MAKEFLAGS", None)
+    env.pop("MFLAGS", None)
+    modules = ["3rdparty/spdlog", "logger", "drv/pcie/msg", "drv/pcie/dma", "comm", "protocol",
+               "host/token", "host/runtime", "host/native", "sample/axclite"]
+    run(["make", "OS=android", "host=arm64", "-C", dest / "host", "prepare"], env=env)
+    for module in modules:
+        run(["make", "OS=android", "host=arm64", "-C", dest / module, "all", f"-j{args.jobs}"], env=env)
+    applications = ["host/smi", "host/spl_update"] + ["sample/" + name for name in
+        ["runtime", "memory", "engine", "venc", "ivps", "dmadim", "sys", "ive", "subid"]]
+    for module in applications:
+        run(["make", "OS=android", "host=arm64", "-C", dest / module, "all", f"-j{args.jobs}"], env=env)
+    generated = dest / "out/axcl_android_arm64/lib"
+    libs = ROOT / ".build/native-libs"
+    if libs.exists():
+        shutil.rmtree(libs)
+    libs.mkdir()
+    # Only publish the runtime closure used by this APK. Native media libraries remain in stage.
+    for name in ["libaxcl_rt.so", "libaxcl_pkg.so", "libaxcl_comm.so", "libaxcl_token.so",
+                 "libaxcl_logger.so", "libaxcl_pcie_msg.so", "libaxcl_pcie_dma.so", "libspdlog.so"]:
+        shutil.copy2(generated / name, libs / name)
+    for source in generated.glob("libspdlog.so.*"):
+        shutil.copy2(source, libs / source.name)
+    shutil.copy2(toolchain / "sysroot/usr/lib/aarch64-linux-android/libc++_shared.so",
+                 libs / "libc++_shared.so")
+    libraries = validate_libraries(libs, toolchain)
+    # Publish the complete native API environment independently of the diagnostic APK.
+    runtime = AXCL / "out/axcl_android_arm64"
+    if runtime.exists():
+        shutil.rmtree(runtime)
+    (runtime / "lib").mkdir(parents=True)
+    for source in generated.glob("*.so*"):
+        shutil.copy2(source, runtime / "lib" / source.name)
+    shutil.copy2(libs / "libc++_shared.so", runtime / "lib/libc++_shared.so")
+    (runtime / "bin").mkdir()
+    for source in (dest / "out/axcl_android_arm64/bin").iterdir():
+        # The Linux demo installs a directory containing its ELF plus shell
+        # launchers. Publish the Android ELF alongside the other native tools.
+        binary = source / source.name if source.is_dir() else source
+        shutil.copy2(binary, runtime / "bin" / binary.name)
+    shutil.copytree(dest / "out/axcl_android_arm64/include", runtime / "include")
+    for header in (dest / "sample/axclite/include").glob("*.h"):
+        shutil.copy2(header, runtime / "include" / header.name)
+    etc = dest / "out/axcl_android_arm64/etc"
+    if etc.is_dir():
+        shutil.copytree(etc, runtime / "etc")
+    data = dest / "out/axcl_android_arm64/data"
+    if data.is_dir():
+        shutil.copytree(data, runtime / "data")
+    config = json.loads((AXCL / "host/runtime/config/axcl.json").read_text())
+    config["log"]["host"]["path"] = "/data/vendor/axcl/log/axcl_logs.txt"
+    (runtime / "axcl.json").write_text(json.dumps(config, indent=2) + "\n")
+    validate_libraries(runtime / "lib", toolchain, sorted((runtime / "bin").iterdir()))
+    # Use a relative RUNPATH for standalone executables, without Android ldconfig.
+    for binary in (runtime / "bin").iterdir():
+        dynamic = subprocess.check_output([toolchain / "bin/llvm-readelf", "-d", binary], text=True)
+        if "$ORIGIN/../lib" not in dynamic:
+            raise RuntimeError(f"Missing runtime library search path: {binary}")
+        segments = subprocess.check_output([toolchain / "bin/llvm-readelf", "-l", binary], text=True)
+        if "/system/bin/linker64" not in segments:
+            raise RuntimeError(f"Not an Android PIE executable: {binary}")
+    manifest = {
+        "sdk_version": (AXCL / "build/version.mak").read_text().strip(),
+        "source_commit": subprocess.check_output(["git", "-C", AXCL, "rev-parse", "HEAD"], text=True).strip(),
+        "source_dirty": bool(subprocess.check_output(["git", "-C", AXCL, "status", "--porcelain", "--untracked-files=no"], text=True)),
+        "ndk": (ndk / "source.properties").read_text().strip(),
+        "android_api": 24, "abi": "arm64-v8a", "stage": str(stage),
+        "libraries": {lib.name: hashlib.sha256(lib.read_bytes()).hexdigest() for lib in libraries},
+        "runtime": {str(p.relative_to(runtime)): hashlib.sha256(p.read_bytes()).hexdigest()
+                    for p in sorted(runtime.rglob("*")) if p.is_file()},
+    }
+    (build / "native-build.json").write_text(json.dumps(manifest, indent=2) + "\n")
+    print(f"Native libraries ready: {libs}")
+
+
+if __name__ == "__main__":
+    main()
diff --git a/android/native/axcl_jni.cpp b/android/native/axcl_jni.cpp
new file mode 100644
index 0000000000000000000000000000000000000000..0f0d6c3458c0f841a49ac533a48d4869632c5e24
--- /dev/null
+++ b/android/native/axcl_jni.cpp
@@ -0,0 +1,237 @@
+#include <jni.h>
+#include <cerrno>
+#include <cstring>
+#include <exception>
+#include <fcntl.h>
+#include <fstream>
+#include <iomanip>
+#include <sstream>
+#include <string>
+#include <sys/stat.h>
+#include <sys/utsname.h>
+#include <unistd.h>
+
+#include "axcl.h"
+#include "axcl_rt_config.h"
+
+namespace {
+
+std::string quote(const std::string &value) {
+    std::ostringstream out;
+    out << '"';
+    for (unsigned char c : value) {
+        switch (c) {
+            case '"': out << "\\\""; break;
+            case '\\': out << "\\\\"; break;
+            case '\n': out << "\\n"; break;
+            case '\r': out << "\\r"; break;
+            case '\t': out << "\\t"; break;
+            default:
+                if (c < 32) {
+                    out << "\\u" << std::hex << std::setw(4) << std::setfill('0') << unsigned(c) << std::dec;
+                } else {
+                    out << c;
+                }
+        }
+    }
+    out << '"';
+    return out.str();
+}
+
+jstring result(JNIEnv *env, bool success, const std::string &stage, const std::string &report) {
+    const std::string json = "{\"success\":" + std::string(success ? "true" : "false") +
+                             ",\"stage\":" + quote(stage) + ",\"report\":" + quote(report) + "}";
+    return env->NewStringUTF(json.c_str());
+}
+
+std::string error_code(axclError code) {
+    std::ostringstream out;
+    out << "0x" << std::hex << std::setw(8) << std::setfill('0') << static_cast<uint32_t>(code);
+    return out.str();
+}
+
+bool check_nodes(std::ostringstream &out) {
+    bool success = true;
+    for (const char *path : {"/dev/axcl_host", "/dev/msg_userdev", "/dev/ax_mmb_dev"}) {
+        struct stat info {};
+        if (::stat(path, &info) != 0) {
+            out << "FAIL " << path << ": " << std::strerror(errno) << " (errno=" << errno << ")\n";
+            success = false;
+        } else if (!S_ISCHR(info.st_mode)) {
+            out << "FAIL " << path << ": expected character device\n";
+            success = false;
+        } else {
+            const int fd = ::open(path, O_RDWR | O_CLOEXEC);
+            if (fd < 0) {
+                out << "FAIL " << path << ": " << std::strerror(errno) << " (errno=" << errno << ")\n";
+                success = false;
+            } else {
+                out << "PASS " << path << ": open(O_RDWR)\n";
+                ::close(fd);
+            }
+        }
+    }
+    return success;
+}
+
+void environment(std::ostringstream &out) {
+    struct utsname system {};
+    if (::uname(&system) == 0) {
+        out << "Kernel: " << system.release << " / " << system.machine << '\n';
+    }
+    out << "App UID: " << ::getuid() << "\nPage size: " << ::sysconf(_SC_PAGESIZE) << '\n';
+    std::ifstream context("/proc/self/attr/current");
+    std::string label;
+    if (std::getline(context, label)) {
+        while (!label.empty() && label.back() == '\0') label.pop_back();
+        out << "SELinux context: " << label << '\n';
+    }
+    int32_t major = 0, minor = 0, patch = 0;
+    const axclError code = axclrtGetVersion(&major, &minor, &patch);
+    if (code == AXCL_SUCC) {
+        out << "AXCL runtime: " << major << '.' << minor << '.' << patch << "\n\n";
+    } else {
+        out << "axclrtGetVersion: " << error_code(code) << "\n\n";
+    }
+}
+
+struct Runtime {
+    bool initialized = false;
+    bool active = false;
+    int32_t device = 0;
+    void *host[2] = {nullptr, nullptr};
+    void *memory[2] = {nullptr, nullptr};
+
+    // Cleanup is explicit so failed frees/reset/finalize cannot be reported as PASS.
+    bool cleanup(std::ostringstream &out) {
+        bool success = true;
+        auto check = [&](const char *name, axclError code) {
+            if (code != AXCL_SUCC) {
+                out << "FAIL " << name << ": " << error_code(code) << '\n';
+                success = false;
+            }
+        };
+        for (auto &ptr : memory) {
+            if (ptr) { check("axclrtFree", axclrtFree(ptr)); ptr = nullptr; }
+        }
+        for (auto &ptr : host) {
+            if (ptr) { check("axclrtFreeHost", axclrtFreeHost(ptr)); ptr = nullptr; }
+        }
+        if (active) { check("axclrtResetDevice", axclrtResetDevice(device)); active = false; }
+        if (initialized) { check("axclFinalize", axclFinalize()); initialized = false; }
+        axclrtConfigUnLoad();
+        return success;
+    }
+};
+
+bool memory_test(Runtime &runtime, std::ostringstream &out) {
+    constexpr size_t size = 1024 * 1024;
+    auto check = [&](const char *name, axclError code) {
+        if (code != AXCL_SUCC) {
+            out << "FAIL " << name << ": " << error_code(code) << '\n';
+            return false;
+        }
+        out << "PASS " << name << '\n';
+        return true;
+    };
+    for (int i = 0; i < 2; ++i) {
+        if (!check("axclrtMallocHost(1 MiB)", axclrtMallocHost(&runtime.host[i], size))) return false;
+        if (!check("axclrtMalloc(1 MiB)", axclrtMalloc(&runtime.memory[i], size, AXCL_MEM_MALLOC_NORMAL_ONLY))) return false;
+    }
+    auto *source = static_cast<unsigned char *>(runtime.host[0]);
+    for (size_t i = 0; i < size; ++i) source[i] = static_cast<unsigned char>((i * 31 + (i >> 8)) & 0xff);
+    std::memset(runtime.host[1], 0, size);
+    if (!check("memcpy host -> device", axclrtMemcpy(runtime.memory[0], runtime.host[0], size, AXCL_MEMCPY_HOST_TO_DEVICE))) return false;
+    if (!check("memcpy device -> device", axclrtMemcpy(runtime.memory[1], runtime.memory[0], size, AXCL_MEMCPY_DEVICE_TO_DEVICE))) return false;
+    if (!check("memcpy device -> host", axclrtMemcpy(runtime.host[1], runtime.memory[1], size, AXCL_MEMCPY_DEVICE_TO_HOST))) return false;
+    const bool same = std::memcmp(runtime.host[0], runtime.host[1], size) == 0;
+    out << (same ? "PASS" : "FAIL") << " 1 MiB round-trip byte comparison\n";
+    return same;
+}
+
+}  // namespace
+
+extern "C" JNIEXPORT jstring JNICALL
+Java_com_axera_axcl_NativeRuntime_nativeCheck(JNIEnv *env, jclass) {
+    try {
+        std::ostringstream out;
+        environment(out);
+        const bool success = check_nodes(out);
+        out << "\nDevice node access is checked under the APK's own UID.\n"
+               "Use device detection to verify driver ioctls and connected cards.\n";
+        return result(env, success, "environment", out.str());
+    } catch (const std::exception &ex) {
+        return result(env, false, "exception", ex.what());
+    }
+}
+
+extern "C" JNIEXPORT jstring JNICALL
+Java_com_axera_axcl_NativeRuntime_nativeRun(JNIEnv *env, jclass, jstring log_path, jint index, jboolean test_memory) {
+    Runtime runtime;
+    std::ostringstream out;
+    std::string stage = "environment";
+    bool success = false;
+    try {
+        environment(out);
+        if (!check_nodes(out)) return result(env, false, stage, out.str());
+        const char *path = env->GetStringUTFChars(log_path, nullptr);
+        if (!path) return nullptr;
+        const std::string log = path;
+        env->ReleaseStringUTFChars(log_path, path);
+        const std::string config = "{\"log\":{\"host\":{\"path\":" + quote(log) + ",\"level\":2}}}";
+        stage = "initialize";
+        axclError code = axclrtConfigLoad(config.c_str());
+        if (code == AXCL_SUCC) code = axclInit(nullptr);
+        if (code != AXCL_SUCC) {
+            out << "FAIL axclInit: " << error_code(code) << '\n';
+        } else {
+            runtime.initialized = true;
+            out << "PASS axclInit\n";
+            stage = "devices";
+            axclrtDeviceList devices {};
+            code = axclrtGetDeviceList(&devices);
+            if (code != AXCL_SUCC) {
+                out << "FAIL axclrtGetDeviceList: " << error_code(code) << '\n';
+            } else if (devices.num == 0 || devices.num > AXCL_MAX_DEVICE_COUNT) {
+                out << "FAIL invalid device count: " << devices.num << '\n';
+            } else {
+                out << "Device count: " << devices.num << '\n';
+                for (uint32_t i = 0; i < devices.num; ++i) {
+                    out << "  index " << i << ": device ID " << devices.devices[i] << '\n';
+                }
+                if (index < 0 || static_cast<uint32_t>(index) >= devices.num) {
+                    out << "FAIL selected index " << index << " is out of range\n";
+                } else {
+                    runtime.device = devices.devices[index];
+                    stage = "activate";
+                    code = axclrtSetDevice(runtime.device);
+                    if (code != AXCL_SUCC) {
+                        out << "FAIL axclrtSetDevice: " << error_code(code) << '\n';
+                    } else {
+                        runtime.active = true;
+                        out << "PASS axclrtSetDevice(" << runtime.device << ")\n";
+                        axclrtDeviceProperties properties {};
+                        code = axclrtGetDeviceProperties(runtime.device, &properties);
+                        if (code == AXCL_SUCC) {
+                            out << "Firmware: " << std::string(properties.swVersion, strnlen(properties.swVersion, sizeof(properties.swVersion)))
+                                << "\nTemperature: " << properties.temperature << " C\n";
+                        } else {
+                            out << "WARN axclrtGetDeviceProperties: " << error_code(code) << '\n';
+                        }
+                        stage = test_memory ? "memory" : "devices";
+                        success = !test_memory || memory_test(runtime, out);
+                    }
+                }
+            }
+        }
+    } catch (const std::exception &ex) {
+        stage = "exception";
+        out << "FAIL exception: " << ex.what() << '\n';
+    }
+    if (!runtime.cleanup(out)) {
+        success = false;
+        stage = "cleanup";
+    }
+    out << "\nResult: " << (success ? "PASS" : "FAIL") << '\n';
+    return result(env, success, stage, out.str());
+}
diff --git a/android/native/diagnostics_test.cpp b/android/native/diagnostics_test.cpp
new file mode 100644
index 0000000000000000000000000000000000000000..fa6fb867bb6b7b040d701693926b592d1b458b27
--- /dev/null
+++ b/android/native/diagnostics_test.cpp
@@ -0,0 +1,176 @@
+// Host-side fault injection for the JNI diagnostic lifecycle; no AX650 required.
+#include <cstdlib>
+#include <iostream>
+#include <set>
+#include <stdexcept>
+
+#include "axcl_jni.cpp"
+
+namespace {
+struct State {
+    int init = 0, finalize = 0, reset = 0, unload = 0, allocations = 0, copies = 0;
+    int fail_allocation = 0;
+    bool denied = false, fail_init = false, fail_list = false, fail_activate = false;
+    bool corrupt = false, fail_free = false, throw_copy = false, no_devices = false;
+    std::set<void *> pointers;
+    std::string config;
+} state;
+
+void require(bool condition, const char *message) {
+    if (!condition) throw std::runtime_error(message);
+}
+
+jstring JNICALL make_string(JNIEnv *, const char *value) {
+    return reinterpret_cast<jstring>(new std::string(value));
+}
+
+const char *JNICALL get_string(JNIEnv *, jstring value, jboolean *) {
+    return reinterpret_cast<std::string *>(value)->c_str();
+}
+
+void JNICALL release_string(JNIEnv *, jstring, const char *) {}
+
+std::string run_diagnostic(JNIEnv *env, bool memory = true, int index = 0) {
+    std::string path = "/app/files/logs/axcl.log";
+    auto *value = reinterpret_cast<std::string *>(Java_com_axera_axcl_NativeRuntime_nativeRun(
+        env, nullptr, reinterpret_cast<jstring>(&path), index, memory));
+    require(value != nullptr, "No JNI result");
+    std::string report = *value;
+    delete value;
+    require(state.pointers.empty(), "Leaked diagnostic memory");
+    return report;
+}
+
+void expect(const std::string &report, bool pass, const char *name) {
+    if (report.find(pass ? "\"success\":true" : "\"success\":false") == std::string::npos) {
+        std::cerr << report << '\n';
+        throw std::runtime_error(name);
+    }
+    std::cout << "PASS " << name << '\n';
+}
+
+axclError allocate(void **ptr, size_t size) {
+    if (++state.allocations == state.fail_allocation) return -1;
+    *ptr = std::malloc(size);
+    if (!*ptr) return -1;
+    state.pointers.insert(*ptr);
+    return AXCL_SUCC;
+}
+
+axclError release(void *ptr) {
+    require(state.pointers.erase(ptr) == 1, "Invalid or repeated free");
+    std::free(ptr);
+    return state.fail_free ? -1 : AXCL_SUCC;
+}
+}  // namespace
+
+extern "C" int __wrap_stat(const char *, struct stat *info) {
+    info->st_mode = S_IFCHR | 0660;
+    return 0;
+}
+
+extern "C" int __wrap_open(const char *, int, ...) {
+    if (state.denied) { errno = EACCES; return -1; }
+    return 12345;
+}
+
+extern "C" int __real_close(int);
+extern "C" int __wrap_close(int fd) { return fd == 12345 ? 0 : __real_close(fd); }
+
+extern "C" axclError axclrtGetVersion(int32_t *major, int32_t *minor, int32_t *patch) {
+    *major = 3; *minor = 16; *patch = 0; return AXCL_SUCC;
+}
+extern "C" axclError axclrtConfigLoad(const char *config) { state.config = config; return AXCL_SUCC; }
+extern "C" void axclrtConfigUnLoad() { ++state.unload; }
+extern "C" axclError axclInit(const char *) { ++state.init; return state.fail_init ? -1 : AXCL_SUCC; }
+extern "C" axclError axclFinalize() { ++state.finalize; return AXCL_SUCC; }
+extern "C" axclError axclrtSetDevice(int32_t) { return state.fail_activate ? -1 : AXCL_SUCC; }
+extern "C" axclError axclrtResetDevice(int32_t) { ++state.reset; return AXCL_SUCC; }
+extern "C" axclError axclrtGetDeviceList(axclrtDeviceList *list) {
+    list->num = state.no_devices ? 0 : 1;
+    list->devices[0] = 129;
+    return state.fail_list ? -1 : AXCL_SUCC;
+}
+extern "C" axclError axclrtGetDeviceProperties(int32_t, axclrtDeviceProperties *properties) {
+    std::strcpy(properties->swVersion, "test firmware"); return AXCL_SUCC;
+}
+extern "C" axclError axclrtMallocHost(void **ptr, size_t size) { return allocate(ptr, size); }
+extern "C" axclError axclrtMalloc(void **ptr, size_t size, axclrtMemMallocPolicy) { return allocate(ptr, size); }
+extern "C" axclError axclrtFreeHost(void *ptr) { return release(ptr); }
+extern "C" axclError axclrtFree(void *ptr) { return release(ptr); }
+extern "C" axclError axclrtMemcpy(void *dst, const void *src, size_t size, axclrtMemcpyKind) {
+    if (state.throw_copy) throw std::runtime_error("injected copy exception");
+    ++state.copies;
+    std::memcpy(dst, src, size);
+    if (state.corrupt) static_cast<unsigned char *>(dst)[0] ^= 1;
+    return AXCL_SUCC;
+}
+
+int main() {
+    try {
+        JNINativeInterface_ functions {};
+        functions.NewStringUTF = make_string;
+        functions.GetStringUTFChars = get_string;
+        functions.ReleaseStringUTFChars = release_string;
+        JNIEnv env {&functions};
+        auto *environment_report = reinterpret_cast<std::string *>(
+            Java_com_axera_axcl_NativeRuntime_nativeCheck(&env, nullptr));
+        expect(*environment_report, true, "environment check does not initialize runtime");
+        delete environment_report;
+        require(state.init == 0, "Environment check initialized runtime");
+
+        state = {}; state.denied = true;
+        expect(run_diagnostic(&env), false, "denied device nodes stop before initialization");
+        require(state.init == 0, "Initialized after denied node access");
+
+        state = {}; state.fail_init = true;
+        expect(run_diagnostic(&env), false, "initialization failure does not finalize uninitialized runtime");
+        require(state.finalize == 0 && state.unload == 1, "Invalid init failure cleanup");
+
+        state = {}; state.fail_list = true;
+        expect(run_diagnostic(&env), false, "device query failure finalizes runtime");
+        require(state.finalize == 1, "Missing finalize");
+
+        state = {}; state.no_devices = true;
+        expect(run_diagnostic(&env), false, "empty device list fails");
+
+        state = {};
+        expect(run_diagnostic(&env, true, 9), false, "invalid device index fails");
+        require(state.reset == 0 && state.finalize == 1, "Invalid index cleanup");
+
+        state = {}; state.fail_activate = true;
+        expect(run_diagnostic(&env), false, "activation failure does not reset inactive device");
+        require(state.reset == 0 && state.finalize == 1, "Invalid activation cleanup");
+
+        state = {};
+        expect(run_diagnostic(&env, false), true, "device detection allocates no test buffers");
+        require(state.allocations == 0 && state.reset == 1 && state.finalize == 1, "Invalid detection cleanup");
+
+        state = {};
+        expect(run_diagnostic(&env), true, "1 MiB H2D/D2D/D2H round trip and cleanup");
+        require(state.allocations == 4 && state.copies == 3 && state.reset == 1 && state.finalize == 1,
+                "Incomplete memory test");
+        require(state.config.find("/app/files/logs/axcl.log") != std::string::npos, "App log path not applied");
+
+        state = {}; state.fail_allocation = 3;
+        expect(run_diagnostic(&env), false, "partial allocation failure releases existing buffers");
+
+        state = {}; state.corrupt = true;
+        expect(run_diagnostic(&env), false, "corrupted round-trip data fails byte comparison");
+
+        state = {}; state.fail_free = true;
+        const auto report = run_diagnostic(&env);
+        expect(report, false, "cleanup failure cannot report success");
+        require(report.find("\"stage\":\"cleanup\"") != std::string::npos, "Missing cleanup failure stage");
+
+        state = {}; state.throw_copy = true;
+        expect(run_diagnostic(&env), false, "native exception releases buffers and runtime");
+        require(state.finalize == 1 && state.reset == 1, "Exception leaked device/runtime");
+
+        require(quote("\"\\\n\t") == "\"\\\"\\\\\\n\\t\"", "JSON escaping failure");
+        std::cout << "PASS JSON escaping\n";
+    } catch (const std::exception &ex) {
+        std::cerr << "FAIL " << ex.what() << '\n';
+        return 1;
+    }
+}
