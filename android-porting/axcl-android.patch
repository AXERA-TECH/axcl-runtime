+#!/usr/bin/env python3
+"""Exercise the real installer using isolated paths and mocked Android commands."""
+import hashlib
+import os
+from pathlib import Path
+import shutil
+import struct
+import subprocess
+import sys
+import tempfile
+import unittest
+
+ROOT = Path(__file__).resolve().parents[1]
+sys.path.insert(0, str(ROOT))
+from build_apk import MODULES, prepare_payload
+
+
+class InstallerTest(unittest.TestCase):
+    def setUp(self):
+        self.temporary = tempfile.TemporaryDirectory(prefix="axcl-install-test-")
+        self.addCleanup(self.temporary.cleanup)
+        self.root = Path(self.temporary.name)
+        self.base = self.root / "base"
+        self.lock = self.base / (".install-lock-" + Path("/proc/sys/kernel/random/boot_id").read_text().strip())
+        self.sys = self.root / "sys"
+        self.dev = self.root / "dev"
+        self.payload = self.root / "payload"
+        self.bin = self.root / "bin"
+        for path in [self.base / "modules", self.sys, self.dev, self.payload / "firmware", self.bin]:
+            path.mkdir(parents=True)
+        self.parameter = self.root / "firmware-path"
+        self.parameter.write_text("")
+        self.pac = self.payload / "firmware/ax650_card.pac"
+        self.pac.write_bytes(b"test firmware\0")
+        (self.payload / "driver-source.tar.gz").write_bytes(b"source fixture")
+        (self.payload / "build-driver.sh").write_text('''#!/bin/sh
+set -eu
+base=$2
+mkdir -p "$base/build/test/modules"
+cp "$base/modules/"*.ko "$base/modules/kernel-release.txt" "$base/build/test/modules/"
+printf '%s' "$base/build/test/modules" > "$base/build/modules-path"
+echo "Fixture builder completed"
+''')
+        for name in ["lib", "bin", "include"]:
+            (self.payload / "runtime" / name).mkdir(parents=True)
+        (self.payload / "runtime/bin/axcl-smi").write_text("fixture binary")
+        (self.payload / "runtime/lib/libaxcl_rt.so").write_text("fixture library")
+        (self.payload / "runtime/include/axcl.h").write_text("fixture header")
+        (self.payload / "axclctl").write_text((ROOT / "scripts/axclctl").read_text())
+        self.hashes()
+        self.kernel = subprocess.check_output(["uname", "-r"], text=True).strip()
+        (self.base / "modules/kernel-release.txt").write_text(self.kernel + "\n")
+        for module in MODULES:
+            (self.base / f"modules/{module}.ko").write_bytes(b"test module")
+        script = (ROOT / "scripts/install-device.sh").read_text()
+        for before, after in [("BASE=/data/vendor/axcl", f"BASE={self.base}"),
+                              ("SYS_MODULE=/sys/module", f"SYS_MODULE={self.sys}"),
+                              ("DEV=/dev", f"DEV={self.dev}"),
+                              ("SYSTEM_SHELL=/system/bin/sh", "SYSTEM_SHELL=/bin/sh"),
+                              ("FIRMWARE_PATH=/sys/module/firmware_class/parameters/path", f"FIRMWARE_PATH={self.parameter}")]:
+            assert script.count(before) == 1
+            script = script.replace(before, after)
+        self.script = self.root / "install.sh"
+        self.script.write_text(script)
+        self.command("id", 'echo "${MOCK_UID:-0}"')
+        self.command("cmd", 'echo "package:com.axera.axcl uid:10001"')
+        self.command("getprop", 'case "$1" in ro.build.version.sdk) echo 35 ;; *) echo arm64-v8a ;; esac')
+        # Prevent host device permission changes, even though fake nodes link to /dev/null.
+        for command in ["chgrp", "chmod", "restorecon"]:
+            self.command(command, ":")
+        self.command("insmod", '''
+module=$(basename "$1" .ko)
+echo "load:$module" >> "$TEST_ROOT/events"
+if [ "$module" = "${FAIL_MODULE:-none}" ]; then exit 1; fi
+if [ "$module" = axcl_host ]; then
+    cmp "$TEST_ROOT/payload/firmware/ax650_card.pac" "$TEST_ROOT/base/firmware/axcl/ax650_card.pac" || exit 2
+    cmp "$TEST_ROOT/payload/firmware/ax650_card.pac" "$(cat "$TEST_ROOT/firmware-path")/axcl/ax650_card.pac" || exit 3
+fi
+mkdir "$TEST_ROOT/sys/$module"
+if [ "${NO_NODES:-0}" = 0 ]; then
+    for node in axcl_host msg_userdev ax_mmb_dev p2p; do ln -sf /dev/null "$TEST_ROOT/dev/$node"; done
+fi
+''')
+        self.command("rmmod", '''
+echo "unload:$1" >> "$TEST_ROOT/events"
+[ "${BUSY_MODULE:-none}" != "$1" ] || exit 1
+rmdir "$TEST_ROOT/sys/$1"
+''')
+
+    def command(self, name, body):
+        path = self.bin / name
+        path.write_text("#!/bin/sh\nset -eu\n" + body + "\n")
+        path.chmod(0o755)
+
+    def hashes(self):
+        files = sorted(p for p in self.payload.rglob("*") if p.is_file() and p.name != "payload.sha256")
+        (self.payload / "payload.sha256").write_text("".join(
+            f"{hashlib.sha256(p.read_bytes()).hexdigest()}  {p.relative_to(self.payload)}\n" for p in files))
+
+    def run_installer(self, mode="ensure", **values):
+        env = dict(os.environ, PATH=str(self.bin) + os.pathsep + os.environ["PATH"], TEST_ROOT=str(self.root), **values)
+        return subprocess.run(["sh", self.script, self.payload, "10001", mode], env=env,
+                              text=True, stdout=subprocess.PIPE, stderr=subprocess.STDOUT)
+
+    def events(self):
+        path = self.root / "events"
+        return path.read_text().splitlines() if path.exists() else []
+
+    def test_first_install_pac_precedes_driver_and_all_five_modules_load_in_order(self):
+        result = self.run_installer()
+        self.assertEqual(result.returncode, 0, result.stdout)
+        self.assertEqual(self.events(), ["load:" + m for m in MODULES])
+        self.assertFalse(self.lock.exists())
+
+    def test_hash_mismatch_does_not_load_or_deploy(self):
+        self.pac.write_bytes(b"corrupt")
+        result = self.run_installer()
+        self.assertNotEqual(result.returncode, 0)
+        self.assertIn("verification failed", result.stdout)
+        self.assertFalse(self.events())
+        self.assertFalse((self.base / "firmware").exists())
+
+    def test_non_root_rejected(self):
+        result = self.run_installer(MOCK_UID="10001")
+        self.assertNotEqual(result.returncode, 0)
+        self.assertIn("Root is required", result.stdout)
+
+    def test_wrong_kernel_rejected_before_deployment(self):
+        (self.base / "modules/kernel-release.txt").write_text("wrong-kernel\n")
+        result = self.run_installer()
+        self.assertNotEqual(result.returncode, 0)
+        self.assertIn("Kernel mismatch", result.stdout)
+        self.assertFalse(self.events())
+
+    def test_p2p_is_required_like_deb(self):
+        (self.base / "modules/ax_pcie_p2p_rc.ko").unlink()
+        result = self.run_installer()
+        self.assertNotEqual(result.returncode, 0)
+        self.assertIn("Missing ax_pcie_p2p_rc.ko", result.stdout)
+        self.assertFalse(self.events())
+
+    def test_same_pac_does_not_restart_running_cards(self):
+        self.assertEqual(self.run_installer().returncode, 0)
+        (self.root / "events").unlink()
+        result = self.run_installer()
+        self.assertEqual(result.returncode, 0, result.stdout)
+        self.assertFalse(self.events())
+
+    def test_runtime_link_replacement_with_android_mv(self):
+        self.assertEqual(self.run_installer().returncode, 0)
+        self.command("mv", '''
+if [ "$1" = -fT ] && [ -L "$3" ] && [ -d "$3" ]; then
+    echo "mv: '$3' is a directory" >&2
+    exit 1
+fi
+exec /bin/mv "$@"
+''')
+        result = self.run_installer()
+        self.assertEqual(result.returncode, 0, result.stdout)
+        self.assertTrue((self.base / "current").is_symlink())
+        self.assertTrue((self.base / "current/bin/axcl-smi").is_file())
+
+    def test_pac_upgrade_reloads_host_and_p2p(self):
+        self.assertEqual(self.run_installer().returncode, 0)
+        (self.root / "events").unlink()
+        self.pac.write_bytes(b"new firmware")
+        self.hashes()
+        result = self.run_installer()
+        self.assertEqual(result.returncode, 0, result.stdout)
+        self.assertEqual(self.events(), ["unload:ax_pcie_p2p_rc", "unload:axcl_host", "load:axcl_host", "load:ax_pcie_p2p_rc"])
+
+    def test_busy_driver_preserves_old_pac(self):
+        self.assertEqual(self.run_installer().returncode, 0)
+        old = self.pac.read_bytes()
+        self.pac.write_bytes(b"new firmware")
+        self.hashes()
+        result = self.run_installer(BUSY_MODULE="axcl_host")
+        self.assertNotEqual(result.returncode, 0)
+        self.assertEqual((self.base / "firmware/axcl/ax650_card.pac").read_bytes(), old)
+
+    def test_explicit_restart_reloads_unchanged_pac(self):
+        self.assertEqual(self.run_installer().returncode, 0)
+        (self.root / "events").unlink()
+        result = self.run_installer("restart")
+        self.assertEqual(result.returncode, 0, result.stdout)
+        self.assertIn("unload:axcl_host", self.events())
+
+    def test_new_boot_recovers_auto_loaded_host_even_when_pac_unchanged(self):
+        self.assertEqual(self.run_installer().returncode, 0)
+        (self.root / "events").unlink()
+        (self.base / "boot-id").write_text("previous-boot")
+        result = self.run_installer()
+        self.assertEqual(result.returncode, 0, result.stdout)
+        self.assertIn("unload:axcl_host", self.events())
+
+    def test_failed_insmod_never_reports_completion(self):
+        result = self.run_installer(FAIL_MODULE="axcl_host")
+        self.assertNotEqual(result.returncode, 0)
+        self.assertNotIn("deployment completed", result.stdout)
+
+    def test_successful_insmod_without_nodes_is_failure(self):
+        result = self.run_installer(NO_NODES="1")
+        self.assertNotEqual(result.returncode, 0)
+        self.assertIn("Missing character device", result.stdout)
+
+    def test_existing_custom_firmware_path_is_preserved(self):
+        self.parameter.write_text("/vendor/other-firmware")
+        result = self.run_installer()
+        self.assertNotEqual(result.returncode, 0)
+        self.assertEqual(self.parameter.read_text(), "/vendor/other-firmware")
+        self.assertFalse(self.events())
+
+    def test_embedded_modules_are_deployed(self):
+        shutil.copytree(self.base / "modules", self.payload / "modules")
+        shutil.rmtree(self.base / "modules")
+        (self.payload / "build-driver.sh").unlink()
+        (self.payload / "driver-source.tar.gz").unlink()
+        self.hashes()
+        result = self.run_installer()
+        self.assertEqual(result.returncode, 0, result.stdout)
+        self.assertTrue((self.base / "modules/axcl_host.ko").exists())
+        self.assertIn("use precompiled modules embedded in APK", result.stdout)
+        self.assertNotIn("Fixture builder completed", result.stdout)
+        self.assertFalse((self.base / "driver-build.log").exists())
+
+    def test_failed_compile_preserves_running_drivers_and_pac(self):
+        self.assertEqual(self.run_installer().returncode, 0)
+        (self.root / "events").unlink()
+        old_pac = (self.base / "firmware/axcl/ax650_card.pac").read_bytes()
+        (self.payload / "build-driver.sh").write_text('echo "compiler failed"; exit 1\n')
+        self.hashes()
+        result = self.run_installer()
+        self.assertNotEqual(result.returncode, 0)
+        self.assertIn("compiler failed", result.stdout)
+        self.assertFalse(self.events())
+        self.assertEqual((self.base / "firmware/axcl/ax650_card.pac").read_bytes(), old_pac)
+        self.assertTrue((self.sys / "axcl_host").exists())
+
+    def test_driver_upgrade_unloads_all_five_before_reloading(self):
+        self.assertEqual(self.run_installer().returncode, 0)
+        (self.root / "events").unlink()
+        shutil.copytree(self.base / "modules", self.payload / "modules")
+        for module in MODULES:
+            (self.payload / f"modules/{module}.ko").write_bytes(b"updated driver")
+        self.hashes()
+        result = self.run_installer()
+        self.assertEqual(result.returncode, 0, result.stdout)
+        self.assertEqual(self.events(), ["unload:" + m for m in reversed(MODULES)] + ["load:" + m for m in MODULES])
+
+    def test_install_lock_prevents_parallel_changes(self):
+        self.lock.mkdir()
+        result = self.run_installer()
+        self.assertNotEqual(result.returncode, 0)
+        self.assertIn("Another AXCL installation", result.stdout)
+        self.assertFalse(self.events())
+
+
+class PayloadTest(unittest.TestCase):
+    def test_invalid_and_mismatched_pac_rejected(self):
+        with tempfile.TemporaryDirectory() as directory:
+            root = Path(directory)
+            pac = root / "test.pac"
+            pac.write_bytes(b"truncated")
+            with self.assertRaisesRegex(ValueError, "Truncated"):
+                prepare_payload(pac, None, root, "SDK_VERSION=V3.16.0")
+            pac.write_bytes(struct.pack("<IIQ32s32sIIII32s", 0x5C6D8E9F, 1, 128,
+                                       b"AX650_card", b"V0.0.0", 128, 1, 0, 0, b""))
+            with self.assertRaisesRegex(ValueError, "version mismatch"):
+                prepare_payload(pac, None, root, "SDK_VERSION=V3.16.0")
+
+
+if __name__ == "__main__":
+    unittest.main(verbosity=2)
