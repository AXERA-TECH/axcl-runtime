new file mode 100644
index 0000000000000000000000000000000000000000..02021a40a67d5243f0407e86292bca198e63ae2c
--- /dev/null
+++ b/android/platform/PackageVerifier.java
@@ -0,0 +1,34 @@
+package com.axera.axcl.platform;
+
+import android.content.Context;
+import android.content.pm.PackageManager;
+import android.os.Looper;
+
+/** Runs from the OEM init service via app_process, outside the installed APK. */
+public final class PackageVerifier {
+    public static void main(String[] args) {
+        try {
+            if (args.length != 1 || !args[0].matches("[0-9a-fA-F]{64}")) {
+                throw new IllegalArgumentException("Expected pinned signing certificate SHA-256");
+            }
+            byte[] digest = new byte[32];
+            for (int i = 0; i < digest.length; i++) {
+                digest[i] = (byte) Integer.parseInt(args[0].substring(i * 2, i * 2 + 2), 16);
+            }
+            if (Looper.getMainLooper() == null) Looper.prepareMainLooper();
+            Class<?> type = Class.forName("android.app.ActivityThread");
+            Object thread = type.getMethod("systemMain").invoke(null);
+            Context context = (Context) type.getMethod("getSystemContext").invoke(thread);
+            PackageManager manager = context.getPackageManager();
+            if (!manager.hasSigningCertificate("com.axera.axcl", digest, PackageManager.CERT_INPUT_SHA256)) {
+                throw new SecurityException("AXCL APK signing certificate is not trusted by this host");
+            }
+            System.out.println(manager.getApplicationInfo("com.axera.axcl", 0).sourceDir);
+            System.exit(0);
+        } catch (Exception error) {
+            System.err.println("AXCL package verification failed: " + error);
+            System.exit(1);
+        }
+    }
+    private PackageVerifier() {}
+}
