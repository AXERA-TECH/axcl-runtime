+    private void addAction(LinearLayout parent, String label, int mode) {
+        Button button = new Button(this);
+        button.setText(label);
+        button.setTextSize(16);
+        button.setTextColor(Color.WHITE);
+        button.setAllCaps(false);
+        button.setBackgroundTintList(android.content.res.ColorStateList.valueOf(BLUE));
+        LinearLayout.LayoutParams params = new LinearLayout.LayoutParams(-1, dp(56));
+        params.setMargins(0, dp(4), 0, dp(4));
+        parent.addView(button, params);
+        actions.add(button);
+        button.setOnClickListener(view -> execute(mode));
+    }
+
+    @Override protected void onResume() {
+        super.onResume();
+        updates.post(refresh);
+    }
+
+    @Override protected void onPause() {
+        updates.removeCallbacks(refresh);
+        super.onPause();
+    }
+
+    private void execute(int mode) {
+        if (InstallerService.isRunning()) { refreshStatus(); return; }
+        int index;
+        try {
+            index = Integer.parseInt(deviceIndex.getText().toString().trim());
+            if (index < 0) throw new NumberFormatException();
+        } catch (NumberFormatException error) {
+            deviceIndex.setError("请输入从 0 开始的设备序号");
+            return;
+        }
+        String[] operations = {"environment", "device", "memory", "ensure", "restart"};
+        try {
+            InstallerService.start(this, operations[mode], index, "ui-" + java.util.UUID.randomUUID());
+        } catch (Exception error) {
+            show(false, "start", error.toString());
+        }
+    }
+
+    private void refreshStatus() {
+        JSONObject result = InstallStatus.read(this);
+        String identity = result.toString();
+        if (displayedStatus.equals(identity)) return;
+        displayedStatus = identity;
+        busy = result.optString("state").equals("running");
+        for (Button button : actions) button.setEnabled(!busy);
+        deviceIndex.setEnabled(!busy);
+        progress.setVisibility(busy ? View.VISIBLE : View.GONE);
+        if (busy) {
+            status.setText("正在后台部署或检查子卡…");
+            status.setTextColor(BLUE);
+            detail.setText("自动执行中。可关闭此界面，稍后通过应用或命令行查看结果。");
+            lastReport = "request_id=" + result.optString("request_id") + "\nstate=running\n" + result.optString("report");
+            report.setText(lastReport);
+        } else if (!result.optString("state").equals("idle")) {
+            show(result.optBoolean("success"), result.optString("stage"), result.optString("report"));
+        }
+    }
+
+    private void show(boolean success, String stage, String output) {
+        status.setText(success ? "检查通过" : "需要处理");
+        status.setTextColor(success ? Color.rgb(23, 115, 77) : Color.rgb(164, 79, 19));
+        String guidance = "请查看报告中的失败接口和错误码，并按安装指南排查。";
+        if (success) guidance = stage.equals("installed") ? "runtime、工具、PAC 和驱动已部署。子卡由驱动启动；可按需另行检查。"
+            : stage.equals("environment") ? "应用已能打开所需设备节点，请继续检测设备。"
+            : stage.equals("memory") ? "设备已连接，1 MiB 数据往返校验及资源释放通过。" : "设备已连接，可继续验证内存读写。";
+        else if (stage.equals("environment")) guidance = "请检查驱动是否加载，并确认设备节点和 SELinux 访问权限。";
+        else if (stage.equals("load")) guidance = "请确认系统为 Android 7.0 及以上，并支持 arm64-v8a 应用。";
+        else if (stage.equals("initialize")) guidance = "请检查主控驱动、PCIe 连接及板卡固件。";
+        else if (stage.equals("install")) guidance = "请查看安装报告，检查驱动与主控内核是否匹配，以及 root 和固件访问权限。";
+        detail.setText(guidance);
+        lastReport = "AXCL 设备助手 1.6.3\n" + DateFormat.getDateTimeInstance().format(new Date(InstallStatus.read(this).optLong("updated_ms", System.currentTimeMillis())))
+            + "\n" + Build.MANUFACTURER + " " + Build.MODEL + " / Android " + Build.VERSION.RELEASE
+            + " (API " + Build.VERSION.SDK_INT + ")\nrequest_id=" + InstallStatus.read(this).optString("request_id")
+            + "\nStage: " + stage + "\n\n" + output;
+        report.setText(lastReport);
+    }
+
+    private TextView text(String value, int size, int color) {
+        TextView view = new TextView(this);
+        view.setText(value);
+        view.setTextSize(size);
+        view.setTextColor(color);
+        view.setLineSpacing(dp(3), 1);
+        return view;
+    }
+
+    private GradientDrawable panel(int color, int radius) {
+        GradientDrawable drawable = new GradientDrawable();
+        drawable.setColor(color);
+        drawable.setCornerRadius(radius);
+        return drawable;
+    }
+
+    private int dp(int value) { return Math.round(value * getResources().getDisplayMetrics().density); }
+
+}
