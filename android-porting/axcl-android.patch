+
+public final class MainActivity extends Activity {
+    private static final int INK = Color.rgb(27, 43, 60);
+    private static final int BLUE = Color.rgb(23, 105, 170);
+    private static final int MUTED = Color.rgb(82, 100, 118);
+    private final Handler updates = new Handler(Looper.getMainLooper());
+    private String displayedStatus = "";
+    private final Runnable refresh = new Runnable() {
+        @Override public void run() {
+            refreshStatus();
+            updates.postDelayed(this, 1000);
+        }
+    };
+    private final List<Button> actions = new ArrayList<>();
+    private TextView status;
+    private TextView detail;
+    private TextView report;
+    private ProgressBar progress;
+    private EditText deviceIndex;
+    private String lastReport = "尚未执行检查。";
+    private boolean busy;
+
+    @Override public void onCreate(Bundle state) {
+        super.onCreate(state);
+        LinearLayout root = new LinearLayout(this);
+        root.setOrientation(LinearLayout.VERTICAL);
+        root.setBackgroundColor(Color.rgb(242, 245, 248));
+        root.setPadding(dp(22), dp(16), dp(22), dp(12));
+        root.setOnApplyWindowInsetsListener((view, insets) -> {
+            view.setPadding(dp(22) + insets.getSystemWindowInsetLeft(),
+                dp(16) + insets.getSystemWindowInsetTop(),
+                dp(22) + insets.getSystemWindowInsetRight(),
+                dp(12) + insets.getSystemWindowInsetBottom());
+            return insets;
+        });
+        setContentView(root);
+        root.requestApplyInsets();
+
+        ScrollView scroll = new ScrollView(this);
+        scroll.setFillViewport(true);
+        root.addView(scroll, new LinearLayout.LayoutParams(-1, -1));
+        LinearLayout content = new LinearLayout(this);
+        content.setOrientation(LinearLayout.VERTICAL);
+        scroll.addView(content);
+        TextView title = text("AXCL 设备助手", 28, INK);
+        title.setTypeface(Typeface.DEFAULT, Typeface.BOLD);
+        content.addView(title);
+        TextView subtitle = text("AXCL runtime 的可选诊断和维护工具。", 15, MUTED);
