+++ b/android/build_deps.py
@@ -0,0 +1,72 @@
+#!/usr/bin/env python3
+"""Build pinned third-party sources with the same Android NDK as AXCL."""
+import argparse
+import hashlib
+import os
+from pathlib import Path
+import shutil
+import tarfile
+import urllib.request
+
+from build_native import AXCL, ROOT, run
+
+
+SOURCES = {
+    "protobuf": ("protocolbuffers/protobuf", "v3.20.3", "9c0fd39c7a08dff543c643f0f4baf081988129a411b977a07c46221793605638"),
+    "spdlog": ("gabime/spdlog", "v1.14.1", "1586508029a7d0670dfcb2d97575dcdc242d3868a259742b69f100801ab4e16b"),
+    "zmq": ("zeromq/libzmq", "v4.3.5", "6c972d1e6a91a0ecd79c3236f04cf0126f2f4dfbbad407d72b4606a7ba93f9c6"),
+}
+
+
+def main():
+    parser = argparse.ArgumentParser(description=__doc__)
+    parser.add_argument("--ndk", type=Path, default=os.environ.get("ANDROID_NDK_HOME"))
+    parser.add_argument("--jobs", type=int, default=min(os.cpu_count() or 1, 16))
+    args = parser.parse_args()
+    if args.ndk is None or not (args.ndk / "build/cmake/android.toolchain.cmake").is_file():
+        parser.error("Set ANDROID_NDK_HOME or --ndk to an Android NDK r29 installation")
+    if args.jobs < 1:
+        parser.error("--jobs must be positive")
+    cache = ROOT / ".build/downloads"
+    cache.mkdir(parents=True, exist_ok=True)
+    for name, (repository, tag, digest) in SOURCES.items():
+        archive = cache / (name + ".tar.gz")
+        if not archive.exists():
+            urllib.request.urlretrieve(f"https://codeload.github.com/{repository}/tar.gz/refs/tags/{tag}", archive)
+        if hashlib.sha256(archive.read_bytes()).hexdigest() != digest:
+            raise RuntimeError(f"SHA-256 mismatch; remove and re-download {archive}")
+        source = ROOT / ".build/deps" / name / "source"
+        if not source.exists():
+            with tarfile.open(archive) as package:
+                # Only archives matching the pinned digest are extracted.
+                prefix = package.getmembers()[0].name.split("/")[0]
+                unpack = source.parent / "unpack"
+                unpack.mkdir(parents=True, exist_ok=True)
+                package.extractall(unpack)
+                (unpack / prefix).rename(source)
+        build = source.parent / "build"
+        install = AXCL / "3rdparty" / name / "android_arm64"
+        options = {
+            "protobuf": ["-Dprotobuf_BUILD_TESTS=OFF", "-Dprotobuf_BUILD_PROTOC_BINARIES=OFF",
+                         "-Dprotobuf_WITH_ZLIB=OFF", "-Dprotobuf_BUILD_SHARED_LIBS=OFF"],
+            "spdlog": ["-DSPDLOG_BUILD_SHARED=ON", "-DSPDLOG_BUILD_EXAMPLE=OFF", "-DSPDLOG_BUILD_TESTS=OFF"],
+            "zmq": ["-DBUILD_SHARED=OFF", "-DBUILD_STATIC=ON", "-DBUILD_TESTS=OFF",
+                    "-DWITH_DOCS=OFF", "-DWITH_LIBSODIUM=OFF", "-DENABLE_CURVE=OFF"],
+        }[name]
+        run(["cmake", "-S", source / "cmake" if name == "protobuf" else source,
+             "-B", build, "-G", "Ninja",
+             f"-DCMAKE_TOOLCHAIN_FILE={args.ndk.resolve()}/build/cmake/android.toolchain.cmake",
+             "-DANDROID_ABI=arm64-v8a", "-DANDROID_PLATFORM=android-24", "-DANDROID_STL=c++_shared",
+             "-DCMAKE_BUILD_TYPE=Release", "-DCMAKE_POSITION_INDEPENDENT_CODE=ON",
+             "-DCMAKE_SHARED_LINKER_FLAGS=-Wl,-z,max-page-size=16384",
+             "-DCMAKE_INSTALL_LIBDIR=lib", f"-DCMAKE_INSTALL_PREFIX={install}", *options])
+        run(["cmake", "--build", build, "--parallel", args.jobs])
+        run(["cmake", "--install", build])
+        if name == "zmq":
+            # AXCL's existing comm/Makefile expects the archive at this path.
+            shutil.copy2(install / "lib/libzmq.a", install / "libzmq.a")
+    print("Android dependencies ready; run make -C build OS=android host=arm64 all install")
+
+
+if __name__ == "__main__":
+    main()
