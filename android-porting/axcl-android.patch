new file mode 100644
index 0000000000000000000000000000000000000000..f894850700c7fb2351479587fd2902060e789933
--- /dev/null
+++ b/android/scripts/axcl-device.sh
@@ -0,0 +1,74 @@
+#!/system/bin/sh
+# Run as Android shell/root. The service executes as the APK UID, including JNI verification.
+set -eu
+
+fail() { echo "ERROR: $*" >&2; exit 1; }
+operation=${1:-ensure}
+[ "$#" -le 1 ] || fail "Usage: $0 {ensure|restart|check|status|report}"
+case "$operation" in
+    ensure|restart|check|status|report) : ;;
+    *) fail "Usage: $0 {ensure|restart|check|status|report}" ;;
+esac
+user=${AXCL_ANDROID_USER:-$(am get-current-user)}
+case "$user" in ''|*[!0-9]*) fail "Cannot determine Android user; set AXCL_ANDROID_USER" ;; esac
+uri=content://com.axera.axcl.status/status
+
+query() {
+    content query --user "$user" --uri "$uri" --projection request_id:state:success:stage
+}
+report() { content read --user "$user" --uri "$uri"; }
+
+case "$operation" in
+    status) query; exit $? ;;
+    report) report; exit $? ;;
+    check) operation=memory ;;
+esac
+wait_seconds=${AXCL_WAIT_SECONDS:-1900}
+case "$wait_seconds" in ''|*[!0-9]*) fail "AXCL_WAIT_SECONDS must be a positive integer" ;; esac
+[ "$wait_seconds" -ge 1 ] && [ "$wait_seconds" -le 7200 ] || fail "AXCL_WAIT_SECONDS must be 1..7200"
+request=axcl-$(date +%s)-$$
+api=$(getprop ro.build.version.sdk)
+case "$api" in ''|*[!0-9]*) fail "Cannot determine Android API level" ;; esac
+if [ "$api" -ge 26 ]; then start=start-foreground-service; else start=startservice; fi
+if ! result=$(am "$start" --user "$user" -n com.axera.axcl/.InstallerService \
+    --es operation "$operation" --es request_id "$request" --ei device_index 0 2>&1); then
+    fail "Cannot start AXCL service: $result"
+fi
+case "$result" in *Error*|*Exception*) fail "Cannot start AXCL service: $result" ;; esac
+echo "AXCL request_id=$request operation=$operation"
+elapsed=0
+while [ "$elapsed" -le "$wait_seconds" ]; do
+    if ! row=$(query 2>&1); then fail "Cannot query AXCL result: $row"; fi
+    case "$row" in *Error*|*Exception*) fail "Cannot query AXCL result: $row" ;; esac
+    current=$(printf '%s\n' "$row" | sed -n 's/.*request_id=\([^, ]*\).*/\1/p')
+    state=$(printf '%s\n' "$row" | sed -n 's/.*state=\([^, ]*\).*/\1/p')
+    if [ "$current" = "$request" ]; then
+        case "$state" in
+            passed)
+                case "$row" in *success=true*) : ;; *) fail "Inconsistent AXCL result: $row" ;; esac
+                stage=$(printf '%s\n' "$row" | sed -n 's/.*stage=\([^, ]*\).*/\1/p')
+                case "$operation:$stage" in
+                    ensure:installed|restart:installed|memory:memory) : ;;
+                    *) fail "Unexpected AXCL verification stage: $row" ;;
+                esac
+                report || fail "Cannot read AXCL report"
+                echo "AXCL PASS: $operation completed. Card verification runs only for check."
+                exit 0 ;;
+            failed|interrupted)
+                report || true
+                echo "AXCL FAIL: $row" >&2
+                exit 1 ;;
+            running) : ;;
+            *) fail "Unknown AXCL task state: $row" ;;
+        esac
+    elif [ "$state" = running ]; then
+        echo "AXCL BUSY: another request is running: $current" >&2
+        exit 3
+    elif [ "$elapsed" -ge 20 ]; then
+        fail "Service did not publish this request. Inspect: logcat -d -s AXCL AndroidRuntime"
+    fi
+    sleep 2
+    elapsed=$((elapsed + 2))
+done
+echo "AXCL TIMEOUT: task may still be running; use status/report before retrying." >&2
+exit 124
diff --git a/android/scripts/axclctl b/android/scripts/axclctl
new file mode 100644
index 0000000000000000000000000000000000000000..a614f3a768b185dacbf6f383f068d06cca441fcb
--- /dev/null
+++ b/android/scripts/axclctl
@@ -0,0 +1,80 @@
+#!/system/bin/sh
+# Host runtime lifecycle. Called by init/package integration, never by a GUI.
+set -eu
+BASE=/data/vendor/axcl
+SYS_MODULE=/sys/module
+FIRMWARE_PATH=/sys/module/firmware_class/parameters/path
+DEV=/dev
+BOOT_ID=/proc/sys/kernel/random/boot_id
+MODULES="ax_pcie_host_dev ax_pcie_msg ax_pcie_mmb axcl_host ax_pcie_p2p_rc"
+fail() { echo "ERROR: $*" >&2; exit 1; }
+loaded() { [ -d "$SYS_MODULE/$1" ]; }
+[ "$#" = 1 ] || fail "Usage: axclctl {start|stop|restart|status|uninstall}"
+action=$1
+case "$action" in start|stop|restart|status|uninstall) : ;; *) fail "Unknown action: $action" ;; esac
+if [ "$action" = status ]; then
+    [ -L "$BASE/current" ] || fail "AXCL runtime is not installed"
+    [ "$(cat "$BASE/boot-id" 2>/dev/null)" = "$(cat "$BOOT_ID")" ] || fail "AXCL drivers have not started in this boot"
+    for module in $MODULES; do loaded "$module" || fail "Driver is not loaded: $module"; done
+    for node in axcl_host msg_userdev ax_mmb_dev; do [ -c "$DEV/$node" ] || fail "Missing $DEV/$node"; done
+    echo "AXCL runtime installed; drivers loaded. Card health can be checked separately with axcl-smi."
+    exit 0
+fi
+[ "$(id -u)" = 0 ] || fail "Root is required"
+lock="$BASE/.install-lock-$(cat "$BOOT_ID")"
+mkdir "$lock" 2>/dev/null || fail "Another AXCL lifecycle operation is running"
+trap 'rmdir "$lock"' EXIT
+trap 'exit 1' HUP INT TERM
+if [ "$action" = start ] || [ "$action" = restart ]; then
+    [ -L "$BASE/current" ] && [ -f "$BASE/firmware/axcl/ax650_card.pac" ] || fail "Incomplete AXCL installation"
+    [ "$(cat "$BASE/modules/kernel-release.txt")" = "$(uname -r)" ] || fail "Kernel changed; install matching drivers before startup"
+    [ -w "$FIRMWARE_PATH" ] || fail "Cannot configure firmware search path"
+    search_path=$BASE/firmware
+    current=$(cat "$FIRMWARE_PATH")
+    case "$current" in
+        ""|"$BASE/firmware") : ;;
+        *)
+            [ -d "$current/axcl" ] &&
+                [ "$(readlink -f "$current/axcl")" = "$(readlink -f "$BASE/firmware/axcl")" ] ||
+                fail "Conflicting firmware search path; OEM axcl directory link is missing or incorrect"
+            search_path=$current
+            ;;
+    esac
+    for module in $MODULES; do [ -f "$BASE/modules/$module.ko" ] || fail "Missing $module.ko"; done
+    # Recover a host auto-loaded before firmware_class.path was configured.
+    if [ "$action" = start ] && [ "$(cat "$BASE/boot-id" 2>/dev/null || true)" != "$(cat "$BOOT_ID")" ]; then
+        for module in ax_pcie_p2p_rc axcl_host; do
+            if loaded "$module"; then rmmod "$module" || fail "Cannot reload $module"; fi
+        done
+    fi
+fi
+if [ "$action" = stop ] || [ "$action" = restart ] || [ "$action" = uninstall ]; then
+    for module in ax_pcie_p2p_rc axcl_host ax_pcie_mmb ax_pcie_msg ax_pcie_host_dev; do
+        if loaded "$module"; then rmmod "$module" || fail "Driver busy: $module; stop AXCL clients and retry"; fi
+    done
+    rm -f "$BASE/boot-id"
+fi
+case "$action" in
+    start|restart)
+        printf '%s' "$search_path" > "$FIRMWARE_PATH"
+        for module in $MODULES; do
+            if ! loaded "$module"; then insmod "$BASE/modules/$module.ko" || fail "Cannot load $module; inspect dmesg"; fi
+        done
+        for node in axcl_host msg_userdev ax_mmb_dev; do [ -c "$DEV/$node" ] || fail "Missing $DEV/$node"; done
+        for node in axcl_host msg_userdev ax_mmb_dev p2p; do
+            if [ -c "$DEV/$node" ]; then chgrp 2000 "$DEV/$node"; chmod 0660 "$DEV/$node"; fi
+        done
+        cat "$BOOT_ID" > "$BASE/boot-id.new"
+        mv -f "$BASE/boot-id.new" "$BASE/boot-id"
+        echo "AXCL drivers loaded; card startup is performed by axcl_host."
+        ;;
+    uninstall)
+        if [ "$(cat "$FIRMWARE_PATH")" = "$BASE/firmware" ]; then printf '\n' > "$FIRMWARE_PATH"; fi
+        # Delete only installer-owned paths after successful non-forced unload.
+        for directory in releases modules firmware; do
+            if [ -d "$BASE/$directory" ]; then rm -r "$BASE/$directory"; fi
+        done
+        rm -f "$BASE/current" "$BASE/axclctl" "$BASE/installed-payload.sha256"
+        echo "AXCL runtime, drivers and PAC removed; logs and build configuration retained."
+        ;;
+esac
diff --git a/android/scripts/build-driver.sh b/android/scripts/build-driver.sh
new file mode 100644
index 0000000000000000000000000000000000000000..150495281cd60f72e15bb7163ad18d6ddd188489
--- /dev/null
+++ b/android/scripts/build-driver.sh
@@ -0,0 +1,125 @@
+#!/system/bin/sh
+# Build the APK's driver source on the Android host using its prepared Kbuild tree.
+# The caller holds the installation lock. No running driver or PAC is changed here.
+set -eu
+fail() { echo "ERROR [driver-build]: $*" >&2; exit 1; }
+[ "$#" = 2 ] || fail "Usage: $0 /absolute/payload /absolute/install-root"
+payload=$1
+base=$2
+case "$payload:$base" in /*:/*) : ;; *) fail "Absolute paths are required" ;; esac
+[ "$(id -u)" = 0 ] || fail "Root authorization is required"
+[ "$(uname -m)" = aarch64 ] || fail "On-device compilation currently supports an aarch64 Android host"
+release=$(uname -r)
+
+# Administrator-controlled configuration; no downloaded code or guessed kernel SDK.
+if [ -f "$base/build.conf" ]; then
+    [ "$(stat -c %u "$base/build.conf")" = 0 ] || fail "build.conf must be owned by root"
+    permissions=$(stat -c %a "$base/build.conf")
+    case "$permissions" in 600|640|644) : ;; *) fail "build.conf must have mode 0600, 0640 or 0644" ;; esac
+    . "$base/build.conf"
+fi
+if [ -z "${KERNEL_BUILD:-}" ]; then
+    if [ -d "/lib/modules/$release/build" ]; then KERNEL_BUILD=/lib/modules/$release/build;
+    else KERNEL_BUILD=$base/kernel/build; fi
+fi
+case "$KERNEL_BUILD" in /*) : ;; *) fail "KERNEL_BUILD must be absolute" ;; esac
+case "$KERNEL_BUILD$base$payload" in *[[:space:]]*) fail "Kbuild paths must not contain whitespace" ;; esac
+[ -f "$KERNEL_BUILD/Makefile" ] || fail "Missing prepared kernel build tree: $KERNEL_BUILD. Supply the running host kernel SDK; APK cannot reconstruct it from uname."
+for name in .config include/config/auto.conf include/generated/autoconf.h; do
+    [ -s "$KERNEL_BUILD/$name" ] || fail "Unprepared kernel tree: missing $name; prepare the matching host kernel outside this installer"
+done
+grep -q '^CONFIG_MODULES=y$' "$KERNEL_BUILD/include/config/auto.conf" || fail "Running host kernel SDK does not enable CONFIG_MODULES; an APK cannot enable this in the running kernel"
+grep -q '^CONFIG_ARM64=y$' "$KERNEL_BUILD/include/config/auto.conf" || fail "Prepared kernel SDK must target CONFIG_ARM64 for this Android host"
+if grep -q '^CONFIG_MODULE_SIG_FORCE=y$' "$KERNEL_BUILD/include/config/auto.conf"; then
+    fail "Kernel requires trusted signed modules. Unsigned on-device compilation cannot supply an OEM signature; use OEM-signed --modules-dir or an OEM signing workflow."
+fi
+if grep -q '^CONFIG_MODVERSIONS=y$' "$KERNEL_BUILD/include/config/auto.conf"; then
+    [ -s "$KERNEL_BUILD/Module.symvers" ] || fail "CONFIG_MODVERSIONS requires the running kernel's Module.symvers; modules_prepare alone is insufficient"
+fi
+
+MAKE=${MAKE:-make}
+if [ -z "${CC:-}" ]; then
+    if [ -n "${LLVM:-}" ]; then
+        case "$LLVM" in */) CC=${LLVM}clang ;; 1) CC=clang ;; -*) CC=clang$LLVM ;; *) fail "Unsupported LLVM value; configure CC explicitly" ;; esac
+    else CC=${CROSS_COMPILE:-}gcc; fi
+fi
+HOSTCC=${HOSTCC:-$CC}
+"$MAKE" --version >/dev/null 2>&1 || fail "GNU make cannot execute on this Android host; configure MAKE/PATH in $base/build.conf"
+"$CC" --version >/dev/null 2>&1 || fail "Kernel CC=$CC cannot execute here; x86_64 Linux NDK/AOSP prebuilts are not Android-hosted tools"
+"$HOSTCC" --version >/dev/null 2>&1 || fail "HOSTCC=$HOSTCC cannot execute on this Android host"
+for tool in scripts/basic/fixdep scripts/mod/modpost; do
+    if [ -f "$KERNEL_BUILD/$tool" ]; then
+        if "$KERNEL_BUILD/$tool" --help >/dev/null 2>&1; then :
+        else
+            code=$?
+            case "$code" in
+                126|127) fail "Kernel host tool $tool cannot execute on Android; rebuild it for Android/aarch64 with the correct runtime, not x86_64 or glibc-only tools" ;;
+            esac
+        fi
+    fi
+done
+CONFIG_SHELL=${CONFIG_SHELL:-/system/bin/sh}
+[ -x "$CONFIG_SHELL" ] || fail "CONFIG_SHELL is not executable"
+export PATH CC HOSTCC
+set -- "$MAKE" -s -C "$KERNEL_BUILD" ARCH=arm64 "CC=$CC" "HOSTCC=$HOSTCC" "SHELL=$CONFIG_SHELL" "CONFIG_SHELL=$CONFIG_SHELL"
+# Forward standard, explicitly exported Kbuild tool selections without eval.
+for name in LLVM LLVM_IAS CROSS_COMPILE CROSS_COMPILE_COMPAT LD HOSTLD AR NM STRIP OBJCOPY OBJDUMP READELF; do
+    value=$(printenv "$name" || true)
+    if [ -n "$value" ]; then set -- "$@" "$name=$value"; fi
+done
+actual=$("$@" kernelrelease) || fail "Kbuild kernelrelease failed; check prepared tree and Android-hosted build tools"
+[ "$actual" = "$release" ] || fail "Kernel mismatch: SDK=$actual running=$release"
+JOBS=${JOBS:-2}
+case "$JOBS" in ''|*[!0-9]*) fail "JOBS must be an integer" ;; esac
+[ "$JOBS" -ge 1 ] && [ "$JOBS" -le 64 ] || fail "JOBS must be between 1 and 64"
+mkdir -p "$base/build"
+inputs=$base/build/inputs
+{
+    sha256sum "$payload/driver-source.tar.gz" | cut -d ' ' -f 1
+    sha256sum "$payload/build-driver.sh" | cut -d ' ' -f 1
+    printf '%s\n' "$release" "$KERNEL_BUILD" "$MAKE" "$CC" "$HOSTCC" "$CONFIG_SHELL"
+    "$CC" --version
+    "$HOSTCC" --version
+    for name in LLVM LLVM_IAS CROSS_COMPILE CROSS_COMPILE_COMPAT LD HOSTLD AR NM STRIP OBJCOPY OBJDUMP READELF; do
+        printf '%s=%s\n' "$name" "$(printenv "$name" || true)"
+    done
+    for name in .config include/config/auto.conf include/generated/autoconf.h Module.symvers; do
+        if [ -f "$KERNEL_BUILD/$name" ]; then sha256sum "$KERNEL_BUILD/$name"; fi
+    done
+    if [ -f "$base/build.conf" ]; then sha256sum "$base/build.conf"; fi
+} > "$inputs"
+key=$(sha256sum "$inputs" | cut -d ' ' -f 1)
+cache=$base/build/$key
+if [ -f "$cache/modules/modules.sha256" ] && (cd "$cache/modules" && sha256sum -c modules.sha256); then
+    echo "CACHE: verified drivers for $release"
+    printf '%s' "$cache/modules" > "$base/build/modules-path"
+    exit 0
+fi
+work=$(mktemp -d "$base/build/work.XXXXXX")
+echo "BUILD: driver source from APK, kernel=$release, work=$work"
+mkdir -p "$work/source" "$work/modules"
+tar -xzf "$payload/driver-source.tar.gz" -C "$work/source" || fail "Cannot unpack signed APK driver source"
+printf '%s\n' 'int main(void) { return 0; }' > "$work/host-check.c"
+"$HOSTCC" "$work/host-check.c" -o "$work/host-check" || fail "HOSTCC cannot build Android host programs; check native headers and libraries"
+"$work/host-check" || fail "HOSTCC output cannot run here; kernel host tools must run on Android/aarch64"
+if ! "$@" "M=$work/source" "-j$JOBS" modules; then
+    fail "Kbuild modules failed; inspect $base/driver-build.log for missing tools, host-tool Exec format errors, kernel API/KMI or compiler errors. Existing drivers/PAC were preserved."
+fi
+for pair in host_dev:ax_pcie_host_dev msg:ax_pcie_msg mmb:ax_pcie_mmb axcl_host:axcl_host p2p_rc:ax_pcie_p2p_rc; do
+    directory=${pair%:*}
+    module=${pair#*:}
+    file=$work/source/$directory/$module.ko
+    [ -s "$file" ] || fail "Kbuild did not produce $module.ko"
+    # ELF64, little-endian, ET_REL, EM_AARCH64. Actual symbol/signature checks remain the kernel's job.
+    magic=$(od -An -tx1 -N6 "$file" | tr -d ' \n')
+    machine=$(od -An -tx1 -j16 -N4 "$file" | tr -d ' \n')
+    [ "$magic" = 7f454c460201 ] && [ "$machine" = 0100b700 ] || fail "$module.ko is not an AArch64 relocatable ELF module"
+    cp "$file" "$work/modules/$module.ko"
+done
+printf '%s\n' "$release" > "$work/modules/kernel-release.txt"
+(cd "$work/modules" && sha256sum ./*.ko kernel-release.txt > modules.sha256)
+cp "$inputs" "$work/build-inputs.txt"
+if [ -d "$cache" ]; then mv "$cache" "$work/invalid-previous-cache"; fi
+mv "$work" "$cache"
+printf '%s' "$cache/modules" > "$base/build/modules-path"
+echo "BUILD OK: five host kernel modules are ready; deployment follows"
diff --git a/android/scripts/build.conf.example b/android/scripts/build.conf.example
new file mode 100644
index 0000000000000000000000000000000000000000..322a24241d199e31c3e62c7331a8091d11dad5c2
--- /dev/null
+++ b/android/scripts/build.conf.example
@@ -0,0 +1,16 @@
+# Install as /data/vendor/axcl/build.conf, owned by root, mode 0644 or 0600.
+# This file is sourced by the root installer; only administrators may modify it.
+# All tools, kernel host programs and their dependencies must run ON Android/aarch64.
+# Keep the prepared kernel tree's source links valid on the Android host.
+KERNEL_BUILD=/data/vendor/axcl/kernel/build
+export PATH=/data/vendor/axcl/toolchain/bin:/system/bin:/system/xbin
+MAKE=/data/vendor/axcl/toolchain/bin/make
+# Kernel CC must use the kernel ABI (e.g. --target=aarch64-linux-gnu).
+# An Android userspace target can emit TPIDR_EL0 stack guards and panic on load.
+# HOSTCC must instead produce executables that run on Android/Bionic.
+CC=/data/vendor/axcl/toolchain/bin/clang
+HOSTCC=/data/vendor/axcl/toolchain/bin/host-clang
+export LLVM=1
+export LLVM_IAS=1
+CONFIG_SHELL=/system/bin/sh
+JOBS=2
diff --git a/android/scripts/install-android.sh b/android/scripts/install-android.sh
new file mode 100644
index 0000000000000000000000000000000000000000..0cfb3e001b230b958465c7fb1ce1f6884840fd3d
--- /dev/null
+++ b/android/scripts/install-android.sh
@@ -0,0 +1,18 @@
+#!/bin/sh
+# Host-side ADB installer. ANDROID_SERIAL selects a device when several are connected.
+set -eu
+directory=$(CDPATH= cd "$(dirname "$0")" && pwd)
+[ "$#" -le 1 ] || { echo "Usage: $0 [AXCL.apk]" >&2; exit 1; }
+if [ "$#" = 1 ]; then
+    apk=$1
+else
+    set -- "$directory"/AXCL-Runtime-*-arm64-v8a.apk
+    [ "$#" = 1 ] && [ -f "$1" ] || { echo "Specify one APK path, or extract the bundle into a separate directory" >&2; exit 1; }
+    apk=$1
+fi
+[ -f "$apk" ] || { echo "APK not found: $apk" >&2; exit 1; }
+command -v adb >/dev/null 2>&1 || { echo "adb is required" >&2; exit 1; }
+adb install -r "$apk"
+echo "APK installed. The pre-integrated host package service deploys AXCL asynchronously."
+echo "Check: adb shell cat /data/vendor/axcl-manager/status"
+echo "Log: adb shell cat /data/vendor/axcl-manager/last-operation.log"
diff --git a/android/scripts/install-device.sh b/android/scripts/install-device.sh
new file mode 100644
index 0000000000000000000000000000000000000000..d45bc32edf6bd6adfee806c7fbecaeaa87618e6b
--- /dev/null
+++ b/android/scripts/install-device.sh
@@ -0,0 +1,194 @@
+#!/system/bin/sh
+# Root post-install hook, independent of the diagnostic application process.
+set -eu
+
+BASE=/data/vendor/axcl
+SYS_MODULE=/sys/module
+FIRMWARE_PATH=/sys/module/firmware_class/parameters/path
+DEV=/dev
+BOOT_ID=/proc/sys/kernel/random/boot_id
+SYSTEM_SHELL=/system/bin/sh
+MODULES="ax_pcie_host_dev ax_pcie_msg ax_pcie_mmb axcl_host ax_pcie_p2p_rc"
+PACKAGE=com.axera.axcl
+
+fail() { echo "ERROR: $*" >&2; exit 1; }
+loaded() { [ -d "$SYS_MODULE/$1" ]; }
+
+[ "$(id -u)" = 0 ] || fail "Root is required to deploy the AXCL environment and load drivers."
+[ "$#" = 3 ] || fail "Usage: $0 /absolute/payload/directory app-uid {ensure|restart}"
+payload=$1
+uid=$2
+mode=$3
+case "$payload" in /*) : ;; *) fail "Payload path must be absolute" ;; esac
+case "$uid" in ''|*[!0-9]*) fail "Invalid application UID" ;; esac
+case "$mode" in ensure|restart) : ;; *) fail "Invalid installation mode" ;; esac
+if [ "$uid" != 0 ]; then
+[ "$((uid % 100000))" -ge 10000 ] || fail "Unexpected application UID"
+actual=$(cmd package list packages -U --user "$((uid / 100000))" "$PACKAGE" |
+    sed -n 's/^package:com[.]axera[.]axcl uid:\([0-9][0-9]*\)$/\1/p')
+[ "$actual" = "$uid" ] || fail "Installed package UID does not match the caller"
+fi
+
+# Verify the complete payload before changing firmware, modules or device permissions.
+cd "$payload"
+[ -f payload.sha256 ] && [ -f firmware/ax650_card.pac ] || fail "Incomplete APK payload"
+sha256sum -c payload.sha256 || fail "APK payload SHA-256 verification failed"
+api=$(getprop ro.build.version.sdk)
+case "$api" in ''|*[!0-9]*) fail "Cannot read Android API" ;; esac
+[ "$api" -ge 24 ] || fail "Android API 24 or later is required"
+case ",$(getprop ro.product.cpu.abilist)," in
+    *,arm64-v8a,*) : ;; *) fail "arm64-v8a applications are required" ;;
+esac
+[ -w "$FIRMWARE_PATH" ] || fail "firmware_class.path must be available and writable by the authorized root domain"
+boot_id=$(cat "$BOOT_ID")
+[ -n "$boot_id" ] || fail "Cannot determine host boot identity"
+current=$(cat "$FIRMWARE_PATH")
+search_path=$BASE/firmware
+case "$current" in
+    ""|"$BASE/firmware") : ;;
+    *)
+        [ -d "$current/axcl" ] && [ -d "$BASE/firmware/axcl" ] &&
+            [ "$(readlink -f "$current/axcl")" = "$(readlink -f "$BASE/firmware/axcl")" ] ||
+            fail "Existing firmware_class.path=$current; OEM must link its axcl directory to $BASE/firmware/axcl before installation"
+        search_path=$current
+        ;;
+esac
+
+umask 022
+mkdir -p "$BASE"
+lock="$BASE/.install-lock-$boot_id"
+mkdir "$lock" 2>/dev/null || fail "Another AXCL installation is running; inspect its log before removing a stale $lock"
+staged=
+rm -f "$BASE/current.new" "$BASE/axclctl.new"
+cleanup() {
+    if [ -n "$staged" ] && [ -d "$staged" ]; then rm -r "$staged"; fi
+    rm -f "$BASE/current.new" "$BASE/axclctl.new"
+    rmdir "$lock"
+}
+trap cleanup EXIT
+trap 'exit 1' HUP INT TERM
+mkdir -p "$BASE/firmware/axcl" "$BASE/modules" "$BASE/log"
+# A shared runtime belongs to the host, rather than one APK UID. The initial
+# platform contract is root/shell clients; OEMs can assign a dedicated AXCL group.
+touch "$BASE/log/axcl_logs.txt"
+touch "$BASE/log/axcl-smi.lock"
+chgrp 2000 "$BASE/log" "$BASE/log/axcl_logs.txt"
+chgrp 2000 "$BASE/log/axcl-smi.lock"
+chmod 0770 "$BASE/log"
+chmod 0660 "$BASE/log/axcl_logs.txt"
+chmod 0660 "$BASE/log/axcl-smi.lock"
+
+[ -d "$payload/runtime/lib" ] && [ -f "$payload/runtime/bin/axcl-smi" ] || fail "Missing standalone AXCL runtime/tools"
+[ -f "$payload/axclctl" ] || fail "Missing AXCL lifecycle controller"
+[ ! -e "$BASE/current" ] || [ -L "$BASE/current" ] || fail "Runtime current path must be a symbolic link"
+release=$(sha256sum payload.sha256 | cut -d ' ' -f 1)
+mkdir -p "$BASE/releases"
+staged="$BASE/releases/$release.new-$boot_id"
+[ ! -e "$staged" ] || fail "Incomplete previous runtime staging: $staged"
+mkdir "$staged"
+cp -R "$payload/runtime/." "$staged/"
+find "$staged" -type d -exec chmod 0755 {} +
+find "$staged" -type f -exec chmod 0644 {} +
+for directory in bin lib include; do
+    [ -d "$staged/$directory" ] || fail "Missing runtime $directory"
+done
+# APK asset extraction need not preserve execute bits.
+chmod 0755 "$staged/bin/"*
+cp "$payload/axclctl" "$BASE/axclctl.new"
+chmod 0755 "$BASE/axclctl.new"
+
+if [ -d "$payload/modules" ]; then
+    source_modules=$payload/modules
+    echo "DRIVERS: use precompiled modules embedded in APK"
+else
+    [ -f "$payload/build-driver.sh" ] && [ -f "$payload/driver-source.tar.gz" ] || fail "APK is missing driver source or its on-device builder"
+    echo "DRIVERS: compile source on this Android host (full log: $BASE/driver-build.log)"
+    if "$SYSTEM_SHELL" "$payload/build-driver.sh" "$payload" "$BASE" > "$BASE/driver-build.log" 2>&1; then
+        cat "$BASE/driver-build.log"
+    else
+        cat "$BASE/driver-build.log"
+        fail "On-device driver build failed. Existing drivers and PAC were not replaced."
+    fi
+    source_modules=$(cat "$BASE/build/modules-path")
+    case "$source_modules" in "$BASE"/build/*/modules) : ;; *) fail "Invalid driver build output path" ;; esac
+fi
+[ -r "$source_modules/kernel-release.txt" ] || fail "Missing driver kernel-release.txt"
+expected=$(cat "$source_modules/kernel-release.txt")
+[ "$expected" = "$(uname -r)" ] || fail "Kernel mismatch: modules=$expected running=$(uname -r)"
+drivers_changed=0
+for module in $MODULES; do
+    [ -f "$source_modules/$module.ko" ] || fail "Missing $module.ko in $source_modules"
+    cmp -s "$source_modules/$module.ko" "$BASE/modules/$module.ko" || drivers_changed=1
+done
+# Stage all files before detaching any working driver, including copy/disk errors.
+for name in kernel-release.txt $MODULES; do
+    case "$name" in kernel-release.txt) file=$name ;; *) file=$name.ko ;; esac
+    cp "$source_modules/$file" "$BASE/modules/$file.new"
+    cmp -s "$source_modules/$file" "$BASE/modules/$file.new" || fail "Driver copy verification failed: $file"
+    chmod 0644 "$BASE/modules/$file.new"
+done
+changed=0
+cmp -s firmware/ax650_card.pac "$BASE/firmware/axcl/ax650_card.pac" || changed=1
+if [ "$changed" = 1 ]; then
+    # Stage and verify before unloading a working driver (including ENOSPC failures).
+    cp firmware/ax650_card.pac "$BASE/firmware/axcl/ax650_card.pac.new"
+    source_hash=$(sha256sum firmware/ax650_card.pac | cut -d ' ' -f 1)
+    target_hash=$(sha256sum "$BASE/firmware/axcl/ax650_card.pac.new" | cut -d ' ' -f 1)
+    [ "$source_hash" = "$target_hash" ] || fail "Deployed PAC verification failed"
+    chmod 0644 "$BASE/firmware/axcl/ax650_card.pac.new"
+fi
+previous_boot=$(cat "$BASE/boot-id" 2>/dev/null || true)
+if [ "$drivers_changed" = 1 ] || [ "$changed" = 1 ] || [ "$mode" = restart ] || [ "$previous_boot" != "$boot_id" ]; then
+    # Re-loading axcl_host invokes the same PAC download and handshake as deb.
+    # Do not force unloading: the kernel must reject modules with active users.
+    echo "Installing PAC/restarting cards: AXCL clients must be stopped."
+    unload="ax_pcie_p2p_rc axcl_host"
+    if [ "$drivers_changed" = 1 ]; then unload="$unload ax_pcie_mmb ax_pcie_msg ax_pcie_host_dev"; fi
+    for module in $unload; do
+        if loaded "$module"; then
+            echo "UNLOAD: $module"
+            rmmod "$module" || fail "Cannot unload $module; stop all AXCL clients and retry. No forced unload was attempted."
+        fi
+    done
+fi
+if [ -d "$BASE/releases/$release" ]; then
+    rm -r "$staged"
+else
+    mv "$staged" "$BASE/releases/$release"
+fi
+# Android 12 Toybox mv -T rejects a destination symlink to a directory.
+# Clients have stopped above; ln -n replaces the link without following it.
+ln -sfn "releases/$release" "$BASE/current"
+mv -f "$BASE/axclctl.new" "$BASE/axclctl"
+for name in kernel-release.txt $MODULES; do
+    case "$name" in kernel-release.txt) file=$name ;; *) file=$name.ko ;; esac
+    mv -f "$BASE/modules/$file.new" "$BASE/modules/$file"
+done
+if [ "$changed" = 1 ]; then
+    mv -f "$BASE/firmware/axcl/ax650_card.pac.new" "$BASE/firmware/axcl/ax650_card.pac"
+fi
+if command -v restorecon >/dev/null 2>&1; then restorecon -R "$BASE/firmware" "$BASE/modules" "$BASE/releases" "$BASE/log"; fi
+printf '%s' "$search_path" > "$FIRMWARE_PATH"
+[ "$(cat "$FIRMWARE_PATH")" = "$search_path" ] || fail "Cannot configure firmware search path"
+echo "PAC deployed and verified; request_firmware path: $BASE/firmware/axcl/ax650_card.pac"
+
+for module in $MODULES; do
+    if loaded "$module"; then
+        echo "KEEP: $module"
+    else
+        echo "LOAD: $module"
+        insmod "$BASE/modules/$module.ko" || fail "Cannot load $module; inspect dmesg for firmware, kernel ABI, PCIe or SELinux errors"
+    fi
+done
+for name in axcl_host msg_userdev ax_mmb_dev; do
+    [ -c "$DEV/$name" ] || fail "Missing character device $DEV/$name"
+done
+for name in axcl_host msg_userdev ax_mmb_dev p2p; do
+    [ -c "$DEV/$name" ] || continue
+    chgrp 2000 "$DEV/$name"
+    chmod 0660 "$DEV/$name"
+done
+printf '%s' "$boot_id" > "$BASE/boot-id.new"
+mv -f "$BASE/boot-id.new" "$BASE/boot-id"
+echo "AXCL environment installed: $BASE/current/{bin,lib,include}."
+echo "Drivers loaded; axcl_host performs PAC download and card startup. No diagnostic application was started."
